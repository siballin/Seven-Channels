nger"],"debut":"2010","agencies":[{"name":"MBK Entertainment","korean":true,"id":"Q429296","start":"","end":""}],"groups":[{"id":"Q492218","name":"Speed","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/speedjungwoo/","x":"https://x.com/yoosung90","musicbrainz":"https://musicbrainz.org/artist/ee84215e-1122-4ff4-997d-d65fec5e8c68"},"photo":null,"bio":{"text":"Kim Jung-woo is a South Korean singer and actor. He debuted in 2010 as a member of the band Coed School. In January 2012, he joined SPEED and continued until the group disbanded in 2015. In January 2016, Kim confirmed the expiration of his contract with MBK Entertainment and joined Maroo Entertainment. In November 2017, he auditioned as a trainee on the YG talent show Mix Nine, but he did not enter as a contestant.","title":"Kim Jung-woo (singer)","url":"https://en.wikipedia.org/wiki/Kim_Jung-woo_%28singer%29"}},"Q18229754":{"id":"Q18229754","name":"Kwon Kwang Jin","ko":"권광진","birthName":"","birthNameEn":"","aliases":[],"birth":"1992-08-12","death":"","birthplace":"Mapo District","nationality":["South Korea"],"height":null,"occupations":["guitarist","singer"],"debut":"2013","agencies":[],"groups":[{"id":"Q483172","name":"CNBLUE","start":"2009","end":"2009"},{"id":"Q15727149","name":"N.Flying","start":"2015","end":"2018"}],"links":{"instagram":"https://www.instagram.com/healthy_kkj/","musicbrainz":"https://musicbrainz.org/artist/593bf6ae-2e7a-4e85-955f-c93b32bd8a83"},"photo":null,"bio":null},"Q19799482":{"id":"Q19799482","name":"Katie Kim","ko":"케이티 김","birthName":"","birthNameEn":"","aliases":["Kim Seohyeon","Kim Seohyun","Katie","KATIEKIM","Kim Seo-hyeon"],"birth":"1993-12-10","death":"","birthplace":"Bucheon","nationality":["South Korea"],"height":null,"occupations":["jazz musician","singer"],"debut":"2014","agencies":[{"name":"YG Entertainment","korean":true,"id":"Q50595","start":"","end":""}],"groups":[],"links":{"instagram":"https://www.instagram.com/katieeesh/","x":"https://x.com/katieeeshmusic","musicbrainz":"https://musicbrainz.org/artist/a1915b7f-3ad5-4909-ac13-048e8854a21a"},"photo":null,"bio":{"text":"Kim Seo-hyeon, known professionally by the mononym Katie (stylized in all caps), is a South Korean-born American singer. She finished in first place as a contestant in the South Korean singing competition SBS K-pop Star 4. Her breakthrough performance of \"Where You Need To Be\" reached 4 million views on South Korea's leading video-sharing site, Naver TV Cast, in the shortest amount of time in K-pop Star history. After winning the show, she decided to sign with YG Entertainment. In May 2018, Kim joined AXIS, a new company founded by former YG creative director SINXITY. With a change of label, YG Entertainment would continue to help with the distribution of her debut album.","title":"Katie (singer)","url":"https://en.wikipedia.org/wiki/Katie_%28singer%29"}},"Q20688186":{"id":"Q20688186","name":"Mina Myoi","ko":"미나","birthName":"Mina Sharon Myoi","birthNameEn":"Mina Sharon Myoi","aliases":["Mina Sharon Myoi","Myōi Mina"],"birth":"1997-03-24","death":"","birthplace":"San Antonio","nationality":["Japan","United States"],"height":null,"occupations":["singer","dancer"],"debut":"2015","agencies":[{"name":"JYP Entertainment","korean":true,"id":"Q483238","start":"","end":""}],"groups":[{"id":"Q20645861","name":"Twice","start":"2015","end":""}],"links":{"instagram":"https://www.instagram.com/mina_sr_my/","musicbrainz":"https://musicbrainz.org/artist/773b7df1-a0cc-45ea-a96a-4fc1d79798fd"},"photo":null,"bio":{"text":"Mina Myoi, known mononymously as Mina, is a Japanese singer and dancer based in South Korea. She is a member of the South Korean girl group Twice, which debuted under JYP Entertainment in 2015, and its subgroup MiSaMo, which debuted in 2023.","title":"Mina (Japanese singer)","url":"https://en.wikipedia.org/wiki/Mina_%28Japanese_singer%29"}},"Q20779386":{"id":"Q20779386","name":"Dino","ko":"디노 (가수)","birthName":"","birthNameEn":"","aliases":["Lee Chan"],"birth":"1999-02-11","death":"","birthplace":"North Jeolla","nationality":["South Korea"],"height":null,"occupations":["singer","dancer","rapper"],"debut":"2015","agencies":[{"name":"Pledis Entertainment","korean":true,"id":"Q45282","start":"","end":""},{"name":"Hybe","korean":true,"id":"Q16161254","start":"","end":""}],"groups":[{"id":"Q14524548","name":"Seventeen","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/feat.dino/","musicbrainz":"https://musicbrainz.org/artist/5a3eb85f-d2c9-4ec8-843f-1e85ed168533"},"photo":null,"bio":{"text":"Lee Chan, known by his stage name Dino (디노), is a South Korean singer, dancer and rapper. Managed by Pledis Entertainment, he is a member of the South Korean boy band Seventeen and its performance team. Dino made his solo debut with \"Wait\" on November 27, 2023. Dino also has a middle-aged alter ego named Picheolin (피철인).","title":"Dino (South Korean singer)","url":"https://en.wikipedia.org/wiki/Dino_%28South_Korean_singer%29"}},"Q21094138":{"id":"Q21094138","name":"Zhou Yixuan","ko":"조이쉔","birthName":"","birthNameEn":"","aliases":[],"birth":"1990-12-11","death":"","birthplace":"Shengzhou","nationality":["People's Republic of China"],"height":null,"occupations":["singer","actor","songwriter","rapper"],"debut":"2014","agencies":[{"name":"Yuehua Entertainment","korean":false,"id":"Q18390500","start":"","end":""}],"groups":[{"id":"Q18712416","name":"Uniq","start":"","end":""}],"links":{},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/f/f7/Zhou_Yixuan_-_2015_Shanghai_fan_sign_event.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Zhou_Yixuan_-_2015_Shanghai_fan_sign_event.png","author":"七夜雪","license":"CC BY 2.5"},"bio":{"text":"Zhou Yixuan is a Chinese rapper, singer and actor. He is a member and leader of Chinese-South Korean group Uniq under Yuehua Entertainment and Chinese group New Storm which debuted in 2019 after winning the survival show All for One.","title":"Zhou Yixuan","url":"https://en.wikipedia.org/wiki/Zhou_Yixuan"}},"Q22974522":{"id":"Q22974522","name":"Yezi","ko":"예지","birthName":"이예지","birthNameEn":"","aliases":["Lee Ye-ji"],"birth":"1994-08-26","death":"","birthplace":"Gangneung","nationality":["South Korea"],"height":null,"occupations":["singer","rapper"],"debut":"2012","agencies":[{"name":"Kakao M","korean":true,"id":"Q625975","start":"","end":""}],"groups":[{"id":"Q492076","name":"Fiestar","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/yeziyaziiii/","x":"https://x.com/FIESTAR__Yezi","youtube":"https://www.youtube.com/channel/UC7iqA31KsHtVZ3L_riYR9BQ","musicbrainz":"https://musicbrainz.org/artist/d75b5252-6d93-4090-9e3b-8781544f3ac4"},"photo":null,"bio":{"text":"Lee Ye-ji, better known by her stage name Yezi, is a South Korean rapper and singer. She debuted as a member of South Korean girl group Fiestar in 2012. Yezi was a semi-finalist on Unpretty Rapstar 2 in 2015, during which she released several singles. Her debut solo maxi single, Foresight Dream, was released on January 28, 2016.","title":"Yezi","url":"https://en.wikipedia.org/wiki/Yezi"}},"Q25842426":{"id":"Q25842426","name":"Kim Hye-mi","ko":"김혜미","birthName":"김혜미","birthNameEn":"","aliases":["Hyemi","YEL"],"birth":"1990-08-10","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q492076","name":"Fiestar","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/yesyesyelll/","x":"https://x.com/FIESTAR__Hyemi","musicbrainz":"https://musicbrainz.org/artist/f4aead6f-e000-42c0-bb68-572fe73d2cfe"},"photo":null,"bio":null},"Q26267642":{"id":"Q26267642","name":"Jaehyun","ko":"정재현","birthName":"Jeong Jae-hyun","birthNameEn":"Jeong Jae-hyun","aliases":[],"birth":"1997-02-14","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor","songwriter"],"debut":"2016","agencies":[{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"","end":""}],"groups":[{"id":"Q23725822","name":"NCT","start":"","end":""},{"id":"Q67972645","name":"NCT U","start":"","end":""},{"id":"Q55624444","name":"NCT 127","start":"","end":""},{"id":"Q117460785","name":"NCT DoJaeJung","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/_jeongjaehyun/","musicbrainz":"https://musicbrainz.org/artist/5ed4c688-cab3-4e54-83ba-6e4a73ed7522"},"photo":null,"bio":{"text":"Jeong Yun-o (Korean: 정윤오; born Jeong Jae-hyun (정재현), February 14, 1997), known professionally as Jaehyun, is a South Korean singer, songwriter, and actor. He rose to prominence as a member of the K-pop boy band NCT and its sub-units NCT 127 and NCT DoJaeJung. Born in Seoul and raised between South Korea and the United States, Jaehyun started training under SM Entertainment in 2012 and began his career in 2013 as part of the label's official team of trainees, SM Rookies, appearing on television and touring both in South Korea and abroad. He made his debut in 2016 with NCT, which went on to achieve commercial success and become an influential K-pop act.","title":"Jaehyun","url":"https://en.wikipedia.org/wiki/Jaehyun"}},"Q26710970":{"id":"Q26710970","name":"Han Hye-ri","ko":"한혜리","birthName":"","birthNameEn":"","aliases":["Han Hye Ri"],"birth":"1997-08-24","death":"","birthplace":"Gwangmyeong","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2016","agencies":[],"groups":[{"id":"Q26425385","name":"I.B.I","start":"2016","end":"2017"}],"links":{"instagram":"https://www.instagram.com/hye_9.9/","musicbrainz":"https://musicbrainz.org/artist/a8b7f76e-44fd-406a-bcf3-033c24beabf6"},"photo":null,"bio":{"text":"Han Hye-ri is a South Korean singer and actress. She is known as a former contestant of Produce 101 and as a member of the girl group I.B.I.","title":"Han Hye-ri","url":"https://en.wikipedia.org/wiki/Han_Hye-ri"}},"Q47664570":{"id":"Q47664570","name":"Mahiro Kawamura","ko":"카와무라 마히로","birthName":"","birthNameEn":"","aliases":["Kawamura Mahiro","Mahiro","Rottii"],"birth":"1995-07-23","death":"","birthplace":"Osaka","nationality":["Japan"],"height":null,"occupations":["Japanese idol","singer"],"debut":"","agencies":[],"groups":[{"id":"Q61882117","name":"Z-Girls","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/mahiro_kawamura_official/","x":"https://x.com/mahiro_chan0723","tiktok":"https://www.tiktok.com/@mahiro_0723"},"photo":null,"bio":null},"Q483642":{"id":"Q483642","name":"Sunye","ko":"선예","birthName":"민선예","birthNameEn":"","aliases":["Min Sun-ye","Sun"],"birth":"1989-08-12","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","model","actor"],"debut":"2007","agencies":[{"name":"JYP Entertainment","korean":true,"id":"Q483238","start":"","end":""}],"groups":[{"id":"Q476119","name":"Wonder Girls","start":"2007","end":"2015"}],"links":{"instagram":"https://www.instagram.com/sunye.m/","x":"https://x.com/spmission","youtube":"https://www.youtube.com/channel/UCa9FjC0Z0tMTLO1UAkPK5Wg","musicbrainz":"https://musicbrainz.org/artist/d15c7e47-85dc-44ba-9b8c-7138f40ed6f6"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/a/a4/Sunye_%28Min_Sun-ye%29_in_July_2022.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Sunye_(Min_Sun-ye)_in_July_2022.png","author":"K-POPIT 케이팝잇","license":"CC BY 3.0"},"bio":{"text":"Min Sun-ye, known professionally as Sunye, is a South Korean singer known for her work as a former leader and main vocalist of girl group Wonder Girls. In early 2013, following her marriage, she became an inactive member of the Wonder Girls and officially departed from the group in July 2015. Sunye returned to the entertainment industry in August 2018, signing with the company Polaris Entertainment. Sunye made her official solo debut with the EP Genuine on July 26, 2022, after signing with Blockberry Creative, a subsidiary of Polaris Entertainment, in February 2022.","title":"Sunye","url":"https://en.wikipedia.org/wiki/Sunye"}},"Q486074":{"id":"Q486074","name":"Jeon Bo-ram","ko":"보람","birthName":"전보람","birthNameEn":"","aliases":["Jeon Boram","Jeon Bo Ram","Jeon Bo-lam","Jeon Bolam","Jeon Bo Lam","Jun Bo-ram","Jun Boram","Jun Bo Ram"],"birth":"1986-03-22","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2009","agencies":[{"name":"MBK Entertainment","korean":true,"id":"Q429296","start":"","end":""}],"groups":[{"id":"Q495383","name":"T-ara","start":"2009","end":"2017"}],"links":{"instagram":"https://www.instagram.com/bo_ram_0322/","x":"https://x.com/BoRam_0322","musicbrainz":"https://musicbrainz.org/artist/06be07ac-da3a-4e67-bb4a-5e882362ed14"},"photo":null,"bio":{"text":"Jeon Bo-ram, referred to as Boram, is a South Korean singer, actress and host. She originally debuted as a solo artist, releasing two singles in 2008, before eventually becoming a member of girl group T-ara in 2009. The group went on to become one of the best-selling girl groups of all time. Boram has been involved in multiple acting projects, notably dramas Soul (2009),Sweet Temptation (2015),The Angel Of Death Comes With Purple High Heels (2010), musicals I Really Really Like You (2009) and Lost Garden (2014), which became a hit in South Korea selling out all tickets.","title":"Jeon Boram","url":"https://en.wikipedia.org/wiki/Jeon_Boram"}},"Q490938":{"id":"Q490938","name":"Yang Hyun-suk","ko":"양현석","birthName":"","birthNameEn":"","aliases":["Yang Hyun Suk","Yang Hyun-Suk","YG"],"birth":"1970-01-09","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","composer","record producer","rapper","film director","director"],"debut":"1992","agencies":[{"name":"YG Entertainment","korean":true,"id":"Q50595","start":"","end":""}],"groups":[],"links":{"instagram":"https://www.instagram.com/fromyg/","x":"https://x.com/FROMREALYG","musicbrainz":"https://musicbrainz.org/artist/44ad8b2e-c84e-48fd-8774-3c1b339e2a1e"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/8/82/161110_%EC%96%91%ED%98%84%EC%84%9D.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:161110_%EC%96%91%ED%98%84%EC%84%9D.png","author":"K-POPIT 케이팝잇","license":"CC BY 3.0"},"bio":{"text":"Yang Hyun-suk is a South Korean music executive, rapper, singer, dancer, songwriter, and record producer. He rose to fame as a member of Seo Taiji and Boys during the 1990s. After the group disbanded, he founded and became the executive producer and chairman of YG Entertainment, the fourth-largest record company in South Korea.","title":"Yang Hyun-suk","url":"https://en.wikipedia.org/wiki/Yang_Hyun-suk"}},"Q492666":{"id":"Q492666","name":"Son Na-eun","ko":"손나은","birthName":"","birthNameEn":"","aliases":["Naeun","Son Naeun","Son Na Eun"],"birth":"1994-02-10","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":168,"occupations":["singer","film actor","actor","model","television actor"],"debut":"2011","agencies":[{"name":"YG Entertainment","korean":true,"id":"Q50595","start":"","end":""},{"name":"IST Entertainment","korean":true,"id":"Q21554828","start":"","end":""}],"groups":[{"id":"Q483286","name":"Apink","start":"2011","end":"2022"}],"links":{"instagram":"https://www.instagram.com/marcellasne_/","x":"https://x.com/Apinksne","musicbrainz":"https://musicbrainz.org/artist/0b2e8e37-5fdd-4303-a24f-62870efb5db2"},"photo":null,"bio":{"text":"Son Na-eun, known mononymously as Naeun, is a South Korean actress and singer. She gained popularity following her debut as a member of the South Korean girl group, Apink. Apart from her group's activities, Son has also starred in various television series such as The Great Seer (2012), My Kids Give Me a Headache (2012–2013), Second 20s (2015), Cinderella with Four Knights (2016), The Most Beautiful Goodbye (2017), Dinner Mate (2020), Ghost Doctor (2022), Agency (2023), and Romance in the House (2024). In April 2021, Son left IST Entertainment and remained a member of Apink until April 8, 2022, before withdrawing from the group. Soon after leaving IST, she is currently active as an actress.","title":"Son Na-eun","url":"https://en.wikipedia.org/wiki/Son_Na-eun"}},"Q60870266":{"id":"Q60870266","name":"Lia","ko":"최지수","birthName":"최지수","birthNameEn":"","aliases":["Choi Ji-su"],"birth":"2000-07-21","death":"","birthplace":"Incheon","nationality":["South Korea"],"height":null,"occupations":["singer","dancer"],"debut":"2019","agencies":[{"name":"JYP Entertainment","korean":true,"id":"Q483238","start":"","end":""}],"groups":[{"id":"Q60732823","name":"Itzy","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/lia_loves___/","x":"https://x.com/ITZYOfficial","musicbrainz":"https://musicbrainz.org/artist/9184a3e2-c916-4327-815c-d31514bf3f99"},"photo":null,"bio":{"text":"Choi Ji-su, better known by her stage name Lia (리아), is a South Korean singer. She is a member of the South Korean girl group Itzy, formed by JYP Entertainment in 2019.","title":"Lia (South Korean singer)","url":"https://en.wikipedia.org/wiki/Lia_%28South_Korean_singer%29"}},"Q62603002":{"id":"Q62603002","name":"Kang Ye-jin","ko":"강예진","birthName":"","birthNameEn":"","aliases":["Loha"],"birth":"2001-12-27","death":"","birthplace":"Gwangju","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q56501962","name":"Nature","start":"","end":""}],"links":{},"photo":null,"bio":null},"Q65920506":{"id":"Q65920506","name":"Jeong Da-hyun","ko":"정다현","birthName":"","birthNameEn":"","aliases":["Jeong Da Hyun","Dahyun"],"birth":"2005-11-29","death":"","birthplace":"South Korea","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q65771078","name":"Rocket Punch","start":"","end":""}],"links":{},"photo":null,"bio":null},"Q66737978":{"id":"Q66737978","name":"Son Dong-pyo","ko":"손동표","birthName":"","birthNameEn":"","aliases":["Dongpyo"],"birth":"2002-09-09","death":"","birthplace":"Yeongdeok County","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2019","agencies":[{"name":"DSP Media","korean":true,"id":"Q489428","start":"","end":""},{"name":"Swing Entertainment","korean":true,"id":"Q65266336","start":"","end":""}],"groups":[{"id":"Q65665588","name":"X1","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/official__mirae/","x":"https://x.com/DSP_N_Official"},"photo":null,"bio":{"text":"Son Dong-pyo, known mononymously as Dongpyo (동표), is a South Korean singer and actor under DSP Media. He is best known for participating in the reality competition series Produce X 101. He is a former member of the boy groups X1 (2019–2020) and Mirae (2021–2024).","title":"Dongpyo","url":"https://en.wikipedia.org/wiki/Dongpyo"}},"Q6823994":{"id":"Q6823994","name":"Kang Min-kyeong","ko":"강민경","birthName":"","birthNameEn":"","aliases":["Kang Min Kyung","Kang Minkyung","Kang Minkyeong","Kang Min Kyeong","Kang Min-kyung"],"birth":"1990-08-03","death":"","birthplace":"South Korea","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2008","agencies":[{"name":"MBK Entertainment","korean":true,"id":"Q429296","start":"","end":""}],"groups":[{"id":"Q483209","name":"Davichi","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/iammingki/","x":"https://x.com/iamkmk","youtube":"https://www.youtube.com/channel/UCfqVrM2cvwxG3-EvxbsN0KQ","musicbrainz":"https://musicbrainz.org/artist/e2ccebd0-4c8a-4cc7-84ea-66d182a2dfad"},"photo":null,"bio":{"text":"Kang Min-kyung is a South Korean singer and actress. She is one half of the duo Davichi, who rose to fame upon the release of their debut album Amaranth in 2008. Davichi has since released 3 studio albums, 6 extended plays and several hit songs such as \"Don't Say Goodbye\", \"Turtle\", \"Missing You Today\" and \"8282\". Kang has also pursued acting, appearing in television dramas such as Smile, Mom (2010), Vampire Idol (2011), Haeundae Lovers (2012) and family drama The Dearest Lady (2015). On February 27, 2019, she debuted as a solo artist with her first extended play Kang Min Kyung Vol. 1. She launched a clothing shopping mall called 'Àvie Muah' in June 2020.","title":"Kang Min-kyung","url":"https://en.wikipedia.org/wiki/Kang_Min-kyung"}},"Q68625274":{"id":"Q68625274","name":"Su-bin","ko":"수빈","birthName":"","birthNameEn":"","aliases":["Jung Su-bin"],"birth":"1999-04-05","death":"","birthplace":"Daejeon","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"","agencies":[{"name":"IST Entertainment","korean":true,"id":"Q21554828","start":"","end":""}],"groups":[{"id":"Q27861498","name":"Victon","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/subsubey/","youtube":"https://www.youtube.com/channel/UCGqkQcioRHlotD4EJm0pFVg","musicbrainz":"https://musicbrainz.org/artist/6cb61404-7de6-4c1d-8c7f-83c4b75be90e"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/c/ce/VICTON_Jung_Su-bin_%281%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:VICTON_Jung_Su-bin_(1).jpg","author":"NINE STARS","license":"CC BY 3.0"},"bio":null},"Q7696122":{"id":"Q7696122","name":"Zico","ko":"지코","birthName":"우지호","birthNameEn":"","aliases":["Woo Ji-ho","ZICO"],"birth":"1992-09-14","death":"","birthplace":"Mapo District","nationality":["South Korea"],"height":null,"occupations":["record producer","songwriter","singer","rapper"],"debut":"2011","agencies":[{"name":"KOZ Entertainment","korean":true,"id":"Q65332179","start":"","end":""}],"groups":[{"id":"Q498326","name":"Block B","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/woozico0914/","x":"https://x.com/ZICO92","spotify":"https://open.spotify.com/artist/4XpUIb8uuNlIWVKmgKZXC0","musicbrainz":"https://musicbrainz.org/artist/f2215143-d7db-4cf0-9cd4-b0040eb63cbd"},"photo":null,"bio":{"text":"Woo Ji-ho, known professionally as Zico (지코), is a South Korean rapper, record producer, and singer-songwriter. He debuted as the leader of the boy band Block B in 2011 and made his first solo release in 2014. Zico is notable for his crossover skills within the Korean hip hop scene, maintaining an underground reputation along with mainstream appeal as a Korean idol. He is a record producer of both K-pop and Korean hip hop music. He is also part of the crew Fanxy Child, which he formed in 2016. In 2019, he released his first full-length solo album, Thinking.","title":"Zico (rapper)","url":"https://en.wikipedia.org/wiki/Zico_%28rapper%29"}},"Q81811194":{"id":"Q81811194","name":"J","ko":"제이","birthName":"","birthNameEn":"","aliases":["Lee Ye-ji"],"birth":"1998-02-12","death":"","birthplace":"South Korea","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q73795501","name":"ANS","start":"2019","end":""}],"links":{},"photo":null,"bio":null},"Q85873722":{"id":"Q85873722","name":"Jeong Yun-ho","ko":"정윤호","birthName":"","birthNameEn":"","aliases":["Yunho"],"birth":"1999-03-23","death":"","birthplace":"Gwangju","nationality":["South Korea"],"height":null,"occupations":["singer","dancer","actor"],"debut":"2018","agencies":[{"name":"KQ Entertainment","korean":true,"id":"Q31179359","start":"","end":""}],"groups":[{"id":"Q59793088","name":"Ateez","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/yunho_bbyong/"},"photo":null,"bio":{"text":"Jeong Yun-ho, known mononymously as Yunho, is a South Korean singer, dancer and actor. He debuted as one of the dancers and vocalists 