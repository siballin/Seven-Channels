766832":{"id":"Q16766832","name":"Kang Hye-yeon","ko":"혜연","birthName":"","birthNameEn":"","aliases":["Hyeyeon","Dami"],"birth":"1990-12-08","death":"","birthplace":"Jeju","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2012","agencies":[{"name":"YNB Entertainment","id":"Q19939261","start":"","end":""}],"groups":[{"id":"Q492381","name":"EXID","start":"2012","end":"2012"},{"id":"Q13813305","name":"Bestie","start":"2013","end":"2018"}],"links":{"instagram":"https://www.instagram.com/yoni2_/","x":"https://x.com/hyeyeonofficial","youtube":"https://www.youtube.com/channel/UCKdOqSsLXwMFyOMf5iy8ADQ","musicbrainz":"https://musicbrainz.org/artist/b3f0d11a-b0fc-4a37-8baf-4f9577e1f072"},"photo":null,"bio":{"text":"Kang Hye-yeon is a South Korean trot singer. She is a member of the girl group Bestie and a former member of the girl group EXID. She has been active as a trot singer since the disbandment of the Bestie in 2018. Bestie reformed in October 2026.","title":"Kang Hye-yeon","url":"https://en.wikipedia.org/wiki/Kang_Hye-yeon"}},"Q16767600":{"id":"Q16767600","name":"Heo Sol-ji","ko":"솔지","birthName":"허솔지","birthNameEn":"","aliases":["Solji"],"birth":"1989-01-10","death":"","birthplace":"Seongnam","nationality":["South Korea"],"height":null,"occupations":["singer","model"],"debut":"2006","agencies":[],"groups":[{"id":"Q492381","name":"EXID","start":"2012","end":""},{"id":"Q16097960","name":"2NB","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/soul.g_heo/","x":"https://x.com/exid_solji","musicbrainz":"https://musicbrainz.org/artist/4cf05e76-1503-49a0-a9ec-43e1f631ada8"},"photo":null,"bio":{"text":"Heo Sol-ji, known mononymously as Solji, is a South Korean singer. She was a member of the ballad duo group 2NB from 2006 to 2010. She later became a vocal trainer before joining EXID in July 2012 as the leader and main vocalist.","title":"Heo Sol-ji","url":"https://en.wikipedia.org/wiki/Heo_Sol-ji"}},"Q17811824":{"id":"Q17811824","name":"B.I","ko":"비아이","birthName":"","birthNameEn":"","aliases":["Kim Han-bin","Kim Hanbin"],"birth":"1996-10-22","death":"","birthplace":"Cheonan","nationality":["South Korea"],"height":null,"occupations":["rapper","singer","songwriter","record producer","dancer","executive producer"],"debut":"2015","agencies":[{"name":"131 Label","id":"Q107522777","start":"","end":""}],"groups":[{"id":"Q18161349","name":"iKon","start":"2015","end":"2019"}],"links":{"website":"https://www.131online.net/bi","instagram":"https://www.instagram.com/shxxbi131/","x":"https://x.com/shxx131bi131","youtube":"https://www.youtube.com/channel/UCFdoP4i-ouv9J7Rq5Elj6tQ","tiktok":"https://www.tiktok.com/@bi_131_bi","spotify":"https://open.spotify.com/artist/0UntV1Bw2hk3fbRrm9eMP6","musicbrainz":"https://musicbrainz.org/artist/75312d53-db94-4dc1-a08f-2fa3511cf8f2"},"photo":null,"bio":{"text":"Kim Han-bin, known professionally as B.I is a South Korean rapper, singer, songwriter, record producer. He debuted in the South Korean boy band iKon under YG Entertainment in September 2015. On June 12, 2019, he departed from the group due to substance allegations. During his time with the group, he played a significant role in the production and songwriting of their music, and is credited as the sole record producer for all of the group's releases. His contributions to iKon's second studio album, Return, for the lead single \"Love Scenario\", earned him the prestigious \"Songwriter of the Year\" award at the 2018 Melon Music Awards.","title":"B.I (rapper)","url":"https://en.wikipedia.org/wiki/B.I_%28rapper%29"}},"Q18550576":{"id":"Q18550576","name":"Leo","ko":"레오","birthName":"정택운","birthNameEn":"","aliases":["Jung Taek-woon"],"birth":"1990-11-10","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","songwriter","television actor"],"debut":"2012","agencies":[{"name":"Jellyfish Entertainment","id":"Q16180845","start":"","end":""}],"groups":[{"id":"Q1447659","name":"VIXX","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/leo_jungtw/","x":"https://x.com/JUNGTW_LEO","musicbrainz":"https://musicbrainz.org/artist/d4a10775-aaf8-4d0d-89ea-ddb593150af7"},"photo":null,"bio":{"text":"Jung Taek-woon, known professionally as Leo, is a South Korean singer, songwriter and musical theatre actor, formerly signed under Jellyfish Entertainment. Leo debuted as a member of the South Korean boy group VIXX in May 2012, and began his acting career in 2014 in the musical Full House as Lee Young-jae. In 2015 he began his songwriting career, and with VIXX member Ravi formed the group's first official sub-unit VIXX LR.","title":"Leo (singer)","url":"https://en.wikipedia.org/wiki/Leo_%28singer%29"}},"Q18567344":{"id":"Q18567344","name":"Jung Chanwoo","ko":"정찬우","birthName":"","birthNameEn":"","aliases":["CHAN","Jung Chan-woo"],"birth":"1998-01-26","death":"","birthplace":"Yongin","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2015","agencies":[{"name":"YG Entertainment","id":"Q50595","start":"","end":""},{"name":"143 Entertainment","id":"Q115973454","start":"","end":""}],"groups":[{"id":"Q18161349","name":"iKon","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/chan_w000/","youtube":"https://www.youtube.com/channel/UC1LiTfGNZiweSTu8_NFVi1g","musicbrainz":"https://musicbrainz.org/artist/81b31112-3359-4c3b-b36a-d4b8e2ad5220"},"photo":null,"bio":{"text":"Jung Chan-woo, better known mononymously as Chanwoo or his stage name Chan, is a South Korean singer and actor. He is a member of South Korean boy group iKon under 143 Entertainment. He is known for playing the younger counterparts of Lee Minho in both Boys Over Flowers (2009) and The Heirs (2013).","title":"Jung Chan-woo (singer)","url":"https://en.wikipedia.org/wiki/Jung_Chan-woo_%28singer%29"}},"Q18800":{"id":"Q18800","name":"Tablo","ko":"타블로","birthName":"이선웅","birthNameEn":"","aliases":["Lee Seon-woong","Daniel Armand L