/","musicbrainz":"https://musicbrainz.org/artist/4f1984bc-6949-4b24-a915-8cd642c6e45f"},"photo":null,"bio":{"text":"Kim Shin-young is a South Korean comedian, MC and DJ. She debuted in 2004 on the SBS show People Looking For Laughter and won 'Best Variety Performer' at the 42nd Baeksang Arts Awards in 2006. She has hosted numerous variety shows and radio shows in South Korea and has won several awards for comedy and hosting in her career. In 2018, Kim became a member of Celeb Five (셀럽파이브), a dance group produced by CONTENTS LAB VIVO, a contents company owned by Song Eun-i.","title":"Kim Shin-young","url":"https://en.wikipedia.org/wiki/Kim_Shin-young"}},"Q625732":{"id":"Q625732","name":"Allen Kim","ko":"김기범","birthName":"Kim Ki-bum","birthNameEn":"Kim Ki-bum","aliases":["Kim Ki-bum"],"birth":"1990-12-29","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2006","agencies":[{"name":"NH Media","korean":true,"id":"Q16465976","start":"","end":""},{"name":"Universal Music Group","korean":false,"id":"Q38903","start":"","end":""},{"name":"Universal D","korean":false,"id":"Q17056531","start":"","end":""}],"groups":[{"id":"Q25537387","name":"XING (band)","start":"2006","end":"2007"},{"id":"Q482543","name":"U-KISS","start":"2008","end":"2011"}],"links":{"x":"https://x.com/90kkb","musicbrainz":"https://musicbrainz.org/artist/85a84ab9-1965-4c88-a034-3196ca9eb7c6"},"photo":null,"bio":{"text":"Kim Ki-bum, now better known by his stage name in Japan Allen Kim, is a South Korean idol singer, best known for being a former member of South Korean boy band U-KISS. He is also the younger brother of SS501 member Kim Hyung-jun.","title":"Allen Kim","url":"https://en.wikipedia.org/wiki/Allen_Kim"}},"Q62984452":{"id":"Q62984452","name":"Kim Chae Won","ko":"김채원","birthName":"","birthNameEn":"","aliases":["Chaewon","Kim Chae-won","Kim Chaewon"],"birth":"2000-01-20","death":"","birthplace":"South Korea","nationality":["South Korea"],"hei