_s_1230/","musicbrainz":"https://musicbrainz.org/artist/80d36ea6-3010-4548-8c27-67626ee43af7"},"photo":null,"bio":{"text":"Seo Yu-na, better known by the mononym Yuna, is a South Korean singer-songwriter, actress and yoga instructor. She is a former member of the South Korean girl group AOA and its sub-groups, AOA Black and AOA Cream.","title":"Yuna (singer, born 1992)","url":"https://en.wikipedia.org/wiki/Yuna_%28singer%2C_born_1992%29"}},"Q18116676":{"id":"Q18116676","name":"Jeff Bernat","ko":"제프 버넷","birthName":"","birthNameEn":"","aliases":[],"birth":"1989-12-11","death":"","birthplace":"Subic Bay","nationality":["United States","Philippines"],"height":null,"occupations":["singer","record producer","songwriter"],"debut":"2012","agencies":[],"groups":[],"links":{"instagram":"https://www.instagram.com/jeffbernat/","x":"https://x.com/jeffbernat","spotify":"https://open.spotify.com/artist/2vVT4qoxWje0gVD2FiWZ4u","musicbrainz":"https://musicbrainz.org/artist/39b28824-2859-4ba9-80b9-e6004abc3568"},"photo":null,"bio":{"text":"Jeff Bernat is a Filipino-American singer, songwriter and record producer. He debuted in 2012 with the album, The Gentleman Approach, and developed a significant fan base in South Korea after the album track, \"Call You Mine,\" was featured on the 2014 Korean drama, You Are My Destiny.","title":"Jeff Bernat","url":"https://en.wikipedia.org/wiki/Jeff_Bernat"}},"Q27953988":{"id":"Q27953988","name":"Xiyeon","ko":"시연","birthName":"박정현","birthNameEn":"","aliases":["Park Jung-hyun","Siyeon","Park Si-yeon"],"birth":"2000-11-14","death":"","birthplace":"Suwon","nationality":["South Korea"],"height":null,"occupations":["singer","model","actor"],"debut":"2017","agencies":[{"name":"Pledis Entertainment","korean":true,"id":"Q45282","start":"","end":""}],"groups":[{"id":"Q26265886","name":"Pristin","start":"2017","end":"2019"}],"links":{"instagram":"https://www.instagram.com/0_0.1114/","musicbrainz":"https://musicbrainz.org/artist/d6a6a486-47ee-45c7-bc17-ec5b42e70a24"},"photo":null,"bio":{"text":"Park Jung-hyun, known professionally as Park Xi-yeon, is a South Korean actress. A former child actress, singer and model, she trained under Pledis Entertainment for nine years before making her official debut as a member of the girl group Pristin in 2017. From April 2017 to January 2018, she hosted the South Korean music program Show! Music Core with Cha Eun-woo.","title":"Xiyeon","url":"https://en.wikipedia.org/wiki/Xiyeon"},"positions":["Rapper"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EB%B0%95%EC%8B%9C%EC%97%B0%282000%29"}}},"Q30311684":{"id":"Q30311684","name":"Lai Kuan-li","ko":"라이관린","birthName":"","birthNameEn":"","aliases":[],"birth":"2001-09-23","death":"","birthplace":"Taiwan","nationality":["Taiwan"],"height":null,"occupations":["singer","rapper","actor"],"debut":"2017","agencies":[],"groups":[{"id":"Q30311578","name":"Wanna One","start":"2017","end":"2019"},{"id":"Q63098891","name":"Wooseok x Kuanlin","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/official_lai_kuanlin/","x":"https://x.com/LAI_KUANLIN_twt","musicbrainz":"https://musicbrainz.org/artist/adef559e-db36-4ae1-b365-4c54627f83d0"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/1/1d/190311_%EB%9D%BC%EC%9D%B4%EA%B4%80%EB%A6%B0.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:190311_%EB%9D%BC%EC%9D%B4%EA%B4%80%EB%A6%B0.jpg","author":"뉴스인스타","license":"CC BY 3.0"},"bio":{"text":"Lai Kuan-lin, also romanized as Lai Guanlin and better known mononymously as Guanlin, is a Taiwanese former singer and actor. After finishing seventh on second season of South Korean competition series Produce 101, he joined the boy band Wanna One. After it was disbanded in January 2019, he formed a duo with Pentagon's Wooseok as Wooseok x Kuanlin in March 2019 and released an album. From 2019, he pursued a solo career in China, primarily as an actor, before moving into behind-the-scenes work in 2024.","title":"Lai Kuan-lin","url":"https://en.wikipedia.org/wiki/Lai_Kuan-lin"},"positions":["Sub rapper"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EB%9D%BC%EC%9D%B4%EA%B4%80%EB%A6%B0"}}},"Q30942276":{"id":"Q30942276","name":"Jang Jin-yeong","ko":"장진영","birthName":"","birthNameEn":"","aliases":["Jang Jin Yeong","Jang Jin-young","Xia"],"birth":"1993-11-15","death":"","birthplace":"Suwon","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q491708","name":"RANIA","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/jangjinjin/","x":"https://x.com/Rania_xia"},"photo":null,"bio":null},"Q484484":{"id":"Q484484","name":"Kim Jong-hyun","ko":"종현","birthName":"김종현","birthNameEn":"","aliases":["Kim Jong-hyeon","Jonghyun"],"birth":"1990-04-08","death":"2017-12-18","birthplace":"Hyehwa-dong","nationality":["South Korea"],"height":174,"occupations":["singer","actor","model","songwriter","radio personality","singer-songwriter"],"debut":"2008-05-25","agencies":[{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"","end":""},{"name":"EMI Music Japan","korean":false,"id":"Q1365614","start":"","end":""}],"groups":[{"id":"Q269836","name":"SHINee","start":"2008","end":"2017"},{"id":"Q497441","name":"SM the Ballad","start":"2010","end":"2014"}],"links":{"instagram":"https://www.instagram.com/jonghyun.948/","x":"https://x.com/realjonghyun90","spotify":"https://open.spotify.com/artist/5rGgflnIpRNizTCozbYBuY","musicbrainz":"https://musicbrainz.org/artist/2cb1105c-5f6d-426f-91a5-7b80f2fc68ff"},"photo":null,"bio":{"text":"Kim Jong-hyun, known mononymously as Jonghyun, was a South Korean singer-songwriter, record producer, radio host, and author under the SM Entertainment label. He was the vocalist of the South Korean boy band Shinee for nine years, releasing twelve albums with the group in both Korean and Japanese. He also participated in SM Entertainment's project group, SM the Ballad, for the release of two EP albums. Jonghyun was also a solo artist, beginning in January 2015 with the release of his first EP album, Base. It peaked at number one on both the Billboard World Albums Chart and the Gaon Album Chart. On September 17 the same year, Jonghyun released a compilation album, Story Op.1.","title":"Jonghyun","url":"https://en.wikipedia.org/wiki/Jonghyun"},"positions":["Main vocalist"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EC%A2%85%ED%98%84"}}},"Q486084":{"id":"Q486084","name":"Lee Ji-hoon","ko":"이지훈","birthName":"","birthNameEn":"","aliases":["Lee Jee Hoon"],"birth":"1979-03-27","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","film actor","actor","television actor"],"debut":"1996","agencies":[],"groups":[{"id":"Q7395331","name":"S","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/_leejeehoon79/","x":"https://x.com/leejeehoon79","musicbrainz":"https://musicbrainz.org/artist/ef45da1c-0f0d-42ea-97e6-2d4abce3e5fd"},"photo":null,"bio":{"text":"Lee Ji-hoon is a South Korean singer and actor.","title":"Lee Ji-hoon (entertainer)","url":"https://en.wikipedia.org/wiki/Lee_Ji-hoon_%28entertainer%29"}},"Q496580":{"id":"Q496580","name":"Yubin","ko":"유빈","birthName":"김유빈","birthNameEn":"","aliases":["Kim Yu-bin"],"birth":"1988-10-04","death":"","birthplace":"Gwangju","nationality":["South Korea"],"height":null,"occupations":["singer","model","actor","songwriter","rapper"],"debut":"2007","agencies":[{"name":"JYP Entertainment","korean":true,"id":"Q483238","start":"","end":""},{"name":"Good Entertainment","korean":true,"id":"Q10855622","start":"","end":""}],"groups":[{"id":"Q476119","name":"Wonder Girls","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/iluvyub/","x":"https://x.com/yubinofficial","youtube":"https://www.youtube.com/channel/UC3zD47ZL9GpPPAkW_G6vvlw","musicbrainz":"https://musicbrainz.org/artist/d02f99a7-5487-4759-ba64-0f6d823b8b87"},"photo":null,"bio":{"text":"Kim Yu-bin, referred to as Yubin, is a South Korean rapper, singer-songwriter and actress. Kim is a founder and CEO of the entertainment agency RRR Entertainment. She initially rose to fame as a member of South Korean girl group Wonder Girls, formed in 2007 by JYP and active with the group until disbanded in 2017. She made her solo debut in 2018 with the single \"Lady\".","title":"Kim Yu-bin","url":"https://en.wikipedia.org/wiki/Kim_Yu-bin"},"positions":["Main rapper","Sub vocalist"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EC%9C%A0%EB%B9%88"}}},"Q54598788":{"id":"Q54598788","name":"Haein","ko":"해인","birthName":"","birthNameEn":"","aliases":["Yeom Hae-in"],"birth":"1995-05-19","death":"","birthplace":"Uijeongbu","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q18344661","name":"Laboum","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/hhae_in_/"},"photo":null,"bio":null,"positions":["Sub vocalist","Lead dancer"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%ED%95%B4%EC%9D%B8"}}},"Q61100100":{"i