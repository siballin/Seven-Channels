","Sub vocalist"],"mbti":"ENFJ","factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EB%B0%95%EC%84%9C%ED%95%A8"},"mbti":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EB%B0%95%EC%84%9C%ED%95%A8"}}},"Q57911410":{"id":"Q57911410","name":"DPR Ian","ko":"DPR 이안","birthName":"유바롬","birthNameEn":"","aliases":["Christian Yu"],"birth":"1990-09-06","death":"","birthplace":"Sydney","nationality":["Australia","South Korea"],"height":174,"occupations":["singer","rapper","film director","songwriter","musician"],"debut":"2012","agencies":[],"groups":[{"id":"Q491944","name":"C-Clown","start":"2012","end":"2015"}],"links":{"instagram":"https://www.instagram.com/dprian/","x":"https://x.com/DPRIAN_","tiktok":"https://www.tiktok.com/@Mito.is.real","spotify":"https://open.spotify.com/artist/2o8gT0fQmFxGNbowbdgeZe","musicbrainz":"https://musicbrainz.org/artist/7cc968e5-7ff7-4ec8-9334-c3344bafd383"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/e/e1/%28%EA%B3%B5%EC%8B%9D%EC%98%81%EC%83%81%29_C-CLOWN_%EB%8D%B0%EB%B7%94_100%EC%9D%BC_%EC%B6%95%ED%95%98%EC%98%81%EC%83%81_44s_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:(%EA%B3%B5%EC%8B%9D%EC%98%81%EC%83%81)_C-CLOWN_%EB%8D%B0%EB%B7%94_100%EC%9D%BC_%EC%B6%95%ED%95%98%EC%98%81%EC%83%81_44s_(cropped).jpg","author":"cclownofficial","license":"CC BY 3.0"},"bio":{"text":"Christian Yu, known professionally as DPR Ian, is an Australian singer, songwriter, dancer, producer and director based in Los Angeles. He is a former member of Yedang Entertainment boy group C-Clown, which was active between 2012 and 2015. Yu made his sol