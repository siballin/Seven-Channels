bfc3-7323063ae0da"},"photo":null,"bio":{"text":"Kim Yu-gyeom, known mononymously as Yugyeom, is a South Korean singer-songwriter and dancer who made his debut as a member of the South Korean boy band Got7 in 2014 and the subunit Jus2.","title":"Yugyeom","url":"https://en.wikipedia.org/wiki/Yugyeom"},"positions":["Main dancer","Vocalist"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EC%9C%A0%EA%B2%B8"}}},"Q17682967":{"id":"Q17682967","name":"Song Min-ho","ko":"송민호","birthName":"","birthNameEn":"","aliases":["Mino","Minho","Winner's Mino"],"birth":"1993-03-30","death":"","birthplace":"Yongin","nationality":["South Korea"],"height":null,"occupations":["singer","rapper","songwriter","composer","record producer","actor"],"debut":"2014","agencies":[{"name":"YG Entertainment","korean":true,"id":"Q50595","start":"","end":""}],"groups":[{"id":"Q15116397","name":"Winner","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/realllllmino/","x":"https://x.com/official_mino_","musicbrainz":"https://musicbrainz.org/artist/2650741e-908c-4cae-ba98-0717da3c3ce0"},"photo":null,"bio":{"text":"Song Min-ho, better known by the stage name Mino, is a South Korean rapper, singer-songwriter, music producer, artist and actor. After a stint in the two-year ballad group BoM from 2011 to 2013, he joined YG Entertainment, leading to his debut in 2014 with the boy band Winner, formed through Mnet survival program WIN: Who Is Next. Alongside label-mate Bobby, he is also part of the hip hop duo MOBB, formed in September 2016. As a solo artist, Mino first gained recognition as a contestant in the rap-survival program, Show Me the Money 4, where he finished as the series runner-up, and became the best-selling artist among the show's history with his single, \"Fear\" (겁).","title":"Mino (rapper)","url":"https://en.wikipedia.org/wiki/Mino_%28rapper%29"}},"Q19939351":{"id":"Q19939351","name":"Gong Myoung","ko":"공명","birthName":"김동현","birthNameEn":"","aliases":["Kim Dong-hyeon","Gong Myeong","Gong Myung"],"birth":"1994-05-26","death":"","birthplace":"Ansan","nationality":["South Korea"],"height":null,"occupations":["singer","film actor","television actor","actor"],"debut":"2013","agencies":[],"groups":[{"id":"Q16935427","name":"5urprise","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/0myoung_0526/","x":"https://x.com/the5urprise"},"photo":null,"bio":{"text":"Kim Dong-hyun, known professionally as Gong Myung, is a South Korean actor. He is a member of 5urprise. He is known for his roles in the television series Be Melodramatic (2019), and Lovers of the Red Sky (2021), as well as the film Extreme Job (2019).","title":"Gong Myung","url":"https://en.wikipedia.org/wiki/Gong_Myung"}},"Q19940503":{"id":"Q19940503","name":"Hwang Ye-eun","ko":"예은","birthName":"","birthNameEn":"","aliases":["Hwang Yeeun","Yeeun"],"birth":"1997-01-12","death":"","birthplace":"","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q19839916","name":"Blady","start":"","end":""}],"links":{},"photo":null,"bio":null},"Q21094167":{"id":"Q21094167","name":"Wang Yibo","ko":"왕이보","birthName":"","birthNameEn":"","aliases":["Yibo","wangjie","Bodi"],"birth":"1997-08-05","death":"","birthplace":"Luoyang","nationality":["People's Republic of China"],"height":null,"occupations":["singer","actor","dancer","presenter","racing driver","rapper"],"debut":"2014","agencies":[{"name":"Yuehua Entertainment","korean":false,"id":"Q18390500","start":"","end":""}],"groups":[{"id":"Q18712416","name":"Uniq","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/yibo.w_85/","spotify":"https://open.spotify.com/artist/78VwxJTp5IiHbHyPIvnSZK","musicbrainz":"https://musicbrainz.org/artist/f1e8a565-4985-44dd-920c-7e9b00d637d0"},"photo":null,"bio":{"text":"Wang Yibo is a Chinese actor, dancer, singer, professional road motorcycle racer and racing driver. He debuted as a member of South Korean-Chinese boyband Uniq in 2014. As an actor, he is best known for his roles in television series Love Actually (2017), Gank Your Heart (2019), The Untamed (2019), Legend of Fei (2020), Luoyang (2021), Being a Hero (2022) and War of Faith (2024). He made his big screen lead role debut in 2023, starring in Hidden Blade, Born to Fly and One and Only. His performances have earned him multiple acting nominations at various film awards, including the Golden Rooster Awards, Huabiao Awards and Asian Film Awards.","title":"Wang Yibo","url":"https://en.wikipedia.org/wiki/Wang_Yibo"}},"Q27953047":{"id":"Q27953047","name":"Samuel","ko":"사무엘","birthName":"","birthNameEn":"","aliases":["Samuel Arredondo","Kim Samuel","Samuel Kim Arredondo","Punch"],"birth":"2002-01-17","death":"","birthplace":"Los Angeles","nationality":["South Korea","United States","Mexico"],"height":null,"occupations":["singer","rapper"],"debut":"2015","agencies":[{"name":"BPM Entertainment","korean":true,"id":"Q108876386","start":"","end":""},{"name":"Brave Entertainment","korean":true,"id":"Q4958352","start":"","end":""}],"groups":[{"id":"Q19855050","name":"1Punch","start":"2015","end":"2015"}],"links":{"instagram":"https://www.instagram.com/its_kimsamuel/","x":"https://x.com/ksamuelofficial","youtube":"https://www.youtube.com/channel/UCKfFMnulgxbHyDPedK4V1cQ","musicbrainz":"https://musicbrainz.org/artist/1bcdf6f8-bf0d-4153-b58b-b061f16e14f0"},"photo":null,"bio":{"text":"Samuel Kim Arredondo, better known by his stage name Samuel, is an American singer based in South Korea. He was a part of the short-lived hip hop duo 1Punch in 2015. He participated in the reality television series season 2 of Produce 101 during the first half of 2017. In the final episode, he ranked 18th and was not able to join the show's project group. One month after the show ended, he began his solo career, with the release of his debut extended play (EP) Sixteen on August 2, 2017.","title":"Samuel (singer)","url":"https://en.wikipedia.org/wiki/Samuel_%28singer%29"}},"Q30942487":{"id":"Q30942487","name":"Wu Xuanyi","ko":"우쉬엔이","birthName":"","birthNameEn":"","aliases":["Xuanyi","Betty Wu","Wu Xuan Yi","Oh Sun Ee","O Seon Ui","U Swi An I"],"birth":"1995-01-26","death":"","birthplace":"Haikou","nationality":["People's Republic of China"],"height":166,"occupations":["singer","dancer","actor"],"debut":"2016","agencies":[{"name":"Starship Entertainment","korean":true,"id":"Q255363","start":"","end":""},{"name":"Yuehua Entertainment","korean":false,"id":"Q18390500","start":"","end":""}],"groups":[{"id":"Q21964258","name":"WJSN","start":"2016","end":"2023"}],"links":{"instagram":"https://www.instagram.com/w.xuanyi0126/","musicbrainz":"https://musicbrainz.org/artist/8e745496-cb3f-44d3-9816-416a75d15972"},"photo":null,"bio":{"text":"Wu Xuanyi is a Chinese singer and actress. She began her career in 2016, as a member of the South Korean girl group WJSN. She took a hiatus from the group in the first half of 2018 to compete as a contestant in Tencent Video's survival reality show, Produce 101 China, finishing in second place and joining the Chinese project girl group Rocket Girls 101 until June 2020. Following the disbandment of the project group, she remained on hiatus from WJSN to pursue a solo career in China until she left the group on March 3, 2023.","title":"Wu Xuanyi","url":"https://en.wikipedia.org/wiki/Wu_Xuanyi"}},"Q482519":{"id":"Q482519","name":"Park Yoo-chun","ko":"박유천","birthName":"","birthNameEn":"","aliases":["Park Yu-cheon","Micky Yoochun","Park Yoochun"],"birth":"1986-06-04","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["actor","singer","composer","singer-songwriter","model","television actor"],"debut":"2003","agencies":[{"name":"C-JeS Studios","korean":true,"id":"Q5005884","start":"","end":""},{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"","end":""},{"name":"Rhythm Zone","korean":false,"id":"Q1154245","start":"","end":""}],"groups":[{"id":"Q192983","name":"TVXQ","start":"2003","end":"2009"},{"id":"Q51729","name":"JYJ","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/pyc_official_/","x":"https://x.com/6002theMicky","musicbrainz":"https://musicbrainz.org/artist/db746e15-687d-4b2a-959b-788988cc5037"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/2/2a/Yoochun_at_Busan_International_Film_Festival_%22Sea_Fog%22_outdoor_stage_greeting%2C_3_October_2014_03.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Yoochun_at_Busan_International_Film_Festival_%22Sea_Fog%22_outdoor_stage_greeting,_3_October_2014_03.jpg","author":"Bonjour Lavender","license":"CC BY 4.0"},"bio":{"text":"Park Yoo-chun, formerly known as Micky Yoochun and better known by the mononym Yoochun, is a Korean-American singer-songwriter and actor. He is a member of the South Korean JYJ and former member of TVXQ. He has starred in dramas Sungkyunkwan Scandal (2010), Miss Ripley (2011), Rooftop Prince (2012), Missing You (2012), Three Days (2014), and A Girl Who Sees Smells (2015).","title":"Park Yoo-chun","url":"https://en.wikipedia.org/wiki/Park_Yoo-chun"},"positions":["Sub vocalist","Main rapper"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EB%B0%95%EC%9C%A0%EC%B2%9C"}}},"Q483991":{"id":"Q483991","name":"Lee Jae-won","ko":"이재원","birthName":"","birthNameEn":"","aliases":[],"birth":"1980-04-05","death":"","birthplace":"Gangdong District","nationality":["South Korea"],"height":null,"occupations":["singer","rapper","actor","disc jockey"],"debut":"1996","agencies":[{"name":"SM Entertainment","korean":