na"],"height":null,"occupations":["singer"],"debut":"2023","agencies":[{"name":"Modhaus","id":"Q117195732","start":"","end":""}],"groups":[{"id":"Q115099831","name":"TripleS","start":"2023","end":""}],"links":{"musicbrainz":"https://musicbrainz.org/artist/98826915-ff78-40e4-bad8-708584248c07"},"photo":null,"bio":{"text":"Zhou Xinyu, known mononymously as Xinyu, is a Chinese singer. Since 2023, she is a member of South Korean multinational girl group TripleS and its sub-units Lovelution, Visionary Vision and Sun.","title":"Xinyu (singer)","url":"https://en.wikipedia.org/wiki/Xinyu_%28singer%29"}},"Q133826545":{"id":"Q133826545","name":"JUNPYO","ko":"준표","birthName":"","birthNameEn":"","aliases":[],"birth":"2003-05-25","death":"","birthplace":"","nationality":[],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q132119456","name":"Nouera","start":"","end":""}],"links":{},"photo":null,"bio":null},"Q137670193":{"id":"Q137670193","name":"Lee Jeongmin","ko":"","birthName":"","birthNameEn":"","aliases":["正珉"],"birth":"1994-01-02","death":"","birthplace":"Suwon","nationality":[],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q307457","name":"BF","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/boy_jm_/"},"photo":null,"bio":null},"Q141853617":{"id":"Q141853617","name":"Aijing","ko":"아이찡","birthName":"","birthNameEn":"","aliases":["Shèng Àijìng"],"birth":"2013-04-24","death":"","birthplace":"","nationality":["People's Republic of China"],"height":null,"occupations":["pop singer"],"debut":"","agencies":[],"groups":[{"id":"Q141752366","name":"A2O Lite","start":"","end":""}],"links":{},"photo":null,"bio":null},"Q16092017":{"id":"Q16092017","name":"Jiyul","ko":"지율","birthName":"Yang Jung-yoon","birthNameEn":"Yang Jung-yoon","aliases":["Yang Jung-yoon"],"birth":"1991-07-30","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor","model"],"debut":"2011","agencies":[{"name":"Happy Face Entertainment","id":"Q15154003","start":"","end":""}],"groups":[{"id":"Q492146","name":"Dal Shabet","start":"2011","end":"2015"}],"links":{"instagram":"https://www.instagram.com/jiyul_7/","x":"https://x.com/shabet_jiyul","musicbrainz":"https://musicbrainz.org/artist/f33899a9-05bd-44f1-8cfd-8b0f66b00504"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/d/de/Jiyul_Jung.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Jiyul_Jung.jpg","author":"Jinho Jung from Seoul, South Korea","license":"CC BY-SA 2.0"},"bio":{"text":"Yang Jung-yoon, better known by her stage name Jiyul or Min Ji-yul, is a South Korean singer and actress. As a singer she is best known member of the South Korean girl group Dal Shabet.","title":"Jiyul (singer)","url":"https://en.wikipedia.org/wiki/Jiyul_%28singer%29"}},"Q20145":{"id":"Q20145","name":"IU","ko":"아이유","birthName":"이지은","birthNameEn":"","aliases":["Lee Ji-eun","Yi Chi-ŭn","Lee Jieun","Jieun Lee","Lee Jee-eun","Aiyu","IU"],"birth":"1993-05-16","death":"","birthplace":"Songjeong-dong","nationality":["South Korea"],"height":null,"occupations":["singer","actor","songwriter","voice actor"],"debut":"2008","agencies":[{"name":"EMI","id":"Q183412","start":"","end":""},{"name":"Kakao M","id":"Q625975","start":"","end":""},{"name":"EDAM Entertainment","id":"Q85872777","start":"","end":""}],"groups":[],"links":{"instagram":"https://www.instagram.com/dlwlrma/","x":"https://x.com/lily199iu","youtube":"https://www.youtube.com/channel/UC3SyT4_WLHzN7JmHQwKQZww","tiktok":"https://www.tiktok.com/@_iuofficial","spotify":"https://open.spotify.com/artist/3HqSLMAZ3g3d5poNaI7GOU","musicbrainz":"https://musicbrainz.org/artist/b9545342-1e6d-4dae-84ac-013374ad8d7c"},"photo":null,"bio":{"text":"Lee Ji-eun, also known by her stage name IU (아이유), is a South Korean singer-songwriter and actress. She signed with LOEN Entertainment (now Kakao Entertainment) in 2007 as a trainee and debuted as a singer at the age of fifteen with the EP Lost and Found (2008). Although her follow-up albums brought mainstream success, it was only after the release of \"Good Day\", the lead single from her 2010 EP Real, that she achieved national stardom. \"Good Day\" went on to spend five consecutive weeks at the top of South Korea's Gaon Digital Chart, and in 2019, it was ranked number one on Billboard's \"100 Greatest K-Pop Songs of the 2010s\" list.","title":"IU (entertainer)","url":"https://en.wikipedia.org/wiki/IU_%28entertainer%29"}},"Q20821809":{"id":"Q20821809","name":"Yuju","ko":"유주 (가수)","birthName":"최유나","birthNameEn":"","aliases":["Choi Yu-na"],"birth":"1997-10-04","death":"","birthplace":"Deogyang-gu","nationality":["South Korea"],"height":null,"occupations":["singer","singer-songwriter"],"debut":"2015","agencies":[{"name":"At Area","id":"Q133262659","start":"2025-03-12","end":""},{"name":"Source Music","id":"Q21709935","start":"","end":""},{"name":"Konnect Entertainment","id":"Q97339243","start":"","end":""}],"groups":[{"id":"Q18733030","name":"GFriend","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/yuuzth/","x":"https://x.com/YUJU_atarea","youtube":"https://www.youtube.com/channel/UCvKIvp7qTFBocvnqfP0R8rQ","tiktok":"https://www.tiktok.com/@yuju_atarea","spotify":"https://open.spotify.com/artist/7Bu0r4MCDX3sbhcFD5IXyx","musicbrainz":"https://musicbrainz.org/artist/344d0612-8e74-4227-a4ec-9848a6534d86"},"photo":null,"bio":{"text":"Choi Yu-na, better known by her stage name Yuju (유주), is a South Korean singer-songwriter. She rose to fame in 2015 as a member of the South Korean girl group GFriend and became known for her vocals, having participated in various singing competitions. After GFriend's exclusive contract ended, Yuju debuted as a solo artist with the extended play (EP) Rec. in 2022 and took creative control over her works. Yuju's accolades include individual awards from the K-Global Heart Dream Awards, Hanteo Music Awards, and Seoul Music Awards. Her chart-topping duet song \"Spring Is Gone by Chance\" for the television series A Girl Who Sees Smells soundtrack won Best OST at the 2015 Melon Music Awards.","title":"Yuju (singer)","url":"https://en.wikipedia.org/wiki/Yuju_%28singer%29"}},"Q21144753":{"id":"Q21144753","name":"Yellow","ko":"노랑","birthName":"","birthNameEn":"","aliases":["Kim Eunbi","Norang"],"birth":"1993-05-05","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","model"],"debut":"","agencies":[],"groups":[],"links":{"musicbrainz":"https://musicbrainz.org/artist/e8038f4d-a818-4885-be0e-8aa85c06a5b4"},"photo":null,"bio":{"text":"Pungdeng-E (풍뎅이) is a South Korean female music trio formed in December 2013. One of their original concepts was the use of different regional Korean dialects where each member uses her own local dialect. They are known to have unique lyrics and videos. The members modeled together for the Korean cosmetics brand Seed & Tree. Pungdeng-E performed on the first and third day of the 42nd Los Angeles Korean Festival in California on November 2, 2015. The groups first Japanese performance was on November 28, 2015 in Ōta, Tokyo.","title":"Yellow (singer)","url":"https://en.wikipedia.org/wiki/Yellow_%28singer%29"}},"Q24945":{"id":"Q24945","name":"Lee Hi","ko":"이하이","birthName":"","birthNameEn":"","aliases":["Lee Ha-yi","LeeHi","Lee Ha Yi"],"birth":"1996-09-23","death":"","birthplace":"Bucheon","nationality":["South Korea"],"height":null,"occupations":["singer","recording artist"],"debut":"2012","agencies":[{"name":"YG Entertainment","id":"Q50595","start":"2012-05","end":"2019-12"},{"name":"AOMG","id":"Q16164774","start":"2020-07","end":"2024-03"}],"groups":[],"links":{"website":"https://www.aomgofficial.com/leehi","instagram":"https://www.instagram.com/leehi_hi/","x":"https://x.com/leehi_hi","youtube":"https://www.youtube.com/channel/UCT86dWwZWeJWGQCDzbipU-A","spotify":"https://open.spotify.com/artist/7cVZApDoQZpS447nHTsNqu","musicbrainz":"https://musicbrainz.org/artist/60c05c03-e33e-44a7-bef8-6fb245aaea51"},"photo":null,"bio":{"text":"Lee Ha-yi, known by her stage name LeeHi, is a South Korean singer and songwriter. She first garnered attention as the runner-up of the first season of K-pop Star. She debuted with the single \"1, 2, 3, 4\" on October 28, 2012, and reached number one with first week sales of 667,549 downloads. Her first full-length album First Love was released in two parts: the first on 7 March 2013 and the second on 28 March 2013. Her second full-length album Seoulite, released 20 April 2016, featured chart-topping \"all-kill\" single \"Breathe\", written by Kim Jong-hyun of SHINee.","title":"Lee Hi","url":"https://en.wikipedia.org/wiki/Lee_Hi"}},"Q27431345":{"id":"Q27431345","name":"Na Jaemin","ko":"나재민","birthName":"","birthNameEn":"","aliases":["Jaemin"],"birth":"2000-08-13","death":"","birthplace":"Jeonju","nationality":["South Korea"],"height":null,"occupations":["rapper","actor","dancer","singer"],"debut":"2016","agencies":[{"name":"Avex Group","id":"Q790686","start":"","end":""},{"name":"SM Entertainment","id":"Q483938","start":"","end":""}],"groups":[{"id":"Q23725822","name":"NCT","start":"","end":""},{"id":"Q47002841","name":"NCT Dream","start":"","end":""},{"id":"Q67972645","name":"NCT U","start":"","end":""},{"id":"Q138529514","name":"NCT JNJM","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/na.jaemin0813/","musicbrainz":"https://musicbrainz.org/artist/8fbfed56-bd2e-40c6-b686-c8e66445c6bb"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/1/1c/Na_Jae-min_the_25th_DREAM_CONCERT.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Na_Jae-min_the_25th_DREAM_CONCERT.png","author":"NINE STARS","license":"CC BY 3.0"},"bio":{"text":"Na Jae-min, known mononymously as Jaemin, is a South Korean singer, rapper, and actor. He rose to prominence as a member of the K-pop boy band NCT and its sub-units NCT Dream and NCT JNJM. Born in Busan and raised in Jeonju and Seoul, Jaemin started training under SM Entertainment in 2013. He began his career in 2014, appearing on television and touring both in South Korea and abroad with the label's official team of trainees, SM Rookies. He made his debut in 2016 with NCT, which went on to achieve commercial success and become an influential K-pop act.","title":"Jaemin","url":"https://en.wikipedia.org/wiki/Jaemin"}},"Q47545137":{"id":"Q47545137","name":"Yongsin Wongpanitnont","ko":"","birthName":"","birthNameEn":"","aliases":["Yorch","Yorch Yongsin"],"birth":"2002-04-11","death":"","birthplace":"","nationality":[],"height":null,"occupations":["actor","dancer","singer"],"debut":"2023","agencies":[],"groups":[{"id":"Q122942333","name":"Pow","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/yorch_yongsin/"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/c/cd/Yorch_Yongsin.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Yorch_Yongsin.jpg","author":"Smart Live","license":"CC BY 3.0"},"bio":{"text":"Yongsin Wongpanitnont, nicknamed Yorch (Thai: ยอร์ช), is a Thai actor and singer. He is best known for his role as Wanchaloem in Thong Nuea Kao (2013). Yorch made his debut as a solo artist with the single \"Seven\" in April 2023, and debuted as a member of the South Korean boy band Pow in July that year.","title":"Yongsin Wongpanitnont","url":"https://en.wikipedia.org/wiki/Yongsin_Wongpanitnont"}},"Q483633":{"id":"Q483633","name":"Sohee","ko":"안소희","birthName":"","birthNameEn":"","aliases":["An So-hui","Ahn So-hee"],"birth":"1992-06-27","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["actor","singer","film actor","model"],"debut":"2007","agenci