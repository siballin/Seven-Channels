ww.instagram.com/josojin/","x":"https://x.com/josojin_1011"},"photo":null,"bio":null},"Q21824862":{"id":"Q21824862","name":"Lee Seok-min","ko":"도겸","birthName":"이석민","birthNameEn":"","aliases":["DK","Dokyeom","Lee Dokyeom"],"birth":"1997-02-18","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2015","agencies":[{"name":"Pledis Entertainment","korean":true,"id":"Q45282","start":"","end":""},{"name":"Hybe","korean":true,"id":"Q16161254","start":"","end":""}],"groups":[{"id":"Q14524548","name":"Seventeen","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/dk_is_dokyeom/","musicbrainz":"https://musicbrainz.org/artist/81f70c77-2c06-486b-9fdd-eb74f5c94bfa"},"photo":null,"bio":{"text":"Lee Seok-min, known professionally as Dokyeom (도겸) or DK, is a South Korean singer. Managed by Pledis Entertainment he is a member of the South Korean boy band Seventeen, its vocal team, and is the leader of its subunit BSS with Hoshi and Seungkwan. Outside of his group activities, In 2019, DK made his musical theatre debut with the lead role Arthur in XCalibur, the South Korean production of Artus-Excalibur. He then returned to play the role of Arthur in XCalibur's 2021 run. DK has also released a number of OSTs that have been commercially successful in South Korea.","title":"DK (singer)","url":"https://en.wikipedia.org/wiki/DK_%28singer%29"}},"Q21824990":{"id":"Q21824990","name":"Woozi","ko":"우지","birthName":"이지훈","birthNameEn":"","aliases":["Jihoon","Lee Woozi","Lee Ji-hoon"],"birth":"1996-11-22","death":"","birthplace":"Busan","nationality":["South Korea"],"height":null,"occupations":["singer","songwriter"],"debut":"2015","agencies":[{"name":"Pledis Entertainment","korean":true,"id":"Q45282","start":"","end":""},{"name":"Hybe","korean":true,"id":"Q16161254","start":"","end":""}],"groups":[{"id":"Q14524548","name":"Seventeen","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/woozi_universefactory/","musicbrainz":"https://musicbrainz.org/artist/019112cf-7bc7-4c71-9c62-e887a4d22baa"},"photo":null,"bio":{"text":"Lee Ji-hoon, known by his stage name Woozi (우지), is a South Korean singer, songwriter and record producer. Managed by Pledis Entertainment, he is a member of the South Korean boy band Seventeen, the leader of its vocal team, and part of its subunit Hoshi X Woozi. In 2022, he made his solo debut with \"Ruby\". Aside from his work as a soloist and with Seventeen, Woozi has also written for other K-pop artists such as NU'EST W, Ailee, and I.O.I.","title":"Woozi","url":"https://en.wikipedia.org/wiki/Woozi"}},"Q23454":{"id":"Q23454","name":"Ryan Higa","ko":"라이언 히가","birthName":"","birthNameEn":"","aliases":["Nigahiga"],"birth":"1990-06-06","death":"","birthplace":"Hilo","nationality":["United States"],"height":null,"occupations":["judoka","comedian","YouTuber","film actor","actor","television producer"],"debut":"2006","agencies":[],"groups":[{"id":"Q24909324","name":"Boys Generally Asian","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/notryanhiga/","x":"https://x.com/TheRealRyanHiga","youtube":"https://www.youtube.com/channel/UCSAUGyc_xA8uYzaIVG6MESQ","spotify":"https://open.spotify.com/artist/6tTLF2AwozAFKKldqvUTNe","musicbrainz":"https://musicbrainz.org/artist/aae2183a-ec2c-4950-ab43-4acd8935442b"},"photo":null,"bio":{"text":"Ryan Higa, also known as nigahiga ( NEE-ɡə-HEE-ɡə), is an American internet personality, comedian, actor, streamer and former YouTuber. Best known for his comedy videos, Higa began making YouTube videos in 2006 and was one of the most popular creators on the platform in its early years. His main YouTube channel, nigahiga, was the most subscribed channel on YouTube over two periods, a very brief 9 day period in September and October 2008, and a 675 consecutive day period from 2009 to 2011. In 2020, Higa took a hiatus from YouTube and started streaming on Twitch, where he reacts to his past videos and broadcasts video game content, most notably in Valorant.","title":"Ryan Higa","url":"https://en.wikipedia.org/wiki/Ryan_Higa"}},"Q24959134":{"id":"Q24959134","name":"Jung Chae-yeon","ko":"정채연","birthName":"","birthNameEn":"","aliases":["Chae-yeon"],"birth":"1997-12-01","death":"","birthplace":"Suncheon","nationality":["South Korea"],"height":null,"occupations":["model","singer","actor"],"debut":"2015","agencies":[{"name":"MBK Entertainment","korean":true,"id":"Q429296","start":"","end":""}],"groups":[{"id":"Q20733515","name":"DIA","start":"2015","end":"2022"},{"id":"Q23688122","name":"I.O.I","start":"2026","end":"2017"}],"links":{"instagram":"https://www.instagram.com/j_chaeyeoni/","musicbrainz":"https://musicbrainz.org/artist/56debc89-c729-43bc-ac37-1750497d4a47"},"photo":null,"bio":{"text":"Jung Chae-yeon, known mononymously as Chaeyeon, is a South Korean actress and singer. She is a former member of the girl group DIA and also a former member of a project girl group I.O.I, having finished 7th in the survival show Produce 101. She is currently active as an actress, best known for her lead roles in the television series To. Jenny (2018), My First First Love (2019), The King's Affection (2021), The Golden Spoon (2022), and Family by Choice (2024).","title":"Jung Chae-yeon","url":"https://en.wikipedia.org/wiki/Jung_Chae-yeon"}},"Q26405662":{"id":"Q26405662","name":"Bekuh BOOM","ko":"","birthName":"Rebecca Rose Johnson","birthNameEn":"Rebecca Rose Johnson","aliases":["Rebecca Rose Johnson","Rebecca Johnson"],"birth":"1994-06-21","death":"","birthplace":"Orange County","nationality":["United States"],"height":null,"occupations":["songwriter","singer-songwriter"],"debut":"2013","agencies":[],"groups":[{"id":"Q65061223","name":"K/DA","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/bekuhboom/","x":"https://x.com/bekuhboom","musicbrainz":"https://musicbrainz.org/artist/a9b994ea-b2a8-4507-8a19-919686b943c5"},"photo":null,"bio":{"text":"Rebecca Rose Johnson, professionally known as Bekuh Boom (stylized as Bekuh BOOM) is an American singer and songwriter. Johnson signed her first publishing deal to Warner Chappell Music at the age of 18. She featured on two co-written singles: \"I Won't Let You Down\" by Danish singer Christopher, which charted at #1 on Tracklisten, the official Danish music charts, and \"Money\" by Norwegian electronic duo Broiler, which peaked at #3 on Norwegian music charts. As of 2016 she has written over 10 songs reaching the #1 position on various music charts. Boom wrote and composed for various acts including R. Kelly, Jordin Sparks, Christopher, Taeyang, Winner, iKon, Blackpink, Jeon Somi and Lisa.","title":"Bekuh Boom","url":"https://en.wikipedia.org/wiki/Bekuh_Boom"}},"Q29876894":{"id":"Q29876894","name":"Arin","ko":"아린","birthName":"최예원","birthNameEn":"","aliases":["Choi Ye-won","Choi Yewon"],"birth":"1999-06-18","death":"","birthplace":"Busan","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2015","agencies":[],"groups":[{"id":"Q19794854","name":"Oh My Girl","start":"2015","end":""},{"id":"Q65054131","name":"Oh My Girl Banhana","start":"2018","end":""}],"links":{"instagram":"https://www.instagram.com/ye._.vely618/","musicbrainz":"https://musicbrainz.org/artist/db5b854a-3d83-4606-ab7e-b41efabc3007"},"photo":null,"bio":{"text":"Choi Ye-won, known professionally as Arin (아린), is a South Korean singer and actress. She is a member of South Korean girl group Oh My Girl.","title":"Arin (singer)","url":"https://en.wikipedia.org/wiki/Arin_%28singer%29"}},"Q486942":{"id":"Q486942","name":"Lee Joo-yeon","ko":"주연","birthName":"","birthNameEn":"","aliases":["Jooyeon","Juyeon","Lee Ju-yeon","Lee Jooyeon"],"birth":"1987-03-19","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2009","agencies":[{"name":"Pledis Entertainment","korean":true,"id":"Q45282","start":"","end":""}],"groups":[{"id":"Q389067","nam