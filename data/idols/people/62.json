"],"debut":"2015","agencies":[{"name":"Pledis Entertainment","id":"Q45282","start":"","end":""},{"name":"Hybe","id":"Q16161254","start":"","end":""}],"groups":[{"id":"Q14524548","name":"Seventeen","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/ho5hi_kwon/","spotify":"https://open.spotify.com/artist/6nWKAdMv1BDq1zHfZzkdbR","musicbrainz":"https://musicbrainz.org/artist/09fc39de-ad81-47be-ab4a-2511a585089d"},"photo":null,"bio":{"text":"Kwon Soon-young, known by his stage name Hoshi (호시), is a South Korean singer and dancer. Managed by Pledis Entertainment, he is a member of the South Korean boy band Seventeen, the leader of its performance team and part of its subunits BSS and Hoshi X Woozi. Hoshi made his solo debut with \"Spider\" on April 2, 2021.","title":"Hoshi (South Korean singer)","url":"https://en.wikipedia.org/wiki/Hoshi_%28South_Korean_singer%29"}},"Q26845374":{"id":"Q26845374","name":"Alexandra Reid","ko":"","birthName":"","birthNameEn":"","aliases":["Alexandra Reid Varley","Alex Reid","Alex"],"birth":"1989-03-05","death":"","birthplace":"Kansas City","nationality":["United States"],"height":null,"occupations":["singer","rapper","songwriter","dancer","model"],"debut":"2015","agencies":[{"name":"DR Music","id":"Q17008158","start":"","end":""}],"groups":[{"id":"Q97477974","name":"Blackswan","start":"2015","end":"2017"}],"links":{"instagram":"https://www.instagram.com/thealexreid/","x":"https://x.com/thealexreid","musicbrainz":"https://musicbrainz.org/artist/ee8b067a-2c0c-4518-a014-2d82c3608ffb"},"photo":null,"bio":{"text":"Alexandra Reid Varley, known professionally as Alex Reid or simply Alex, is an American singer and rapper. She is a former member of the South Korean girl group BP Rania, becoming the first African American K-Pop idol in the world.","title":"Alexandra Reid","url":"https://en.wikipedia.org/wiki/Alexandra_Reid"}},"Q276158":{"id":"Q276158","name":"Kwon Yu-ri","ko":"유리","birthName":"권유리","birthNameEn":"","aliases":["Kwon-Yu-ri","Kwon Yu Ri","Kwon Yoori","Kwon Yoo-ri","Kwon Yoo Ri","Yuri","Kwon Yuri"],"birth":"1989-12-05","death":"","birthplace":"Goyang","nationality":["South Korea"],"height":null,"occupations":["actor","singer","film actor","pianist","model","lyricist"],"debut":"2007","agencies":[{"name":"SM Entertainment","id":"Q483938","start":"","end":""}],"groups":[{"id":"Q20153","name":"Girls' Generation","start":"2007","end":""},{"id":"Q56260975","name":"Girls' Generation-Oh!GG","start":"2018","end":""}],"links":{"instagram":"https://www.instagram.com/yulyulk/","youtube":"https://www.youtube.com/channel/UCeUXR_8AOMCji1OEaVne9aQ","musicbrainz":"https://musicbrainz.org/artist/2dbc4ab5-45b5-450c-a85f-4e3a83204b1c"},"photo":null,"bio":{"text":"Kwon Yu-ri, known mononymously as Yuri, is a South Korean singer, actress, and songwriter. She debuted as a member of girl group Girls' Generation (and later its subgroup Girls' Generation-Oh!GG) in August 2007, which went on to become one of the best-selling artists in South Korea and one of South Korea's most widely known girl groups worldwide. Apart from her group's activities, she has acted in several television dramas such as Fashion King (2012), Local Hero (2016), Innocent Defendant (2017), Dae Jang Geum Is Watching (2018), Bossam: Steal the Fate (2021), Good Job (2022) and Parole Examiner Lee (2024). In 2013, she made her film debut in No Breathing.","title":"Kwon Yu-ri","url":"https://en.wikipedia.org/wiki/Kwon_Yu-ri"}},"Q489854":{"id":"Q489854","name":"Kim Hyun-joong","ko":"김현중","birthName":"","birthNameEn":"","aliases":["Kim Hyun Joong"],"birth":"1986-06-06","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor","model","composer"],"debut":"2005","agencies":[{"name":"Universal Music Group","id":"Q38903","start":"","end":""},{"name":"KeyEast","id":"Q11133743","start":"","end":""},{"name":"DSP Media","id":"Q489428","start":"","end":""}],"groups":[{"id":"Q489849","name":"SS501","sta