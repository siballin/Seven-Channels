Han-bin"}},"Q12588824":{"id":"Q12588824","name":"Kim Ji-hyun","ko":"김지현 (가수)","birthName":"","birthNameEn":"","aliases":["Kim Ji Hyun","Kim Ji-hyeon"],"birth":"1972-08-16","death":"","birthplace":"South Korea","nationality":["South Korea"],"height":null,"occupations":["film actor","singer","actor"],"debut":"1994","agencies":[],"groups":[{"id":"Q626245","name":"Roo'ra","start":"","end":""}],"links":{"musicbrainz":"https://musicbrainz.org/artist/ade1d1e7-ff22-4130-81f2-4ab2552a1abd"},"photo":null,"bio":{"text":"Kim Ji-hyun is a South Korean singer and actress. She debuted in 1994 as a member of the best-selling pop group, Roo'ra, which she left in 1997 to release her first solo album, \"Cat's Eye.\" Kim rejoined Roo'ra in 1999, and remained a member until the group disbanded in 2001. She released her second solo album, Second Time, in 2003, and participated in Roo'ra's reunion in 2009.","title":"Kim Ji-hyun (singer)","url":"https://en.wikipedia.org/wiki/Kim_Ji-hyun_%28singer%29"}},"Q12590744":{"id":"Q12590744","name":"Ahn Daniel","ko":"니엘","birthName":"","birthNameEn":"","aliases":["Niel"],"birth":"1994-08-16","death":"","birthplace":"Anyang","nationality":["South Korea"],"height":null,"occupations":["singer","actor","model"],"debut":"2010","agencies":[{"name":"TOP Media","korean":true,"id":"Q11233843","start":"","end":""}],"groups":[{"id":"Q307368","name":"Teen Top","start":"2010","end":""}],"links":{"instagram":"https://www.instagram.com/i_know_niel/","x":"https://x.com/AH_NIEL_","musicbrainz":"https://musicbrainz.org/artist/cb6a71b9-f973-4401-aeef-aeb0ccfcada9"},"photo":null,"bio":{"text":"Ahn Daniel, known professionally as Niel, is a South Korean singer, songwriter and actor. He is a member of the South Korean boy group Teen Top. Niel released his first solo EP titled oNiely on February 16, 2015.","title":"Niel (singer)","url":"https://en.wikipedia.org/wiki/Niel_%28singer%29"}},"Q127424600":{"id":"Q127424600","name":"Riina","ko":"리이나","birthName":"","birthNameEn"