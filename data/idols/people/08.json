levision actor"],"debut":"1998","agencies":[{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"","end":""}],"groups":[],"links":{"x":"https://x.com/sonjichang"},"photo":null,"bio":{"text":"Son Ji-chang is a South Korean actor, singer and songwriter. He starred in television series such as Mudong's House (1991), The Last Match (1994), Trio (2002), and Rose Fence (2003). He is also member of musical duo The Blue.","title":"Son Ji-chang","url":"https://en.wikipedia.org/wiki/Son_Ji-chang"}},"Q12625096":{"id":"Q12625096","name":"Hyun Jin-young","ko":"현진영","birthName":"허현석","birthNameEn":"","aliases":[],"birth":"1971-02-03","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["record producer","composer"],"debut":"1990","agencies":[{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"","end":""}],"groups":[],"links":{"instagram":"https://www.instagram.com/hyun_jinyoung/","x":"https://x.com/hyun_jinyoung","musicbrainz":"https://musicbrainz.org/artist/0ed5c077-0add-4a70-972f-cce587b8509a"},"photo":null,"bio":{"text":"Heo Hyeon-seok, better known by his stage name Hyun Jin-young (현진영), is a South Korean singer and dancer. He is best known for his role in introducing hip-hop music to South Korea. Hyun is known as the first artist to be signed to SM Entertainment, then operating as S.M. Studio, in 1989. In 1995, his contract was completed and he left SM.","title":"Hyun Jin-young","url":"https://en.wikipedia.org/wiki/Hyun_Jin-young"}},"Q132007176":{"id":"Q132007176","name":"Woni","ko":"원이","birthName":"","birthNameEn":"","aliases":["Jeong Woni","Jeong Won-i"],"birth":"2004-05-25","death":"","birthplace":"","nationality":["South Korea"],"height":null,"occupations":["pop singer"],"debut":"","agencies":[],"groups":[{"id":"Q124856415","name":"Rescene","start":"2024","end":""}],"links":{"musicbrainz":"https://musicbrainz.org/artist/f53cc379-8fca-42b0-b5b6-0e52825c745a"},"photo":{"url":"https://upload.wikimedia.org/wikip