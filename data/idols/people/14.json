ame":"","birthNameEn":"","aliases":["Seunghoon","Hoon","Hoony","Seung Hoon"],"birth":"1992-01-11","death":"","birthplace":"Busan","nationality":["South Korea"],"height":null,"occupations":["rapper","dancer","singer","songwriter"],"debut":"2014","agencies":[{"name":"YG Entertainment","korean":true,"id":"Q50595","start":"","end":""}],"groups":[{"id":"Q15116397","name":"Winner","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/maetamong/","x":"https://x.com/official_hoony_","youtube":"https://www.youtube.com/channel/UCmxDK1eWo-KvQQJ23p95XGw","musicbrainz":"https://musicbrainz.org/artist/b26207f7-9bd0-4e54-8af6-0780230db5d7"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/d/d0/14.11.13_%EC%9D%B4%EC%8A%B9%ED%9B%88.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:14.11.13_%EC%9D%B4%EC%8A%B9%ED%9B%88.jpg","author":"안쓰","license":"CC BY 4.0"},"bio":{"text":"Lee Seung-hoon, also known by the mononym Hoony, is a South Korean rapper and dancer. His musical career began in 2011 as a contestant in the first installation of K-pop Star (2011–2012); where he caught the attention of YG Entertainment CEO Yang Hyun-suk and was signed under his agency. Lee debuted with Winner on August 17, 2014, after the band competed and were titled as the victors of WIN: Who is Next (2013), and as a soloist on July 15, 2024.","title":"Lee Seung-hoon (rapper)","url":"https://en.wikipedia.org/wiki/Lee_Seung-hoon_%28rapper%29"}},"Q16177614":{"id":"Q16177614","name":"Yeonji","ko":"연지","birthName":"","birthNameEn":"","aliases":["Yeon Ji-eun"],"birth":"1993-08-25","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["race queen","singer","model"],"debut":"","agencies":[],"groups":[{"id":"Q97656993","name":"Pocket Girls","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/jji.eun/"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/3/3e/Yeon_Ji-eun_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Yeon_Ji-eun_(cropped).jpg","author":"eun2c","license":"CC BY 4.0"},"bio":null},"Q16183118":{"id":"Q16183118","name":"Ji In","ko":"지인","birthName":"이지인","birthNameEn":"","aliases":["Lee Ji In","Jiin","Lee Jiin"],"birth":"1992-03-13","death":"","birthplace":"Chuncheon","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q497325","name":"Girl's Day","start":"2010","end":"2010"}],"links":{"musicbrainz":"https://musicbrainz.org/artist/80e67a83-b995-459f-8976-93e97dd793dd"},"photo":null,"bio":null},"Q20514446":{"id":"Q20514446","name":"RM","ko":"김남준","birthName":"김남준","birthNameEn":"","aliases":["Kim Nam-joon","Rap Monster","Real Me"],"birth":"1994-09-12","death":"","birthplace":"Goyang","nationality":["South Korea"],"height":181,"occupations":["rapper","record producer","songwriter","musician","singer"],"debut":"2013","agencies":[{"name":"Big Hit Music","korean":true,"id":"Q106296918","start":"","end":""}],"groups":[{"id":"Q13580495","name":"BTS","start":"","end":""}],"links":{"website":"https://ibighit.com/bts/eng/discography/rm/","instagram":"https://www.instagram.com/rkive/","spotify":"https://open.spotify.com/artist/2auC28zjQyVTsiZKNgPRGs","musicbrainz":"https://musicbrainz.org/artist/58f1e354-ecbc-4fd3-aa25-97eb1d9bd8b9"},"photo":null,"bio":{"text":"Kim Nam-joon, known professionally as RM (formerly Rap Monster), is a South Korean rapper, songwriter, and record producer. He is the leader of South Korean boy band BTS, under Big Hit Music. Born in Seoul and raised in Ilsan, RM began his music career in the underground Korean hip-hop scene as a teenager, going by the name Runch Randa. He joined Big Hit in 2010, and debuted as part of BTS in June 2013. RM released his first solo mixtape, RM, in 2015, followed by his second mixtape, Mono, in 2018. The latter became the highest-charting album by a Korean solo artist in the United States in history when it peaked at number 26 on the Billboard 200.","title":"RM (musician)","url":"https://en.wikipedia.org/wiki/RM_%28musician%29"},"positions":["Leader","Main rapper"],"mbti":"INFJ","factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/RM"},"mbti":{"name":"Kpop Wiki","license":"CC BY-SA","licenseUrl":"https://www.fandom.com/licensing","base":"https://kpop.fandom.com/wiki/","url":"https://kpop.fandom.com/wiki/RM"}}},"Q21060878":{"id":"Q21060878","name":"Hwang Chi-yeul","ko":"황치열","birthName":"","birthNameEn":"","aliases":["Hwang Chiyeul"],"birth":"1982-12-03","death":"","birthplace":"Gumi","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2007","agencies":[],"groups":[],"links":{"instagram":"https://www.instagram.com/chiyeul7102/","x":"https://x.com/ten7102","tiktok":"https://www.tiktok.com/@hcy7102","musicbrainz":"https://musicbrainz.org/artist/0aba1766-b59a-4461-b7be-89050fef3ec7"},"photo":null,"bio":{"text":"Hwang Chiyeul is a South Korean singer. Outside his career as a solo artist, he has also hosted Immortal Songs 2 and competed in the Chinese version of singing competition show I Am a Singer. He made his official debut in 2007, releasing a digital single album, Chi Yeul (치열) and a full-length studio album, Five Senses (오감). In March 2015, he appeared on I Can See Your Voice on Mnet Korea. His success on the show became the turning point in his life, and since then he has appeared on other TV shows such as Immortal Songs: Singing the Legend, Radio Star, I Live Alone, Knowing Bros, Happy Together. Hunan TV in China invited him to participate in I Am a Singer (season 4).","title":"Hwang Chi-yeul","url":"https://en.wikipedia.org/wiki/Hwang_Chi-yeul"}},"Q22773838":{"id":"Q22773838","name":"Kim Da-hyun","ko":"다현","birthName":"김다현","birthNameEn":"","aliases":["Dubu tofu","Dahyun"],"birth":"1998-05-28","death":"","birthplace":"Seongnam","nationality":["South Korea"],"height":null,"occupations":["singer","dancer","rapper","actor"],"debut":"2015","agencies":[{"name":"JYP Entertainment","korean":true,"id":"Q483238","start":"","end":""}],"groups":[{"id":"Q20645861","name":"Twice","start":"2015","end":""}],"links":{"instagram":"https://www.instagram.com/dahhyunnee/","musicbrainz":"https://musicbrainz.org/artist/9a17b57a-cbcd-45c5-ae60-15d65fc3b6df"},"photo":null,"bio":{"text":"Kim Da-hyun, known mononymously as Dahyun, is a South Korean singer, rapper, and actress. She is a member of the South Korean girl group Twice, formed by JYP Entertainment in 2015. Dahyun made her acting debut in 2025 with the film You Are the Apple of My Eye, where she received several Best New Actress awards. She later appeared in the independent film Run to You (2025) and in the television series Love Me (2025–2026).","title":"Dahyun","url":"https://en.wikipedia.org/wiki/Dahyun"},"positions":["Lead rapper","Sub vocalist"],"mbti":"ISFJ","factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EB%8B%A4%ED%98%84%28TWICE%29"},"mbti":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EB%8B%A4%ED%98%84%28TWICE%29"}}},"Q3228878":{"id":"Q3228878","name":"Hoya","ko":"이호원","birthName":"","birthNameEn":"","aliases":["Lee Ho-dong","Ho Won Lee","Lee Ho-won"],"birth":"1991-03-28","death":"","birthplace":"Busan","nationality":["South Korea"],"height":null,"occupations":["singer","actor","film actor","television actor"],"debut":"2010","agencies":[{"name":"Woollim Entertainment","korean":true,"id":"Q50596","start":"","end":""}],"groups":[{"id":"Q50598","name":"INFINITE","start":"2010","end":"2017"}],"links":{"instagram":"https://www.instagram.com/isayhousayya/","x":"https://x.com/hoya1991","musicbrainz":"https://musicbrainz.org/artist/36748b37-9390-4a1e-85e4-665b57248f80"},"photo":null,"bio":{"text":"Lee Ho-won (Korean: 이호원; born Lee Ho-dong on (1991-03-28)March 28, 1991), known professionally as Hoya, is a South Korean singer, rapper, songwriter, actor, and dancer, currently a member of the dance crew Mbitious. He is known to have been a rapper and vocalist in boy band Infinite (and later its sub-group Infinite H) from 2010 until his departure from Woollim Entertainment in 2017. In 2018, Hoya made his solo debut on March 28 with his first EP Shower. Hoya made his acting debut in the drama Reply 1997 (2012) and went on to star in the dramas My Lovely Girl (2014), Mask (2015), Radiant Office (2017), and Two Cops (2017), Devilish Charm (2018).","title":"Hoya (singer)","url":"https://en.wikipedia.org/wiki/Hoya_%28singer%29"}},"Q4798670":{"id":"Q4798670","name":"Oh Ha-young","ko":"오하영","birthName":"","birthNameEn":"","aliases":["Hayoung"],"birth":"1996-07-19","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","dancer","actor","model","composer"],"debut":"2011","agencies":[{"name":"IST Entertainment","korean":true,"id":"Q21554828","start":"","end":""}],"groups":[{"id":"Q483286","name":"Apink","start":"2011","end":""}],"links":{"instagram":"https://www.instagram.com/_ohhayoung_/","x":"https://x.com/apinkohy","youtube":"https://www.youtube.com/channel/UCnPJ_Jcl-dwFuGgqhavB8oA","musicbrainz":"https://musicbrainz.org/artist/f22b53eb-2dc7-49d5-b300-f9893a982e30"},"photo":null,"bio":{"text":"Oh Ha-young, also known by her mononym Hayoung, is a South Korean singer and actress. She is best known as a member of the South Korean girl group Apink.","title":"Oh Ha-young","url":"https://en.wikipe