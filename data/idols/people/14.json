ivecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EC%A0%84%EC%A7%84%28%EC%8B%A0%ED%99%94%29"}}},"Q490062":{"id":"Q490062","name":"Park Ji-yoon","ko":"박지윤","birthName":"","birthNameEn":"","aliases":["Park Ji Yoon","Park Jiyoon","Ji Yoon Park","Park Ji-yun","Park Jiyun"],"birth":"1982-01-03","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor","model"],"debut":"1994","agencies":[{"name":"Kakao M","korean":true,"id":"Q625975","start":"","end":""}],"groups":[],"links":{"instagram":"https://www.instagram.com/parkjiyoon_creative/","x":"https://x.com/Raellepark","youtube":"https://www.youtube.com/channel/UCo5N9R8-srgbz2z1SI_ro9g","spotify":"https://open.spotify.com/artist/7qmEHoSlJwxM2buGDF7LiO","musicbrainz":"https://musicbrainz.org/artist/753159e8-82b6-4dc9-9ecc-454660fc59b3"},"photo":null,"bio":{"text":"Park Ji-yoon is a South Korean singer, actress, and model. As a teen model, she gained wide exposure after starring in a Haitai biscuit commercial in 1994, and held a minor role in the television drama Dinosaur Teacher that same year. Her debut studio album, Skyblue Dream, was released in 1997. Park's early career under Taewon Entertainment saw the hit singles \"Skyblue Dream\", \"Steal Away\", \"Precious Love\" and \"Don't Know Anything\", and she was associated with a charming and fresh image. In 2000, Park signed with JYP Entertainment and released her fourth album, Coming-of-Age Ceremony.","title":"Park Ji-yoon","url":"https://en.wikipedia.org/wiki/Park_Ji-yoon"}},"Q491278":{"id":"Q491278","name":"Narsha","ko":"나르샤","birthName":"Park Hyo-jin","birthNameEn":"Park Hyo-jin","aliases":["Park Hyo-jin"],"birth":"1981-12-28","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2006","agencies":[],"groups":[{"id":"Q483253","name":"Brown Eyed Girls","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/narsha81/","x":"https://x.com/Hjnarsha","youtube":"https://www.youtube.com/channel/UC_tzz4dbs-OxjdrxxSRU45A","spotify":"https://open.spotify.com/artist/1OWVHV30ai3o8cgOTBVd72","musicbrainz":"https://musicbrainz.org/artist/89709ded-584c-4e90-8efc-74b10931eaf9"},"photo":null,"bio":{"text":"Park Hyo-jin, better known by her stage name Narsha, is a South Korean singer and actress. She is best known as a member of the South Korean girl group Brown Eyed Girls. Her stage name, Narsha, is derived from the term na-reu-sha, which means 'to fly up' in Middle Korean and was given to her by a former manager.","title":"Narsha","url":"https://en.wikipedia.org/wiki/Narsha"},"positions":["Lead vocalist"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EB%82%98%EB%A5%B4%EC%83%A4%28%EB%B8%8C%EB%9D%BC%EC%9A%B4_%EC%95%84%EC%9D%B4%EB%93%9C_%EA%B1%B8%EC%8A%A4%29"}}},"Q494222":{"id":"Q494222","name":"Lee Sungmin","ko":"성민","birthName":"이성민","birthNameEn":"","aliases":["Sungmin","Lee Seong-min","Seongmin","Lee Seongmin","Lee Sung-min"],"birth":"1986-01-01","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","film actor","actor","pianist","songwriter","television actor"],"debut":"2005","agencies":[{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"","end":""}],"groups":[{"id":"Q239693","name":"Super Junior","start":"2005","end":""},{"id":"Q700431","name":"Super Junior-Happy","start":"","end":""},{"id":"Q706116","name":"Super Junior-M","start":"","end":""},{"id":"Q2625142","name":"Super Junior-T","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/imsmlreal/","x":"https://x.com/imsml","youtube":"https://www.youtube.com/channel/UCTeRKMWHccQeaSU6xpM9mmw","musicbrainz":"https://musicbrainz.org/artist/20b7e783-acf7-4a7b-9fb3-6e207166e96d"},"p