ord producer","recording artist"],"debut":"2010","agencies":[],"groups":[],"links":{"instagram":"https://www.instagram.com/ryansjhun/","x":"https://x.com/ryanjhun","musicbrainz":"https://musicbrainz.org/artist/78a8d998-b910-4176-9135-3d465a35eb3f"},"photo":null,"bio":{"text":"Ryan S. Jhun is a South Korean songwriter and record producer. Jhun is known for his work with various K-pop soloists and idol groups, getting his start through acts from SM Entertainment such as Shinee, Super Junior, f(x), Taeyeon, Exo, NCT, and TVXQ. He has since produced for several artists from other labels like IU, Loona, Lee Hyo-ri, U-KISS, Girl's Day, Twice, NMIXX, Oh My Girl, Monsta X, Ive, BAE173, and Cravity, as well as songs for audition programs Produce 101 and My Teenage Girl. He founded and became chief executive officer of music production and publishing company Marcan Entertainment.","title":"Ryan S. Jhun","url":"https://en.wikipedia.org/wiki/Ryan_S._Jhun"}},"Q24857942":{"id":"Q24857942","name":"Kim Yu-min","ko":"김유민","birthName":"","birthNameEn":"","aliases":["Yumin"],"birth":"1994-04-22","death":"","birthplace":"Osan","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q491708","name":"RANIA","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/dbals5670/","youtube":"https://www.youtube.com/channel/UC9AHQK0--kpdTF65ct2ivEg"},"photo":null,"bio":null},"Q28530070":{"id":"Q28530070","name":"Lee Geon","ko":"이우","birthName":"","birthNameEn":"","aliases":[],"birth":"1992-05-04","death":"","birthplace":"","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q18712427","name":"Madtown","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/lee_wooooo_92/","x":"https://x.com/LEEWOO_OFFICIAL","youtube":"https://www.youtube.com/channel/UCEwzWW4lx7R7WGygVvcAaOg"},"photo":null,"bio":{"text":"Madtown, often stylized as MADTOWN, was a South Korean boy band formed in 2014 by J. Tune Camp. The group consisted of Moos, Daewon, Lee Geon, Jota, Heo Jun, Buffy and H.O. Their debut album, Mad Town, was released on October 6, 2014. Two of the members, Moos and Buffy, originally debuted as the hip hop duo Pro C in 2013. Madtown's official fan-base name is Mad-people. Starting December 22, 2016, Madtown's contract was sold to GNI Entertainment after J. Tune Camp closed. On The Unit, Daewon and Lee Geon confirmed Madtown's disbandment.","title":"Lee Geon","url":"https://en.wikipedia.org/wiki/Lee_Geon"}},"Q28549782":{"id":"Q28549782","name":"I.M","ko":"아이엠","birthName":"임창균","birthNameEn":"","aliases":["Im Changkyun"],"birth":"1996-01-26","death":"","birthplace":"Suwon","nationality":["South Korea"],"height":null,"occupations":["singer","rapper","dancer"],"debut":"2015","agencies":[{"name":"Starship Entertainment","id":"Q255363","start":"","end":""}],"groups":[{"id":"Q19855151","name":"Monsta X","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/imnameim/","musicbrainz":"https://musicbrainz.org/artist/e32e7d66-3d1f-4f8a-b339-90c02ebfe465"},"photo":null,"bio":{"text":"Im Chang-kyun, known by the stage name I.M or mononymously as Changkyun, is a South Korean rapper, singer, songwriter, and producer. He is a member of the South Korean boy group Monsta X under Starship Entertainment. He made his solo debut with the EP Duality in 2021.","title":"I.M","url":"https://en.wikipedia.org/wiki/I.M"}},"Q28870934":{"id":"Q28870934","name":"Kim Na-hyun","ko":"나현","birthName":"김나현","birthNameEn":"","aliases":["Nahyun"],"birth":"1995-12-09","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q18651163","name":"Sonamoo","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/kimxnahyun/","x":"https://x.com/SONAMOO_Nahyun","musicbrainz":"https://musicbrainz.org/artist/3b0a4a1e-f34e-459b-9f10-7d0dec27f521"},"photo":null,"bio":null},"Q30311766":{"id":"Q30311766","name":"Yoon Ji-sung","ko":"윤지성","birthName":"","birthNameEn":"","aliases":["Yoon Ji-seong","Yun Ji-seong","Yun Ji-sung"],"birth":"1991-03-08","death":"","birthplace":"Wonju","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2017","agencies":[],"groups":[{"id":"Q30311578","name":"Wanna One","start":"2017","end":"2019"}],"links":{"instagram":"https://www.instagram.com/_yoonj1sung_/","x":"https://x.com/Official_YJS_","youtube":"https://www.youtube.com/channel/UC0toF0jpYJUgS7jAgCNCVNw","musicbrainz":"https://musicbrainz.org/artist/0fc94bbf-d10e-4b43-96ac-6a992b781d7a"},"photo":null,"bio":{"text":"Yoon Ji-sung is a South Korean singer and actor. He is best known for finishing eighth in the second series of Produce 101 and is the former leader of South Korean boy group Wanna One. Following Wanna One's disbandment, Yoon established his career as a solo artist with the release of his first extended play Aside on February 20, 2019.","title":"Yoon Ji-sung","url":"https://en.wikipedia.org/wiki/Yoon_Ji-sung"}},"Q30951190":{"id":"Q30951190","name":"Ahn Hyeong-seop","ko":"안형섭","birthName":"안형섭","birthNameEn":"","aliases":["Hyeongseop","Ahn Hyeongseop"],"birth":"1999-08-09","death":"","birthplace":"Yongin","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q110920753","name":"Tempest","start":"","end":""},{"id":"Q44176608","name":"Hyeongseop X Euiwoong","start":"","end":""}],"links":{},"photo":null,"bio":null},"Q42907478":{"id":"Q42907478","name":"Li Wenhan","ko":"리원한","birthName":"","birthNameEn":"","aliases":[],"birth":"1994-07-22","death":"","birthplace":"Hangzhou","nationality":["People's Republic of China"],"height":null,"occupations":["singer","actor","model"],"debut":"2014","agencies":[{"name":"Yuehua Entertainment","id":"Q18390500","start":"","end":""}],"groups":[{"id":"Q18712416","name":"Uniq","start":"","end":""}],"links":{"instag