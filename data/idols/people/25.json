name":"I.B.I","start":"2016","end":"2017"},{"id":"Q25803678","name":"C.I.V.A","start":"2016","end":"2016"},{"id":"Q56501962","name":"Nature","start":"2019","end":"2024"}],"links":{"instagram":"https://www.instagram.com/soh_eee/","youtube":"https://www.youtube.com/channel/UCZcYD8z6kx9rStKlTRz8EaQ","spotify":"https://open.spotify.com/artist/3Tu9nOmJPyDU0iMigimme3","musicbrainz":"https://musicbrainz.org/artist/3b626bb0-c767-4227-8a41-f11e9b478985"},"photo":null,"bio":{"text":"Kim So-hee is a South Korean singer. She is known for having been a member of girl group Nature, a contestant of the first season of Produce 101 and a member of the project girl group I.B.I. Kim debuted as a soloist on November 8, 2017, with the EP The Fillette. After a two-year hiatus, Kim left Music Works and joined n.Ch Entertainment in July 2019.","title":"Kim So-hee (singer, born 1995)","url":"https://en.wikipedia.org/wiki/Kim_So-hee_%28singer%2C_born_1995%29"}},"Q26710937":{"id":"Q26710937","name":"Lee Hae-in","ko":"이해인","birthName":"","birthNameEn":"","aliases":["Lee Haein","Lee Hae In"],"birth":"1994-07-04","death":"","birthplace":"Masan","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2016","agencies":[],"groups":[{"id":"Q26425385","name":"I.B.I","start":"2016","end":"2017"}],"links":{"instagram":"https://www.instagram.com/s2onlyone1/","youtube":"https://www.youtube.com/channel/UCqjIRxC4lEAO_LjrKshThnA","musicbrainz":"https://musicbrainz.org/artist/201f7f11-e874-4033-bc7e-84a4c6e296c0"},"photo":null,"bio":{"text":"Lee Hae-in is a South Korean creative director, singer, lyricist and actress. She is a former member of the project group I.B.I. She debuted as a soloist on November 17, 2020 with the release of \"Santa Lullaby (We Used To Sing)\". She is also known for being a former contestant on the reality survival shows Produce 101 and Idol School. She was the creative director of the girl group Kiss of Life. In December 2024, she signed a contract with DOD and will manage the group, Close Your Eyes.","title":"Lee Hae-in (singer)","url":"https://en.wikipedia.org/wiki/Lee_Hae-in_%28singer%29"}},"Q27477017":{"id":"Q27477017","name":"Park Ji-sung","ko":"박지성","birthName":"","birthNameEn":"","aliases":["Jisung"],"birth":"2002-02-05","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["rapper","singer","dancer"],"debut":"2016","agencies":[{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"","end":""}],"groups":[{"id":"Q23725822","name":"NCT","start":"","end":""},{"id":"Q67972645","name":"NCT U","start":"","end":""},{"id":"Q47002841","name":"NCT Dream","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/the__and.y/"},"photo":null,"bio":{"text":"Park Ji-sung, known mononymously as Jisung is a South Korean singer, rapper, dancer, and actor. He rose to prominence as a member of the K-pop boy band NCT and its sub-unit NCT Dream. Born in Seoul, Jisung began his career as a child actor and dancer. In 2013, he started training under SM Entertainment and joined the label's official team of trainees, SM Rookies, appearing on television and touring both in South Korea and abroad. He made his debut in 2016 with NCT, which went on to achieve commercial success and become an influential K-pop act. Beyond his music career, Jisung has appeared on variety shows and television series such as Crash (2024–2026).","title":"Jisung","url":"https://en.wikipedia.org/wiki/Jisung"}},"Q47672793":{"id":"Q47672793","name":"Kanto","ko":"칸토","birthName":"Choi Kwang-ryul","birthNameEn":"Choi Kwang-ryul","aliases":["Choi Kwang-ryul"],"birth":"1994-05-23","death":"","birthplace":"Gyeonggi Province","nationality":["South Korea"],"height":null,"occupations":["singer","rapper"],"debut":"2013","agencies":[{"name":"Brand New Music","korean":true,"id":"Q12599305","start":"","end":""}],"groups":[{"id":"Q48700650","name":"Troy","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/choikanto/","x":"https://x.com/kanto94","spotify":"https://open.spotify.com/artist/1Pr77yszl1ikj6k9sy4Cju","musicbrainz":"https://musicbrainz.org/artist/86a196e3-4799-464e-85b8-2a59b60203e1"},"photo":null,"bio":{"text":"Choi Kwang-ryul, known by the stage name Kanto (칸토), is a South Korean rapper and composer. He debuted as a soloist with his debut single, What You Want, on October 25, 2013. He later debuted as a member of South Korean hip hop and R&B quartet Troy in September 2014. He released his first EP, 14216, on September 27, 2016.","title":"Kanto (rapper)","url":"https://en.wikipedia.org/wiki/Kanto_%28rapper%29"}},"Q483161":{"id":"Q483161","name":"Eunhyuk","ko":"은혁","birthName":"이혁재","birthNameEn":"","aliases":[],"birth":"1986-04-04","death":"","birthplace":"Ilsan-gu","nationality":["South Korea"],"height":null,"occupations":["actor","singer","songwriter","rapper"],"debut":"2005","agencies":[{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"","end":""}],"groups":[{"id":"Q239693","name":"Super Junior","start":"2005","end":""},{"id":"Q2625142","name":"Super Junior-T","start":"","end":""},{"id":"Q700431","name":"Super Junior-Happy","start":"","end":""},{"id":"Q706116","name":"Super Junior-M","start":"","end":""},{"id":"Q7335169","name":"Super Junior Donghae & Eunhyuk","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/be4eunhyuk/","x":"https://x.com/AllRiseSilver","youtube":"https://www.youtube.com/channel/UCZg4Hm6gXBmlVoZwVJg0ykQ","spotify":"https://open.spotify.com/artist/4QRqp8zf5JtqaMk2OOU3NX","musicbrainz":"https://musicbrainz.org/artist/29a9f34b-a39a-49a6-885a-723bda36c14e"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/8/8f/WHYNOT-%EB%8D%94_%EB%8C%84%EC%84%9C_%EC%A0%9C%EC%9E%91%EB%B0%9C%ED%91%9C%ED%9A%8C_%EC%9D%80%ED%98%81.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:WHYNOT-%EB%8D%94_%EB%8C%84%EC%84%9C_%EC%A0%9C%EC%9E%91%EB%B0%9C%ED%91%9C%ED%9A%8C_%EC%9D%80%ED%98%81.jpg","author":"dispatchsns","license":"CC BY 3.0"},"bio":{"text":"Lee Hyuk-jae, known professionally as Eunhyuk, is a South Korean singer, songwriter, rapper, dancer, and television host. He is a member of the South Korean boy group Super Junior and its subgroups Super Junior-T and Super Junior-H. In 2011, he joined Super Junior's Mandopop subgroup Super Junior-M and the duo Super Junior-D&E, active in China and Japan respectively. Gaining attention as the main dancer of Super Junior, he branched out with solo activities beginning as radio host through Super Junior's Kiss the Radio (2006–2011).","title":"Eunhyuk","url":"https://en.wikipedia.org/wiki/Eunhyuk"}},"Q487897":{"id":"Q487897","name":"Qri","ko":"큐리","birthName":"Lee Ji-hyun","birthNameEn":"Lee Ji-hyun","aliases":["Qri Lee"],"birth":"1986-12-12","death":"","birthplace":"Goyang","nationality":["South Korea"],"height":null,"occupations":["singer","actor","model"],"debut":"2009","agencies":[{"name":"MBK Entertainment","korean":true,"id":"Q429296","start":"","end":""}],"groups":[{"id":"Q495383","name":"T-ara","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/qtfreet/","x":"https://x.com/QriPretty","musicbrainz":"https://musicbrainz.org/artist/efc39620-b31e-4a51-bf6e-3c7247277509"},"photo":null,"bio":{"text":"Lee Ji-hyun, known professionally as Qri (큐리), is a South Korean singer, actress, model and fashion designer. She debuted as a member of girl group T-ara in July 2009. Since 2009, Qri has been active in the entertainment industry from acting and variety shows to music to modeling. Her most notable works include her supporting role in hit drama Queen Seondeok, which received near-universal acclaim, winning over 20 awards and solidifying Qri's career in the field. Qri showed high interest in fashion design in 2018 and ended up designing several commercial products. Qri launched her self-produced jewelry brand \"Qriel\" in 2021.","title":"Qri","url":"https://en.wikipedia.org/wiki/Qri"}},"Q492313":{"id":"Q492313","name":"Park Jin-young","ko":"박진영","birthName":"박진영","birthNameEn":"","aliases":["Junior","Park Jin-Young","JinYoung","Park Jin-yeong"],"birth":"1994-09-22","death":"","birthplace":"Changwon","nationality":["South Korea"],"height":null,"occupations":["singer","actor","television actor","dancer","songwriter","composer"],"debut":"2012","agencies":[],"groups":[{"id":"Q496694","name":"JJ Project","start":"2012","end":""},{"id":"Q23772001","name":"Got7","start":"2014","end":""}],"links":{"website":"https://jinyoung0922.jp","instagram":"https://www.instagram.com/jinyoung_0922jy/","x":"https://x.com/JINYOUNG","spotify":"https://open.spotify.com/artist/0cA67OQaC4zDkxvGmWqKu7","musicbrainz":"https://musicbrainz.org/artist/77cb0d7a-c6b9-4cf2-a36c-34b1246b9ea3"},"photo":null,"bio":{"text":"Park Jin-young, known mononymously as Jinyoung, and formerly as Jr. and Junior, is a South Korean singer, actor, and songwriter. He is a member of the South Korean boy band Got7 and duo JJ Project. As an actor, he gained recognition for his roles in the television series The Devil Judge (2021), Yumi's Cells (2021–2022), and Our Unwritten Seoul (2025), for which he received a Best Actor nomination at the 62nd Baeksang Arts Awards. He has also starred in the films Christmas Carol (2022) and Hi-Five (2025). He won the Best New Actor award at the 59th Baeksang Arts Awards for Christmas Carol and received a Best New Actor nomination at the 46th Blue Dragon Film Awards for Hi-Five.","title":"Park Jin-young","url":"https://en.wikipedia.org/wiki/Park_Jin-young"}},"Q495577":{"id":"Q495577","name":"G-Dragon","ko":"지드래곤","birthName":"권지용","birthNameEn":"","aliases":["Kwon Ji-yong","GD of Big Bang","GD"],"birth":"1988-08-18","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","model","songwriter","record producer","rapper","entrepreneur"],"debut":"2006","agencies":[{"name":"YG Entertainment","korean":true,"id":"Q50595","start":"","end":"2023"}],"groups":[{"id":"Q282104","name":"BigBang","start":"","end":""},{"id":"Q21575485","name":"GD&TOP","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/xxxibgdrgn/","x":"https://x.com/IBGDRGN","youtube":"https://www.youtube.com/channel/UCeU5qTuBiqTU5z-hyL6WITQ","spotify":"https://open.spotify.com/artist/30b9WulBM8sFuBo17nNq9c","musicbrainz":"https://musicbrainz.org/artist/b4f66d7f-3282-404e-a682-97374d63b5ab"},"photo":null,"bio":{"text":"Kwon Ji-yong, best known as G-Dragon (지드래곤), is a South Korean rapper, singer, songwriter, and entrepreneur. Dubbed the \"King of K-pop\", he rose to prominence as the leader of the South Korean boy band BigBang, which went on to become one of the best-selling boy bands in the world. Born in Seoul, he made his public debut at age six as part of the musical group Little Roo'ra. In 2009, he released his first solo studio album Heartbreaker; the album and its title track of the same name were commercially successful, becoming the best-selling album by a Korean soloist at the time and earning him Album of the Year at the 2009 Mnet Asian Music Awards.","title":"G-Dragon","url":"https://en.wikipedia.org/wiki/G-Dragon"}},"Q498905":{"id":"Q498905","name":"Kang Sung Hun","ko":"강성훈","birthName":"","birthNameEn":"","aliases":["Kang Sung Hoon","Kang Sung-hoon"],"birth":"1980-02-22","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"1997","agencies":[{"name":"YG Entertainment","korean":true,"id":"Q50595","start":"2016","end":"2019"},{"name":"DSP Media","korean":true,"id":"Q489428","start":"1997","end":"2000"}],"groups":[{"id":"Q626900","name":"Sechs Kies","start":"1997","end":"2019"}],"links":{"instagram":"https://www.instagram.com/kang.s.h.0222/","youtube":"https://www.youtube.com/channel/UCU4bsS3GZGLu3sofEks2P9w","musicbrainz":"https://musicbrainz.org/artist/b2e887af-992b-4395-ad23-b54826cce6be"},"photo":null,"bio":{"text":"Kang Sung-hoon is a South Korean singer, best known as a former member of the 90s South Korean boy group Sechs Kies. While in Sechskies, Kang was the main vocalist. After SechsKies had disbanded in 2000, Kang pursued a solo singing career, signed under Laful Entertainment at the time. His nickname Hoony is the title for his third album. Kang joined Sechskies for their reunion in 2016, but left the group in early 2019 due to ongoing scandals.","title":"Kang Sung-hoon (singer)","url":"https://en.wikipedia.org/wiki/Kang_Sung-hoon_%28singer%29"}},"Q60874713":{"id":"Q60874713","name":"Mao Hirokawa","ko":"히로카와 마오","birthName":"","birthNameEn":"","aliases":["May","Hirokawa Mao"],"birth":"2004-11-16","death":"","birthplace":"Tokyo","nationality":["Japan"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q59325270","name":"Cherry Bullet","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/cherrybullet/","youtube":"https://www.youtube.com/channel/UCMj-rf97DfMsZ6LbPa8Eoww"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/a/a1/190604_%EC%B2%B4%EB%A6%AC%EB%B8%94%EB%A0%9B_%EB%A9%94%EC%9D%B4_%282%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:190604_%EC%B2%B4%EB%A6%AC%EB%B8%94%EB%A0%9B_%EB%A9%94%EC%9D%B4_(2).jpg","author":"NINE STARS","license":"CC BY 3.0"},"bio":null},"Q61863833":{"id":"Q61863833","name":"Q","ko":"큐","birthName":"지창민","birthNameEn":"","aliases":["Ji Chang-min"],"birth":"1998-11-05","death":"","birthplace":"Paju","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q41949104","name":"The Boyz","start":"","end":""}],"links":{},"photo":null,"bio":null},"Q63226265":{"id":"Q63226265","name":"Choi Moon-ju","ko":"최문주","birthName":"","birthNameEn":"","aliases":["Gaeul","Choi Mun-ju"],"birth":"1998-08-12","death":"","birthplace":"S