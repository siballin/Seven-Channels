name":"Kim Gun-mo","ko":"김건모","birthName":"","birthNameEn":"","aliases":["Kim Gun Mo"],"birth":"1968-01-13","death":"","birthplace":"Busan","nationality":["South Korea"],"height":null,"occupations":["singer","jazz musician","pianist","songwriter","record producer"],"debut":"1992","agencies":[],"groups":[],"links":{"musicbrainz":"https://musicbrainz.org/artist/a922eba6-5e85-40f6-b8f3-43ba3134b363"},"photo":null,"bio":{"text":"Kim Gun-mo is a South Korean singer-songwriter who is considered the country's most successful musical artist of the 1990s. His 1995 album, Wrongful Meeting, previously held the Guinness World Record for the best-selling album of all time in South Korea. Since his debut in 1992, Kim has released 13 full-length albums and has won numerous awards, including Album of the Year at the Golden Disc Awards for three consecutive years from 1994 to 1996. In 2011, he received a presidential commendation from the South Korean government for his contributions to popular culture.","title":"Kim Gun-mo","url":"https://en.wikipedia.org/wiki/Kim_Gun-mo"}},"Q483638":{"id":"Q483638","name":"Park Ye-eun","ko":"예은","birthName":"박예은","birthNameEn":"","aliases":["Yeeun","Ha:tfelt","Yanny"],"birth":"1989-05-26","death":"","birthplace":"Goyang","nationality":["South Korea"],"height":null,"occupations":["singer","pianist","model","composer"],"debut":"2007","agencies":[{"name":"JYP Entertainment","korean":true,"id":"Q483238","start":"","end":""}],"groups":[{"id":"Q476119","name":"Wonder Girls","start":"2007","end":"2017"}],"links":{"instagram":"https://www.instagram.com/hatfelt/","x":"https://x.com/hatfelt_staff","youtube":"https://www.youtube.com/channel/UC7vPYWJfBGTd8ccq6h3Vgmg","musicbrainz":"https://musicbrainz.org/artist/1ce2f8fb-8a38-491f-ac6a-658828cb4dec"},"photo":null,"bio":{"text":"Park Ye-eun, professionally known as Yeeun, Yenny, or Ha:tfelt (핫펠트), is a South Korean singer, songwriter and composer known for her work as a former member of South Korean girl group Wonder Girls. In July 2014, she made her debut as solo artist under the name Ha:tfelt with released her solo EP Me?. In early 2017, Wonder Girls officially disbanded due to contract expiration. Following the disbandment, Yeeun signed with Amoeba Culture to continue her career as solo artist.","title":"Park Ye-eun","url":"https://en.wikipedia.org/wiki/Park_Ye-eun"},"positions":["Main vocalist"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%ED%95%AB%ED%8E%A0%ED%8A%B8"}}},"Q485174":{"id":"Q485174","name":"Lee Hyun","ko":"이현","birthName":"","birthNameEn":"","aliases":["Midnatt"],"birth":"1983-11-08","death":"","birthplace":"Gwangju","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2007","agencies":[{"name":"Big Hit Music","korean":true,"id":"Q106296918","start":"","end":""},{"name":"Source Music","korean":true,"id":"Q21709935","start":"","end":""}],"groups":[],"links":{"x":"https://x.com/thehyun11","musicbrainz":"https://musicbrainz.org/artist/ff9b50b2-730a-43be-8c1a-152cfb3db896"},"photo":null,"bio":{"text":"Lee Hyun is a South Korean singer. He debuted in 2007 as a member of the co-ed vocal group 8Eight, which disbanded in 2014. He was also a member of the disbanded vocal duo Homme from 2010 to 2018. Lee is currently signed to Big Hit Music as a solo artist. He introduced his alter ego Midnatt in March 2023, through the release of the single \"Masquerade\".","title":"Lee Hyun","url":"https://en.wikipedia.org/wiki/Lee_Hyun"}},"Q486134":{"id":"Q486134","name":"Chae Ri-na","ko":"채리나","birthName":"박현주","birthNameEn":"","aliases":["Chae Rina","Chae Ri Na"],"birth":"1977-02-03","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"1995","agencies":[],"groups":[{"id":"Q485839","name":"Girl Friends","start":"","end":""},{"i