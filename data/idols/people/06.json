],"debut":"2014","agencies":[{"name":"Rainbow Bridge World","korean":true,"id":"Q16174772","start":"","end":""}],"groups":[{"id":"Q117663677","name":"MAMAMOO+","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/mo_onbyul/","spotify":"https://open.spotify.com/artist/1eTft3tXynrKdo6XD7QHLL","musicbrainz":"https://musicbrainz.org/artist/1478adcd-e96c-441b-b5db-89d66ff456f7"},"photo":null,"bio":{"text":"Moon Byul-yi, known professionally as Moonbyul (문별; stylized as Moon Byul), is a South Korean rapper, singer and songwriter under RBW Entertainment. She is a member of the South Korean girl group Mamamoo and its sub-unit Mamamoo+. Moonbyul made her solo debut in May 2018 with the digital single Selfish. According to the Korea Music Copyright Association, she has songwriting credits on over 100 songs.","title":"Moonbyul","url":"https://en.wikipedia.org/wiki/Moonbyul"},"positions":["Rapper","Performance"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EB%AC%B8%EB%B3%84"}}},"Q22910214":{"id":"Q22910214","name":"Jeon Somi","ko":"전소미","birthName":"Ennik Somi Douma","birthNameEn":"Ennik Somi Douma","aliases":["Ennik Somi Douma","Somi","Jeon So-mi","Ennik Douma"],"birth":"2001-03-09","death":"","birthplace":"Windsor","nationality":["Canada","South Korea","Kingdom of the Netherlands"],"height":172,"occupations":["singer","songwriter","dancer","model","actor"],"debut":"2016","agencies":[{"name":"The Black Label","korean":true,"id":"Q24866458","start":"","end":""},{"name":"YG Entertainment","korean":true,"id":"Q50595","start":"","end":""},{"name":"JYP Entertainment","korean":true,"id":"Q483238","start":"2015","end":"2018"}],"groups":[{"id":"Q23688122","name":"I.O.I","start":"2016","end":"2017"},{"id":"Q28409030","name":"Unnies","start":"2017","end":"2017"}],"links":{"website":"https://www.jeonsomiofficial.com/#/","instagram":"https://www.instagram.com/somsomi0309/","x":"https://x.com/somi_official_","spotify":"https://open.spotify.com/artist/7zYj9S9SdIunYCfSm7vzAR","musicbrainz":"https://musicbrainz.org/artist/8d4e6a86-fa1c-4a1b-b8c4-3b58a46dde9f"},"photo":null,"bio":{"text":"Ennik Somi Douma, known professionally by her Korean name Jeon Somi (전소미), is a South Korean and Canadian singer. Born in Canada to a South Korean mother and a Dutch-Canadian father, she moved to South Korea as an infant. Jeon initially rose to fame in South Korea as the first-place winner of the survival reality show Produce 101 and as a member of the show's corresponding eleven-piece girl group I.O.I. Following the conclusion of I.O.I's activities, Jeon signed with YG Entertainment's subsidiary, The Black Label. She made her debut as a solo artist on June 13, 2019, with the single \"Birthday\". In 2021, she released her first studio album XOXO, which included the top-ten single \"Dumb Dumb\".","title":"Jeon Somi","url":"https://en.wikipedia.org/wiki/Jeon_Somi"},"mbti":"ENFP","factSources":{"mbti":{"name":"Kpop Wiki","license":"CC BY-SA","licenseUrl":"https://www.fandom.com/licensing","base":"https://kpop.fandom.com/wiki/","url":"https://kpop.fandom.com/wiki/Jeon_Somi"}}},"Q22973190":{"id":"Q22973190","name":"김하나","ko":"","birthName":"","birthNameEn":"","aliases":[],"birth":"1980-03-16","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q2978909","name":"Cleo","start":"","end":""}],"links":{},"photo":null,"bio":null},"Q24000262":{"id":"Q24000262","name":"Ahn Hyo-seop","ko":"안효섭","birthName":"","birthNameEn":"","aliases":["Paul Ahn"],"birth":"1995-04-17","death":"","birthplace":"Seoul","nationality":["Canada"],"height":null,"occupations":["actor","singer"],"debut":"2015","agencies":[],"groups":[],"links":{"instagram":"https://www.instagram.com/imhyoseop/","x":"https://x.com/Ahnhyoseopj","spotif