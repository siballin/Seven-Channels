ng/","musicbrainz":"https://musicbrainz.org/artist/96183767-6861-4e6d-aa3a-e8cba3572283"},"photo":null,"bio":{"text":"Moon Bin, also known professionally as Moonbin, was a South Korean singer, actor, and dancer under the label Fantagio. He was a member of the South Korean boy group Astro and its sub-unit Moonbin & Sanha.","title":"Moonbin","url":"https://en.wikipedia.org/wiki/Moonbin"}},"Q22911780":{"id":"Q22911780","name":"Kim Se-jeong","ko":"김세정","birthName":"","birthNameEn":"","aliases":["Sejeong","Kim Sejeong","KIMSEJEONG","God Sejeong","Kim Se-jung"],"birth":"1996-08-28","death":"","birthplace":"Gimje","nationality":["South Korea"],"height":null,"occupations":["actor","singer"],"debut":"2016","agencies":[{"name":"Jellyfish Entertainment","korean":true,"id":"Q16180845","start":"","end":""}],"groups":[{"id":"Q23688122","name":"I.O.I","start":"2016","end":"2017"},{"id":"Q24694634","name":"Gugudan","start":"2016","end":"2020"},{"id":"Q55736655","name":"Gugudan SeMiNa","start":"2018","end":"2020"}],"links":{"instagram":"https://www.instagram.com/clean_0828/","x":"https://x.com/0828_kimsejeong","musicbrainz":"https://musicbrainz.org/artist/c41fab9f-c9ac-4d6f-9ccc-53f28656e987"},"photo":null,"bio":{"text":"Kim Se-jeong is a South Korean singer and actress. She finished second in Mnet's girl group survival show Produce 101, becoming a member of the project girl group I.O.I. She was also a member of Jellyfish Entertainment's girl group Gugudan. She is currently active as a solo artist and actress, best known for her lead roles in the television series School 2017 (2017), The Uncanny Counter (2020–2023), Business Proposal (2022), and Brewing Love (2024).","title":"Kim Se-jeong","url":"https://en.wikipedia.org/wiki/Kim_Se-jeong"}},"Q4460516":{"id":"Q4460516","name":"Kim Nam-joo","ko":"김남주","birthName":"","birthNameEn":"","aliases":["Namjoo"],"birth":"1995-04-15","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","dancer","a