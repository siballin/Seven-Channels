"bio":null},"Q60964":{"id":"Q60964","name":"Kim Petras","ko":"킴 페트라스","birthName":"","birthNameEn":"","aliases":[],"birth":"1992-08-27","death":"","birthplace":"Bonn","nationality":["Germany"],"height":null,"occupations":["songwriter","singer","pop singer"],"debut":"2006","agencies":[],"groups":[{"id":"Q65061223","name":"K/DA","start":"","end":""}],"links":{"website":"https://kimpetras.com/","instagram":"https://www.instagram.com/kimpetras/","x":"https://x.com/kimpetras","youtube":"https://www.youtube.com/channel/UChAjsnxIhU-3WZ8aSxE650A","tiktok":"https://www.tiktok.com/@kimpetras","spotify":"https://open.spotify.com/artist/3Xt3RrJMFv5SZkCfUE8C1J","musicbrainz":"https://musicbrainz.org/artist/54fc0558-12b5-4854-9d57-9441bcd73a72"},"photo":null,"bio":{"text":"Kim Petras is a German singer and songwriter based in Los Angeles. After gaining international media attention for transitioning as a teenager, she released her debut EP, One Piece of Tape (2011), and wrote tracks for Fergie, JoJo, Skylar Simone, and Twice. In 2017, Petras released her debut single \"I Don't Want It at All\", which charted at No. 54 on Billboard's Dance Club Songs chart. She followed this with her second EP, Turn Off the Light, Vol. 1 (2018), the mixtapes Clarity and Turn Off the Light (both 2019), and the single \"How It's Done\" (2019); the last of these featured on the soundtrack of the 2019 film Charlie's Angels.","title":"Kim Petras","url":"https://en.wikipedia.org/wiki/Kim_Petras"}},"Q61715236":{"id":"Q61715236","name":"Huening Kai","ko":"휴닝카이","birthName":"","birthNameEn":"","aliases":["Kai Kamal Huening"],"birth":"2002-08-14","death":"","birthplace":"Honolulu","nationality":["United States","South Korea"],"height":183,"occupations":["singer","rapper"],"debut":"2019","agencies":[{"name":"Big Hit Music","korean":true,"id":"Q106296918","start":"","end":""},{"name":"Republic Records","korean":false,"id":"Q4413456","start":"","end":""},{"name":"Universal Music Japan","korean":false,"id":"Q8194234","start":"","end":""}],"groups":[{"id":"Q60550265","name":"Tomorrow X Together","start":"","end":""}],"links":{"musicbrainz":"https://musicbrainz.org/artist/f9991bc9-39ef-48b4-b3cd-63ab90dd1865"},"photo":null,"bio":{"text":"Kai Kamal Huening, known professionally as Hueningkai, is an American singer and songwriter based in South Korea. He is a member of the South Korean boy band Tomorrow X Together, which debuted under Big Hit Entertainment in March 2019. In addition to his work with the group, he has participated in individual fashion campaigns and editorial features.","title":"Hueningkai","url":"https://en.wikipedia.org/wiki/Hueningkai"}},"Q625508":{"id":"Q625508","name":"Yoo Chae-yeong","ko":"유채영","birthName":"","birthNameEn":"","aliases":[],"birth":"1973-09-22","death":"2014-07-24","birthplace":"South Korea","nationality":["South Korea"],"height":null,"occupations":["actor","singer","film actor"],"debut":"","agencies":[],"groups":[{"id":"Q17503797","name":"Us","start":"1995","end":"1997"}],"links":{"musicbrainz":"https://musicbrainz.org/artist/4adfc44f-2bf4-4951-97f4-9e9648315e17"},"photo":null,"bio":{"text":"Yoo Chae-yeong was a South Korean singer, actress, and radio host.","title":"Yoo Chae-yeong","url":"https://en.wikipedia.org/wiki/Yoo_Chae-yeong"}},"Q63791524":{"id":"Q63791524","name":"Ahn Han-byeol","ko":"안한별","birthName":"","birthNameEn":"","aliases":["HanByeol"],"birth":"2003-10-13","death":"","birthplace":"South Korea","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q60175858","name":"DreamNote","start":"","end":"2019"}],"links":{},"photo":null,"bio":null},"Q6408548":{"id":"Q6408548","name":"Kim Da-som","ko":"김다솜","birthName":"","birthNameEn":"","aliases":["Kim Da Som","Dasom","Kim Dasom"],"birth":"1993-05-06","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor","model","film actor"],"debut":"2010","agencies":[{"name":"Starship Entertainment","korean":true,"id":"Q255363","start":"","end":""}],"groups":[{"id":"Q223048","name":"SISTAR","start":"2010","end":"2017"}],"links":{"instagram":"https://www.instagram.com/som0506/","spotify":"https://open.spotify.com/artist/5VHbR6uHDUIKO9QpCLDclH","musicbrainz":"https://musicbrainz.org/artist/65003cde-15a6-4ffa-ae13-23b30bfb3c6b"},"photo":null,"bio":{"text":"Kim Da-som, known mononymously as Dasom, is a South Korean actress and singer. She is best known as a former member of South Korean girl group Sistar and formerly under Starship Entertainment. She has acted in films and television dramas, including Family (2012–2013), Melody of Love (2013–2014), The Virtual Bride (2015), Sister is Alive (2017) and He Is Psychometric (2019).","title":"Kim Da-som","url":"https://en.wikipedia.org/wiki/Kim_Da-som"}},"Q6612516":{"id":"Q6612516","name":"Kang Su-ji","ko":"강수지","birthName":"","birthNameEn":"","aliases":["Kang Susie","Susie Kang","Kang Su Ji","Kang Suji","Kang Soo-ji","Kang Sooji","Kang Soo Ji","Kang Sujee"],"birth":"1967-05-20","death":"","birthplace":"Yongsan District","nationality":["South Korea"],"height":null,"occupations":["film actor","singer","actor","composer"],"debut":"1990","agencies":[],"groups":[],"links":{"instagram":"https://www.instagram.com/kangsusie_official/","musicbrainz":"https://musicbrainz.org/artist/42a160ea-aebb-4d79-a34d-442430f01141"},"photo":null,"bio":{"text":"Kang Susie is a South Korean singer-songwriter. She debuted in 1990 with the release of her first album, \"Violet Fragrance\". She has also performed in Japan, and has also hosted radio program Kang Su-ji's Memories from 2013 to 2014.","title":"Kang Susie","url":"https://en.wikipedia.org/wiki/Kang_Susie"}},"Q67991396":{"id":"Q67991396","name":"Kim Jihun","ko":"김지훈","birthName":"","birthNameEn":"","aliases":["Jihun"],"birth":"1995-02-20","death":"","birthplace":"","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q