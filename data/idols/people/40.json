anie","ko":"스테파니","birthName":"","birthNameEn":"","aliases":["Kim Bo-kyung","Stephanie Kim","Bo-kyung Kim"],"birth":"1987-10-16","death":"","birthplace":"San Diego","nationality":["South Korea","United States"],"height":null,"occupations":["singer","actor"],"debut":"2005","agencies":[{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"","end":""}],"groups":[{"id":"Q483706","name":"The Grace","start":"2005","end":"2009"}],"links":{"instagram":"https://www.instagram.com/stephanie_kim/","x":"https://x.com/stephk1016","musicbrainz":"https://musicbrainz.org/artist/125d05a2-c620-4f62-923f-6a245719add2"},"photo":null,"bio":{"text":"Bo-kyung Kim, better known as Stephanie Kim or Stephanie, is an American singer, ballerina and musical actress based in South Korea. Born and raised in California, she went to South Korea and joined SM Entertainment after winning Youth Best Selection Competition in February 2004. After years of training, she debuted as a member of South Korean girl group The Grace in April 2005. In October 2012, she began her solo career with the release of single album The New Beginning.","title":"Stephanie Kim","url":"https://en.wikipedia.org/wiki/Stephanie_Kim"}},"Q16171816":{"id":"Q16171816","name":"기수","ko":"","birthName":"","birthNameEn":"","aliases":[],"birth":"","death":"","birthplace":"","nationality":[],"height":null,"occupations":[],"debut":"","agencies":[],"groups":[{"id":"Q12621311","name":"24K","start":"","end":""}],"links":{"x":"https://x.com/24K_7S"},"photo":null,"bio":null},"Q16766824":{"id":"Q16766824","name":"Minwoo","ko":"노민우","birthName":"노민우","birthNameEn":"","aliases":["Noh Min-woo"],"birth":"1995-07-31","death":"","birthplace":"Anyang","nationality":["South Korea"],"height":null,"occupations":["actor","film actor","singer"],"debut":"","agencies":[{"name":"Starship Entertainment","korean":true,"id":"Q255363","start":"","end":""}],"groups":[{"id":"Q307457","name":"BF","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/boyminwoo_/","x":"https://x.com/BOYF_MW"},"photo":null,"bio":null},"Q17716456":{"id":"Q17716456","name":"Park Bo-ram","ko":"박보람","birthName":"","birthNameEn":"","aliases":["Park Boram"],"birth":"1994-03-01","death":"2024-04-11","birthplace":"Chuncheon","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2010","agencies":[{"name":"Stone Music Entertainment","korean":true,"id":"Q483971","start":"","end":""}],"groups":[],"links":{"instagram":"https://www.instagram.com/ramramram2/","x":"https://x.com/parkboram0813","musicbrainz":"https://musicbrainz.org/artist/f374a3a3-43e0-4056-8eff-598a3f60535a"},"photo":null,"bio":{"text":"Park Bo-ram was a South Korean singer. She took part in Mnet's SuperStar K2 and finished in eighth place. Park made her debut with release digital single \"Beautiful\" featuring Zico on August 7, 2014. That year, she won Artist of the Year for August at the Gaon Chart K-Pop Awards and was nominated for Best New Artist at the Mnet Asian Music Awards, Golden Disc Awards, and Melon Music Awards. She died at age 30 from acute alcohol poisoning after collapsing at her friend's home.","title":"Park Bo-ram","url":"https://en.wikipedia.org/wiki/Park_Bo-ram"}},"Q2495400":{"id":"Q2495400","name":"Yoon Bo-mi","ko":"윤보미","birthName":"","birthNameEn":"","aliases":["Bomi"],"birth":"1993-08-13","death":"","birthplace":"Suwon","nationality":["South Korea"],"height":null,"occupations":["singer","dancer","actor","model","television producer"],"debut":"2011","agencies":[{"name":"IST Entertainment","korean":true,"id":"Q21554828","start":"","end":""}],"groups":[{"id":"Q483286","name":"Apink","start":"2011","end":""},{"id":"Q126893845","name":"Apink Chobom","start":"","end":""},{"id":"Q17362588","name":"Apink BnN","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/__yoonbomi__/","x":"https://x.com/apinkbm","youtube":"https://www.youtube.com/channel/UCzpOLMBZ6qxhb6GJ5eksq5A","musicbrainz":"https://musicbrainz.org/artist/129f50a7-e294-46ae-85c2-68deefb6588c"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/9/90/A_Pink_Tencent_K-POP_concert_06.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:A_Pink_Tencent_K-POP_concert_06.jpg","author":"147company","license":"CC BY 4.0"},"bio":{"text":"Yoon Bo-mi, known mononymously as Bomi, is a South Korean singer and actress. She is best known as a member of the South Korean girl group Apink. Yoon made her acting debut with a cameo role in the 2012 television series Reply 1997, she then starred in various television series such as Because This Is My First Life (2017), Please Don't Date Him (2020), and gained attention through her supporting role in Queen of Tears (2024).","title":"Yoon Bo-mi","url":"https://en.wikipedia.org/wiki/Yoon_Bo-mi"}},"Q25190568":{"id":"Q25190568","name":"Buffy","ko":"버피","birthName":"김주현","birthNameEn":"","aliases":[],"birth":"1995-06-15","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[{"name":"J. Tune Camp","korean":true,"id":"Q16850770","start":"","end":""}],"groups":[{"id":"Q18712427","name":"Madtown","start":"","end":""}],"links":{},"photo":null,"bio":{"text":"Madtown, often stylized as MADTOWN, was a South Korean boy band formed in 2014 by J. Tune Camp. The group consisted of Moos, Daewon, Lee Geon, Jota, Heo Jun, Buffy and H.O. Their debut album, Mad Town, was released on October 6, 2014. Two of the members, Moos and Buffy, originally debuted as the hip hop duo Pro C in 2013. Madtown's official fan-base name is Mad-people. Starting December 22, 2016, Madtown's contract was sold to GNI Entertainment after J. Tune Camp closed. On The Unit, Daewon and Lee Geon confirmed Madtown's disbandment.","title":"Buffy (rapper)","url":"https://en.wikipedia.org/wiki/Buffy_%28rapper%29"}},"Q43073768":{"id":"Q43073768","name":"Kang In-soo","ko":"인수","birthName":"","birthNameEn":"","aliases":[],"birth":"1988-03-10","death":"","birthplace":"Suwon","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2011","agencies":[],"groups":[{"id":"Q487111","name":"Myname","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/insoo_casper/","musicbrainz":"https://musicbrainz.org/artist/66ec30d4-7048-475e-9d9a-39b313bd0019"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/1/19/MYNAME_%28%EB%A7%88%EC%9D%B4%EB%84%A4%EC%9E%84%29_%29_%EC%9D%B8%EC%83%9D%EA%B7%B9%EC%9E%A5_49%ED%99%94_Mission_0531_%28%EC%9D%B8%EC%88%98%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:MYNAME_(%EB%A7%88%EC%9D%B4%EB%84%A4%EC%9E%84)_)_%EC%9D%B8%EC%83%9D%EA%B7%B9%EC%9E%A5_49%ED%99%94_Mission_0531_(%EC%9D%B8%EC%88%98).jpg","author":"1theK","license":"CC BY 3.0"},"bio":{"text":"Kang In-soo is a South Korean singer and actor. Born in Suwon, Gyeonggi Province, he was an aspiring singer in his adolescence and applied to the Department of Theater and Film in high school, but majored in dance following the denial of his initial application. Kang signed to H2 Media, where he debuted with boy idol group Myname. He is a vocalist for the quintet. He performed his first acting role in Shinokubo Story (2013) alongside the group. Naked (2017), his first mini-album independent from Myname, was released in Japan in September. He enlisted in the mandatory military service the following month.","title":"Kang In-soo","url":"https://en.wikipedia.org/wiki/Kang_In-soo"}},"Q43110888":{"id":"Q43110888","name":"Go Eun-chae","ko":"고은채","birthName":"황은채","birthNameEn":"","aliases":["Ko Un-ccha"],"birth":"1980-08-28","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"","agencies":[],"groups":[{"id":"Q496732","name":"Papaya","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/eat_.pray._love._/"},"photo":null,"bio":null},"Q485672":{"id":"Q485672","name":"Gain","ko":"가인","birthName":"Son Ga-in","birthNameEn":"Son Ga-in","aliases":["Baby-G","Son Ga In","Son Kain","Son Ka-in","Son Ka In","Son Ga-in"],"birth":"1987-09-20","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2006","agencies":[{"name":"Kakao M","korean":true,"id":"Q625975","start":"","end":""},{"name":"Mystic Story","korean":true,"id":"Q15509774","start":"","end":""}],"groups":[{"id":"Q483253","name":"Brown Eyed Girls","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/songain87/","youtube":"https://www.youtube.com/channel/UCrpiYiHmGZ5Vq2Pm5ykdX7w","musicbrainz":"https://musicbrainz.org/artist/3abcc734-ab91-4385-9849-99a12c3fc3ea"},"photo":null,"bio":{"text":"Son Ga-in, known mononymously as Gain, is a South Korean singer, actress and entertainer, best known as a member of the South Korean girl group Brown Eyed Girls. Having debuted with her home group earlier in 2006, Gain eventually made her solo debut in October 2010 with Step 2/4 to great commercial success, and has since released a total of six extended plays. In addition to her musical career, the singer also appeared in several native programs and series, most notably We Got Married and All My Love for You, where she co-starred alongside 2AM's Jo Kwon.","title":"Gain (singer)","url":"https://en.wikipedia.org/wiki/Gain_%28singer%29"}},"Q489640":{"id":"Q489640","name":"Ji Suk-jin","ko":"지석진","birthName":"","birthNameEn":"","aliases":["Jee Seok-jin"],"birth":"1966-02-10","death":"","birthplace":"Jeongseon County","nationality":["South Korea"],"height":null,"occupations":["television presenter","comedian","singer","television actor"],"debut":"","agencies":[{"name":"FNC Entertainment","korean":true,"id":"Q12581039","start":"","end":""}],"groups":[{"id":"Q107563345","name":"MSG Wannabe","start":"","end":""}],"l