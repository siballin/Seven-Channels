uth Korea"],"height":null,"occupations":["television actor","singer","film actor","actor","model","composer"],"debut":"2008","agencies":[],"groups":[{"id":"Q222760","name":"2PM","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/taecyeonokay/","x":"https://x.com/taeccool","youtube":"https://www.youtube.com/channel/UCBpzJvEhkemwMOkYLq9yUsA","musicbrainz":"https://musicbrainz.org/artist/60e2b075-4be8-4651-822e-1c73550eeac2"},"photo":null,"bio":{"text":"Ok Taec-yeon, known mononymously as Taecyeon, is a South Korean singer-songwriter, rapper, and actor. In 2008, he debuted as the rapper of the South Korean boy band 2PM. In 2010, Ok debuted as an actor in the Korean drama Cinderella's Stepsister and has since starred in notable television series such as Dream High (2011), Bring It On, Ghost (2016), Vincenzo (2021), and The First Night with the Duke (2025), as well as films such as Hansan: Rising Dragon (2022). As a solo artist, he has released one Japanese studio album titled Taecyeon Special: Winter Hitori in 2017.","title":"Ok Taec-yeon","url":"https://en.wikipedia.org/wiki/Ok_Taec-yeon"},"positions":["Main rapper","Sub vocalist"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%ED%83%9D%EC%97%B0"}}},"Q483683":{"id":"Q483683","name":"CL","ko":"","birthName":"Lee Chae-rin","birthNameEn":"Lee Chae-rin","aliases":["Lee Chae-lin","Chaelin Lee","ChaeLin","Lee Chae Lin"],"birth":"1991-02-26","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["rapper","singer","songwriter","composer"],"debut":"2009","agencies":[{"name":"YG Entertainment","korean":true,"id":"Q50595","start":"","end":""}],"groups":[{"id":"Q171885","name":"2NE1","start":"2024","end":"2016"}],"links":{"website":"https://inthenameoflove.cl/","instagram":"https://www.instagram.com/chaelincl/","x":"https://x.com/chaelincl","youtube":"https://www.youtube.com/channel/UCuX8lXIexG8dRXFx54CVm2Q","tiktok":"https://www.tiktok.com/@chaelincl","spotify":"https://open.spotify.com/artist/0tzSBCPJZmHTdOA3ZV2mN3","musicbrainz":"https://musicbrainz.org/artist/549c659d-bd39-4acd-b664-d0691036e71a"},"photo":null,"bio":{"text":"Lee Chae-rin, better known by her stage name CL, is a South Korean rapper, singer, and songwriter. Born in Seoul, South Korea, she spent much of her early life in Japan and France. She rose to fame as a member and leader of the girl group 2NE1, which debuted in 2009 under YG Entertainment. 2NE1 became one of the most popular South Korean girl groups worldwide and one of the best-selling girl groups. CL made her solo debut with the single \"The Baddest Female\" in May 2013, followed by her second solo track \"MTBD\" in February 2014. In 2015, amid 2NE1's hiatus, CL pursued a solo career with the release of the single \"Hello Bitches\" (2015).","title":"CL (rapper)","url":"https://en.wikipedia.org/wiki/CL_%28rapper%29"}},"Q484387":{"id":"Q484387","name":"Danny Ahn","ko":"데니 안","birthName":"Ahn Shin-won","birthNameEn":"Ahn Shin-won","aliases":["Ahn Shin-won"],"birth":"1978-12-22","death":"","birthplace":"Seattle","nationality":["South Korea","United States"],"height":null,"occupations":["singer","rapper"],"debut":"1999","agencies":[{"name":"JYP Entertainment","korean":true,"id":"Q483238","start":"","end":""},{"name":"IHQ","korean":true,"id":"Q7509507","start":"","end":""}],"groups":[{"id":"Q482380","name":"god","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/dna1222/","x":"https://x.com/DNA1222","musicbrainz":"https://musicbrainz.org/artist/734f781b-58cc-430e-bf27-c3fdb34bb50b"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/0/0d/Danny_Ahn_from_acrofan.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Danny_Ahn_from_acrofan.jpg","author":"acrofan.com","license":"CC BY-SA 3.0"},"bio":{"text":"Danny Ahn is an American entertainer best known as the main rapper of the South Korean pop music group g.o.d. Having made his debut in the entertainment industry as a member of g.o.d in 1999, Ahn has gone into acting and has also been a radio DJ and MC.","title":"Danny Ahn","url":"https://en.wikipedia.org/wiki/Danny_Ahn"},"positions":["Main rapper"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EB%8D%B0%EB%8B%88_%EC%95%88"}}},"Q485667":{"id":"Q485667","name":"Jo Kwon","ko":"조권","birthName":"","birthNameEn":"","aliases":[],"birth":"1989-08-28","death":"","birthplace":"Suwon","nationality":["South Korea"],"height":null,"occupations":["singer","television actor","actor","model"],"debut":"2008","agencies":[{"name":"JYP Entertainment","korean":true,"id":"Q483238","start":"","end":""},{"name":"Big Hit Music","korean":true,"id":"Q106296918","start":"","end":""}],"groups":[{"id":"Q498701","name":"2AM","start":"2008","end":""}],"links":{"instagram":"https://www.instagram.com/kwon_jo/","x":"https://x.com/2amkwon","youtube":"https://www.youtube.com/channel/UCsXSSsAnx7BCE5OF3a2NTLA","spotify":"https://open.spotify.com/artist/1hJ6EZjb0pnvPeBdzulrUr","musicbrainz":"https://musicbrainz.org/artist/4787068b-66e5-4a0e-9ed4-003e28424652"},"photo":null,"bio":{"text":"Jo Kwon, is a South Korean singer, television host, actor, entertainer and the leader of South Korean boy band 2AM. He has starred in multiple musicals such as Jesus Christ Superstar playing the role of King Herod and Everybody's Talking About Jamie as Jamie New.","title":"Jo Kwon","url":"https://en.wikipedia.org/wiki/Jo_Kwon"},"positions":["Leader","Lead vocalist"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativeco