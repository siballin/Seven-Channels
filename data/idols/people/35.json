ttps://en.wikipedia.org/wiki/Lee_Jae-yoon_%28singer%29"}},"Q85880867":{"id":"Q85880867","name":"Park Seong-hwa","ko":"박성화","birthName":"","birthNameEn":"","aliases":["Seonghwa","Seyoung"],"birth":"1998-04-03","death":"","birthplace":"Jinju","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"","agencies":[{"name":"KQ Entertainment","korean":true,"id":"Q31179359","start":"","end":""}],"groups":[{"id":"Q59793088","name":"Ateez","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/silverseonghwa/"},"photo":null,"bio":{"text":"Park Seong-hwa, known mononymously as Seonghwa, is a South Korean singer, model, and actor. He is best known as a member of the boy group Ateez, formed by KQ Entertainment in 2018. He made his acting debut in the 2021 KBS drama Imitation with bandmates Yunho, San, and Jongho.","title":"Seonghwa","url":"https://en.wikipedia.org/wiki/Seonghwa"}},"Q9022435":{"id":"Q9022435","name":"Park Juhyun","ko":"박시현","birthName":"박주현","birthNameEn":"","aliases":[],"birth":"1986-11-29","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","dancer"],"debut":"2012","agencies":[],"groups":[{"id":"Q492387","name":"Spica","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/sh861129/","x":"https://x.com/p_joo","musicbrainz":"https://musicbrainz.org/artist/4146d301-30de-47cb-ba77-4514733106be"},"photo":null,"bio":null},"Q9194275":{"id":"Q9194275","name":"Park Sung-min","ko":"성민","birthName":"","birthNameEn":"","aliases":[],"birth":"1993-05-31","death":"","birthplace":"","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q492271","name":"A-Jax","start":"","end":""}],"links":{"x":"https://x.com/Ajax_SM93"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/e/ea/A-JAX-Sung_Min.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://common