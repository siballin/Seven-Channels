],"groups":[{"id":"Q135466598","name":"Idid","start":"","end":""}],"links":{},"photo":null,"bio":{"text":"Debut's Plan is a 2025 South Korean boy group reality competition survival show created by Starship Entertainment. It followed the process of creating their newest boy group. It premiered on March 14, 2025, and aired every Friday at 9:30 PM KST on the show's YouTube channel. The show ended on May 4, 2025, with the formation of an eight-member boy group named Idid.","title":"Chu Yoo-chan","url":"https://en.wikipedia.org/wiki/Chu_Yoo-chan"}},"Q16175203":{"id":"Q16175203","name":"Cheetah","ko":"치타","birthName":"Kim Eun-young","birthNameEn":"Kim Eun-young","aliases":[],"birth":"1990-05-20","death":"","birthplace":"Busan","nationality":["South Korea"],"height":null,"occupations":["singer","rapper"],"debut":"2010","agencies":[{"name":"C9 Entertainment","korean":true,"id":"Q16167317","start":"","end":""}],"groups":[],"links":{"instagram":"https://www.instagram.com/dhdldzlzl/","x":"https://x.com/BL_Cheetah","spotify":"https://open.spotify.com/artist/6ftZYkensUYXNiMM7nFwhE","musicbrainz":"https://musicbrainz.org/artist/7040a448-9dec-412e-b56a-8378a4e83da4"},"photo":null,"bio":{"text":"Kim Eun-young, known by her stage name Cheetah (치타), is a South Korean rapper. Cheetah rose to fame as the winner on the TV competition Unpretty Rapstar. She debuted in 2010 with the song \"Stop (Money Can't Buy Me Love)\" as a part of the duo Blacklist and was signed under C9 Entertainment. In April 2020, she left C9 Entertainment, which she belonged to from her debut, and founded the one-person agency, Ceuda Entertainment.","title":"Cheetah (rapper)","url":"https://en.wikipedia.org/wiki/Cheetah_%28rapper%29"}},"Q16183011":{"id":"Q16183011","name":"Cho Hyun-young","ko":"조현영","birthName":"","birthNameEn":"","aliases":["Hyunyoung"],"birth":"1991-08-11","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["actor","singer","model"],"debut":"","agencies":[]