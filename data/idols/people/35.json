,"license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%ED%83%9C%ED%98%84"}}},"Q624995":{"id":"Q624995","name":"Sunmi","ko":"선미","birthName":"이선미","birthNameEn":"","aliases":["Lee Sunmi"],"birth":"1992-05-02","death":"","birthplace":"Iksan","nationality":["South Korea"],"height":null,"occupations":["model","television presenter","singer-songwriter","pop singer"],"debut":"2007","agencies":[{"name":"Abyss Company","korean":true,"id":"Q104787825","start":"","end":""}],"groups":[{"id":"Q476119","name":"Wonder Girls","start":"2007","end":"2017"}],"links":{"instagram":"https://www.instagram.com/miyayeah/","x":"https://x.com/official_sunmi_","youtube":"https://www.youtube.com/channel/UCsVpgRB8YHLWA0ZrkhtHvTA","tiktok":"https://www.tiktok.com/@official_sunmi","spotify":"https://open.spotify.com/artist/6MoXcK2GyGg7FIyxPU5yW6","musicbrainz":"https://musicbrainz.org/artist/716a8be4-6f58-4e64-a1e6-fb3017f21bf6"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/6/64/Lee_Sunmi_%EC%9D%B4%EC%84%A0%EB%AF%B8_2024_06.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Lee_Sunmi_%EC%9D%B4%EC%84%A0%EB%AF%B8_2024_06.jpg","author":"티비텐","license":"CC BY 3.0"},"bio":{"text":"Lee Sun-mi, known mononymously as Sunmi, is a South Korean singer, dancer, songwriter and record producer. She debuted in 2007 as a member of South Korean girl group Wonder Girls and left the group in 2010 to pursue her studies. After a three-year hiatus, Sunmi resumed her career as a soloist with her 2013 debut extended play, Full Moon, spawning the number two singles \"24 Hours\" and \"Full Moon\" on the national Gaon Digital Chart. In 2015, Sunmi was announced to be resuming promotion with the Wonder Girls and remained with the group until their disbandment in 2017.","title":"Sunmi","url":"https://en.wikipedia.org/wiki/Sunmi"},"positions":["Sub vocalist"],"mbti":"INFP","factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EC%84%A0%EB%AF%B8"},"mbti":{"name":"Kpop Wiki","license":"CC BY-SA","licenseUrl":"https://www.fandom.com/licensing","base":"https://kpop.fandom.com/wiki/","url":"https://kpop.fandom.com/wiki/Sunmi"}}},"Q63922275":{"id":"Q63922275","name":"Taeha","ko":"태하","birthName":"","birthNameEn":"","aliases":["Yoo Joo"],"birth":"1995-10-05","death":"","birthplace":"Gwangju","nationality":["South Korea"],"height":null,"occupations":["singer","dancer","actor"],"debut":"2014-05-22","agencies":[],"groups":[{"id":"Q18381082","name":"Berry Good","start":"2014","end":"2019"}],"links":{"instagram":"https://www.instagram.com/taeha.yoo/","musicbrainz":"https://musicbrainz.org/artist/f7721312-4802-4075-a2da-7d6f95f213c2"},"photo":null,"bio":{"text":"Berry Good was a South Korean girl group formed by Asia Bridge Entertainment in 2014. They released their debut single Love Letter on May 21, 2014, as a quintet, then, after two line-up changes, they were mainly active as a sextet consisting of original members Taeha and Gowoon and new members Seoyul, Daye, Sehyung and Johyun. They officially disbanded on May 12, 2021.","title":"Taeha","url":"https://en.wikipedia.org/wiki/Taeha"}},"Q63943139":{"id":"Q63943139","name":"Seoyul","ko":"서율","birthName":"","birthNameEn":"","aliases":["Seo Yu-ri"],"birth":"1997-11-26","death":"","birthplace":"Haeundae District","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2015","agencies":[],"groups":[{"id":"Q18381082","name":"Berry Good","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/y__s._.s__/","musicbrainz":"https://musicbrainz.org/artist/eb678d30-d375-4455-830e-2e28ba5d1344"},"photo":null,"bio":null,"positions":["Lead vocalist"],"factSourc