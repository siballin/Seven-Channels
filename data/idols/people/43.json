musicbrainz":"https://musicbrainz.org/artist/a2a232f3-7bac-42ce-805a-dc12da455966"},"photo":null,"bio":null},"Q16323115":{"id":"Q16323115","name":"Bang Ye-dam","ko":"방예담","birthName":"방예담","birthNameEn":"","aliases":[],"birth":"2002-05-07","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2020","agencies":[{"name":"YG Entertainment","id":"Q50595","start":"","end":""}],"groups":[{"id":"Q61057550","name":"Treasure","start":"2020","end":"2022"}],"links":{"musicbrainz":"https://musicbrainz.org/artist/908dff3d-17ff-4de9-8122-b824d8eed8cc"},"photo":null,"bio":{"text":"Bang Ye-dam is a South Korean singer, songwriter and producer. He is best known as a former member of South Korean boy band Treasure and for competing in the second installment of K-pop Star (2012–2013), where he finished as runner-up. He debuted as a soloist with the digital single titled \"Wayo\" (왜요) on June 5, 2020. In August 2023, he signed with GF Entertainment as soloist and producer. Since 2025, he has also released music under the alter ego DIMO REX, exploring a more mature musical side.","title":"Bang Ye-dam","url":"https://en.wikipedia.org/wiki/Bang_Ye-dam"}},"Q18052779":{"id":"Q18052779","name":"Jo Eun-Sae","ko":"조은새","birthName":"조혜경","birthNameEn":"","aliases":["Jo Hye-Gyeong"],"birth":"1980-04-30","death":"","birthplace":"Incheon","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q496732","name":"Papaya","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/eun_sae_jo/","x":"https://x.com/gojoeunsae"},"photo":null,"bio":null},"Q18325355":{"id":"Q18325355","name":"Ashley Choi","ko":"애슐리","birthName":"Choi Bit-na","birthNameEn":"Choi Bit-na","aliases":["Ashley Choi","Choi Bitna","Ashley"],"birth":"1991-11-09","death":"","birthplace":"Incheon","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2013","agencies":[{"name":"Polaris Enterta