e":"Wonwoo","url":"https://en.wikipedia.org/wiki/Wonwoo"}},"Q232491":{"id":"Q232491","name":"Lee Hyori","ko":"이효리","birthName":"","birthNameEn":"","aliases":["Lee Hyo-ri"],"birth":"1979-02-19","death":"","birthplace":"Cheongju","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"1998","agencies":[{"name":"Antenna","id":"Q4771243","start":"","end":""},{"name":"DSP Media","id":"Q489428","start":"","end":""}],"groups":[{"id":"Q484082","name":"Fin.K.L","start":"1998","end":"2005"}],"links":{"instagram":"https://www.instagram.com/lee_hyolee/","musicbrainz":"https://musicbrainz.org/artist/ab569068-400c-436f-ac45-422fe2fce20b"},"photo":null,"bio":{"text":"Lee Hyori is a South Korean singer and television personality. She debuted as a member of group Fin.K.L in 1998, which became one of the most popular girl groups in South Korea during the late 1990s and early 2000s. Aside from Fin.K.L, she has also participated in several project groups, including the Refund Sisters and SSAK3 in 2020. Lee made her solo debut in August 2003 with the release of Stylish.... The album sold over 150,000 copies and spawned the hit single \"10 Minutes\".","title":"Lee Hyori","url":"https://en.wikipedia.org/wiki/Lee_Hyori"}},"Q28698283":{"id":"Q28698283","name":"Choi Yu-jin","ko":"최유진","birthName":"","birthNameEn":"","aliases":["Yujin"],"birth":"1996-08-12","death":"","birthplace":"Jeonju","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2015","agencies":[{"name":"Cube Entertainment","id":"Q484449","start":"","end":""},{"name":"WakeOne","id":"Q31180108","start":"","end":""},{"name":"Swing Entertainment","id":"Q65266336","start":"","end":""}],"groups":[{"id":"Q19626731","name":"CLC","start":"2015","end":"2022"},{"id":"Q109077000","name":"Kep1er","start":"2022","end":""}],"links":{"instagram":"https://www.instagram.com/utokki_/","musicbrainz":"https://musicbrainz.org/artist/5ea9f8b4-f986-4324-9cad-35e51ebd5489"},"photo":null,"bio":{"text":"Choi Yu-jin, known mononymously as Yujin, is a South Korean singer and actress. Originally debuting in 2015 as a member of the South Korean girl group CLC, she is a member and leader of Kep1er after finishing in third place in the final episode of the survival show Girls Planet 999. She began her acting career in 2016 in a supporting role in the Naver TV web drama, Nightmare High.","title":"Choi Yu-jin","url":"https://en.wikipedia.org/wiki/Choi_Yu-jin"}},"Q42850795":{"id":"Q42850795","name":"Sei","ko":"세이","birthName":"이서정","birthNameEn":"","aliases":["Lee Seo-jeong"],"birth":"2000-01-07","death":"","birthplace":"Songpa District","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2017","agencies":[],"groups":[{"id":"Q32860762","name":"Weki Meki","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/seiric_o/","musicbrainz":"https://musicbrainz.org/artist/c91fbf12-aa76-4268-8dd7-5edeb4937447"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/a/ae/181011_%EC%9C%84%ED%82%A4%EB%AF%B8%ED%82%A4_%EC%84%B8%EC%9D%B4%281%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:181011_%EC%9C%84%ED%82%A4%EB%AF%B8%ED%82%A4_%EC%84%B8%EC%9D%B4(1).jpg","author":"NINE STARS","license":"CC BY 3.0"},"bio":null},"Q483563":{"id":"Q483563","name":"Park Ji-yeon","ko":"지연","birthName":"박지연","birthNameEn":"","aliases":["Jiyeon","Jiyeon Park"],"birth":"1993-06-07","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor","model","dancer"],"debut":"2009","agencies":[{"name":"MBK Entertainment","id":"Q429296","start":"","end":""}],"groups":[{"id":"Q495383","name":"T-ara","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/jiyeon2__/","x":"https://x.com/pjy1234","musicbrainz":"https://musicbrainz.org/artist/34ae1dbe-3d91-4b5d-8cf8-9f054402849e"},"photo":null,"bio":{"text":"Park Ji-yeon, known mononymously as Jiyeon, is a South Korean singer, actress, model, host and entertainer. She debuted as a member of girl group T-ara in July 2009, which later went on to become one of the best-selling girl groups of all time. Apart from her group's activities, she has also starred in various television dramas such as Soul, Master of Study, Dream High 2, Triangle, she also starred in various films such as Death Bell 2: Bloody Camp. She debuted as a solo artist with her first EP, Never Ever, on May 20, 2014, the first T-ara member to debut as a solo artist.","title":"Park Ji-yeon","url":"https://en.wikipedia.org/wiki/Park_Ji-yeon"}},"Q484843":{"id":"Q484843","name":"Park Jung-min","ko":"박정민","birthName":"","birthNameEn":"","aliases":[],"birth":"1987-04-03","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor","model","recording artist"],"debut":"2005","agencies":[{"name":"DSP Media","id":"Q489428","start":"","end":""}],"groups":[{"id":"Q489849","name":"SS501","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/parkjungmin8743/","x":"https://x.com/jungmin0403","musicbrainz":"https://musicbrainz.org/artist/291b46d1-f3c6-4ed9-851a-00835f6ae1ce"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/c/c8/JungMinNotAlone.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:JungMinNotAlone.jpg","author":"Acrofan.com","license":"CC BY-SA 3.0"},"bio":{"text":"Park Jung-Min is a South Korean singer, entertainer, actor, and a member of boyband SS501. In 2009, Park made his musical debut in Grease as Danny Park, where he received the Best New Musical Talent award by the Golden Ticket Awards. He also had his acting debut as a main lead in Human Theater 2010. In 2010, Park opened his own online shopping mall called Royal Avenue, with him as the CEO. ONstyle Magazine created a documentary about the shopping center named What Women Want. With the expiration of the contract, Park left DSP Media, who managed him as part of SS501 and joined CNr Media as a solo artist.","title":"Park Jung-min (singer)","url":"https://en.wikipedia.org/wiki/Park_Jung-min_%28singer%29"}},"Q486443":{"id":"Q486443","name":"Henry Lau","ko":"헨리","birthName":"","birthNameEn":"","aliases":["Henry"],"birth":"1989-10-11","death":"","birthplace":"Toronto","nationality":["Canada","Taiwan"],"height":null,"occupations":["singer","dancer","record producer","actor","songwriter","composer"],"debut":"2008","agencies":[{"name":"SM Entertainment","id":"Q483938","start":"","end":""}],"groups":[{"id":"Q706116","name":"Super Junior-M","start":"2008","end":"2018"}],"links":{"instagram":"https://www.instagram.com/henryl89/","x":"https://x.com/henrylau89","youtube":"https://www.youtube.com/channel/UCSy5l865pfrmUCdpOyMqLpQ","tiktok":"https://www.tiktok.com/@iamhenry","spotify":"https://open.spotify.com/artist/1sjw4xq2pAWy5Vdgba5QAt","musicbrainz":"https://musicbrainz.org/artist/a80c7cc2-1697-4c71-8a40-38f160acb5df"},"photo":null,"bio":{"text":"Henry Lau, known mononymously as Henry, is a Canadian singer-songwriter, multi-instrumentalist, and record producer based in South Korea and China. He debuted in 2008 as a member of Super Junior-M and launched his solo career in 2013 with Trap. His song \"It's You\", released in 2017, became the most streamed Korean original soundtrack song on Spotify for two consecutive years in 2018 and 2019. In 2018, Henry left SM Entertainment following the expiration of his contract, and subsequently joined Monster Entertainment Group. Henry made his Hollywood debut in 2019 with the film A Dog's Journey produced by Amblin Entertainment. In 2020, he starred in the action-fantasy movie Double World.","title":"Henry Lau","url":"https://en.wikipedia.org/wiki/Henry_Lau"}},"Q487979":{"id":"Q487979","name":"Haha","ko":"하하","birthName":"하동훈","birthNameEn":"","aliases":["Ha Dong-hoon"],"birth":"1979-08-20","death":"","birthplace":"Stuttgart","nationality":["South Korea"],"height":null,"occupations":["film actor","record producer","composer","singer","film director","television actor"],"debut":"2008","agencies":[],"groups":[{"id":"Q20010782","name":"Running Man Brothers","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/quanhaha79/","x":"https://x.com/Quanninomarley","youtube":"https://www.youtube.com/channel/UCK3p1wDoQYOkxi414EvBlLw","musicbrainz":"https://musicbrainz.org/artist/b253f614-fa9b-4fe9-9a00-6ae30ecc5eee"},"photo":null,"bio":{"text":"Ha Dong-hoon, better known by his stage name Haha (하하), is a South Korean singer, rapper, variety show host and member of RGP. He is best known for being in the sitcom, Nonstop and for co-hosting two popular variety programs, MBC's Infinite Challenge and SBS's Running Man. He has also hosted his own show, titled \"Ya Man TV\" on Mnet in 2015.","title":"Haha (entertainer)","url":"https://en.wikipedia.org/wiki/Haha_%28entertainer%29"}},"Q56259179":{"id":"Q56259179","name":"Heejin","ko":"희진","birthName":"전희진","birthNameEn":"","aliases":["HeeJin","Jeon Hee-jin"],"birth":"2000-10-19","death":"","birthplace":"Daejeon","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2016","agencies":[{"name":"Blockberry Creative","id":"Q48989772","start":"","end":""},{"name":"Modhaus","id":"Q117195732","start":"","end":""}],"groups":[{"id":"Q28025953","name":"Loona","start":"2016","end":"2023"},{"id":"Q119692734","name":"ARTMS","start":"2023","end":""}],"links":{"instagram":"https://www.instagram.com/0ct0ber19/","musicbrainz":"https://musicbrainz.org/artist/9fbbbcc3-f2af-4f03-a0b1-844ee5aec94f"},"photo":null,"bio":{"text":"Jeon Hee-jin, known mononymously as Heejin (occasionally stylized as HeeJin) is a South Korean singer. She is a member of Loona, its sub-unit Loona 1/3, and Artms. She released her debut extended play K on October 31, 2023.","title":"Heejin","url":"https://en.wikipedia.org/wiki/Heejin"}},"Q57074219":{"id":"Q57074219","name":"Choi Byung-chan","ko":"최병찬","birthName":"","birthNameEn":"","aliases":["Byungchan","Choi Byungchan"],"birth":"1997-11-12","death":"","birthplace":"Jeonju","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2016","agencies":[],"groups":[{"id":"Q27861498","name":"Victon","start":"2016","end":"2023"}],"links":{"instagram":"https://www.instagram.com/b__yccn/","musicbrainz":"https://musicbrainz.org/artist/215a5f2f-fc21-4c89-a258-ec5e6fc782d6"},"photo":null,"bio":{"text":"Choi Byung-chan, also known as Byungchan, is a South Korean singer and actor. He debuted as a member of South Korean group Victon in 2016. In 2020, he made his acting debut in the drama Live On.","title":"Choi Byung-chan","url":"https://en.wikipedia.org/wiki/Choi_Byung-chan"}},"Q60529323":{"id":"Q60529323","name":"Ravn","ko":"레이븐","birthName":"","birthNameEn":"","aliases":[],"birth":"1995-09-02","death":"","birthplace":"Yongin","nationality":["South Korea"],"height":null,"occupations":["rapper","singer","dancer"],"debut":"","agencies":[],"groups":[{"id":"Q60528927","name":"Oneus","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/official_oneus/","x":"https://x.com/official_ONEUS"},"photo":null,"bio":null},"Q60831979":{"id":"Q60831979","name":"Kim Jungwoo","ko":"김정우","birthName":"","birthNameEn":"","aliases":["Jungwoo"],"birth":"1998-02-19","death":"","birthplace":"Gyeonggi Province","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2018","agencies":[{"name":"Avex Group","id":"Q790686","start":"","end":""}],"groups":[{"id":"Q23725822","name":"NCT","start":"","end":""},{"id":"Q55624444","name":"NCT 127","start":"","end":""},{"id":"Q67972645","name":"NCT U","start":"","end":""},{"id":"Q117460785","name":"NCT DoJaeJung","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/sugaringcandy/"},"photo":null,"bio":{"text":"Kim Jung-woo, known mononymously as Jungwoo, is a South Kore