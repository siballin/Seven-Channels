,"name":"Lee Je-no","ko":"제노","birthName":"","birthNameEn":"","aliases":["Jeno","Lee Jeno"],"birth":"2000-04-23","death":"","birthplace":"Incheon","nationality":["South Korea"],"height":null,"occupations":["rapper","singer","dancer"],"debut":"2016","agencies":[{"name":"SM Entertainment","id":"Q483938","start":"","end":""}],"groups":[{"id":"Q23725822","name":"NCT","start":"","end":""},{"id":"Q47002841","name":"NCT Dream","start":"","end":""},{"id":"Q138529514","name":"NCT JNJM","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/leejen_o_423/"},"photo":null,"bio":{"text":"Lee Je-no, known mononymously as Jeno, is a South Korean singer, rapper, and actor. He rose to prominence as a member of the K-pop boy band NCT and its sub-units NCT Dream and NCT JNJM. Born in Incheon and raised in Goyang, Jeno began his career as a child model and actor. In 2013, he started training under SM Entertainment and joined the label's official team of trainees, SM Rookies, appearing on television and touring both in South Korea and abroad. He made his debut in 2016 with NCT, which went on to achieve commercial success and become an influential K-pop act.","title":"Jeno (singer)","url":"https://en.wikipedia.org/wiki/Jeno_%28singer%29"}},"Q34442955":{"id":"Q34442955","name":"Takada Kenta","ko":"타카다 켄타","birthName":"","birthNameEn":"","aliases":[],"birth":"1995-01-10","death":"","birthplace":"Fujioka","nationality":["Japan"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q39075630","name":"JBJ","start":"","end":""},{"id":"Q56534357","name":"Kenta Sanggyun","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/rkm0855/","x":"https://x.com/kenta_starroad","musicbrainz":"https://musicbrainz.org/artist/ff03d196-8a89-4b6b-b6a7-7420a0ddbc86"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/a/ae/181030_JBJ95_%EB%8D%B0%EB%B7%94_%EC%95%A8%EB%B2%94_%27HOME%27_%EC%87%BC%EC%BC%80%EC%9D%B4%EC%8A%A4_%282%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:181030_JBJ95_%EB%8D%B0%EB%B7%94_%EC%95%A8%EB%B2%94_%27HOME%27_%EC%87%BC%EC%BC%80%EC%9D%B4%EC%8A%A4_(2).jpg","author":"뉴스인스타","license":"CC BY 3.0"},"bio":null},"Q38572171":{"id":"Q38572171","name":"Kwon Eun-bin","ko":"권은빈","birthName":"","birthNameEn":"","aliases":["Eunbin","Kwon Eunbean","Eunbean"],"birth":"2000-01-06","death":"","birthplace":"Seocho District","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2016","agencies":[{"name":"Cube Entertainment","id":"Q484449","start":"","end":""}],"groups":[{"id":"Q19626731","name":"CLC","start":"2016","end":"2022"}],"links":{"instagram":"https://www.instagram.com/superb_ean/","musicbrainz":"https://musicbrainz.org/artist/084e2da9-6685-425b-bab4-dc045f9df625"},"photo":null,"bio":{"text":"Kwon Eun-bin, also known simply as Eunbin, is a South Korean former singer and actress. She participated in the first season of Produce 101 (2016), before being eliminated in the penultimate episode. She debuted as a member of the South Korean girl group CLC in February 2016 with the release of the group's third EP Refresh. She made her acting debut in the television series Bad Papa (2018) and has since appeared in series including Top Management (2018), At a Distance, Spring Is Green (2021), Dear.M (2022) and Duty After School (2023).","title":"Kwon Eun-bin","url":"https://en.wikipedia.org/wiki/Kwon_Eun-bin"}},"Q493899":{"id":"Q493899","name":"Hyelim","ko":"혜림","birthName":"우혜림","birthNameEn":"","aliases":["Woo Hye-lim","Christina Woo","Woo Hye Lim","Woo Hyelim","Woo Hye-rim","Woo Hyerim","Woo Hye Rim","Woo Christina"],"birth":"1992-09-01","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","model"],"debut":"2010","agencies":[{"name":"JYP Entertainment","id":"Q483238","start":"","end":""}],"groups":[{"id":"Q476119","name":"Wonder Girls","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/wg_lim/","x":"https://x.com/WG_lim","musicbrainz":"https://musicbrainz.org/artist/09875e13-0b6f-48a1-853f-0c9f338a1da6"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/b/bc/Woo_Hye-rim_in_May_2023.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Woo_Hye-rim_in_May_2023.png","author":"우혜림 • Lim's Diary","license":"CC BY 3.0"},"bio":{"text":"Woo Hye-rim, known professionally as Hyerim or Lim, is a South Korean singer, rapper, songwriter, and radio personality known for her work as a former member of South Korean girl group Wonder Girls. She has hosted Wonder Hours with Hyerim on KBS World Radio since January 2024.","title":"Woo Hye-rim","url":"https://en.wikipedia.org/wiki/Woo_Hye-rim"}},"Q56660171":{"id":"Q56660171","name":"Kim Min-ju","ko":"김민주","birthName":"","birthNameEn":"","aliases":[],"birth":"2001-02-05","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2018","agencies":[{"name":"Off The Record Entertainment","id":"Q106910250","start":"","end":""}],"groups":[{"id":"Q56402353","name":"Iz*One","start":"2018","end":"2021"}],"links":{"instagram":"https://www.instagram.com/minn.__.ju/","x":"https://x.com/minju_official_","musicbrainz":"https://musicbrainz.org/artist/dd0812e2-b587-4d8e-97a2-365b3598133b"},"photo":null,"bio":{"text":"Kim Min-ju is a South Korean actress and former singer. She was a member of the South Korean–Japanese girl group Iz*One from 2018 to 2021. As an actress, she has appeared in films and TV shows including Tempted (2018), The Fault Is Not Yours (2019), The Forbidden Marriage (2022–2023), Hear Me: Our Summer (2024), and Still Shining (2026).","title":"Kim Min-ju","url":"https://en.wikipedia.org/wiki/Kim_Min-ju"}},"Q57600715":{"id":"Q57600715","name":"Yukyung","ko":"유경","birthName":"이유경","birthNa