ki/Kahi"}},"Q5363925":{"id":"Q5363925","name":"Yoon Bo-ra","ko":"보라","birthName":"","birthNameEn":"","aliases":["Bora"],"birth":"1989-12-30","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","rapper","actor","model","dancer","film actor"],"debut":"2010","agencies":[{"name":"Starship Entertainment","id":"Q255363","start":"2010","end":"2017"},{"name":"Hook Entertainment","id":"Q12626105","start":"2017","end":""}],"groups":[{"id":"Q223048","name":"SISTAR","start":"2010","end":"2017"},{"id":"Q5248826","name":"Sistar19","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/borabora_sugar/","musicbrainz":"https://musicbrainz.org/artist/09d9b297-c5db-4b3d-9fb2-25646c696fff"},"photo":null,"bio":{"text":"Yoon Bo-ra, better known by the mononym Bora, is a South Korean singer, rapper, and actress. She is a former member of the South Korean girl group Sistar and its sub-group Sistar19.","title":"Yoon Bo-ra","url":"https://en.wikipedia.org/wiki/Yoon_Bo-ra"}},"Q56660245":{"id":"Q56660245","name":"Lee Na-gyung","ko":"이나경","birthName":"","birthNameEn":"","aliases":["Lee Na-kyung","Nagyung","Nakyung","Lee Na-gyeong"],"birth":"2000-06-01","death":"","birthplace":"Gwangju","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2018","agencies":[],"groups":[{"id":"Q41398331","name":"Fromis 9","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/blossomlng_0/","musicbrainz":"https://musicbrainz.org/artist/4eef36a2-cd23-43f8-ab41-b63f3af46d3f"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/f/f8/190611_%EC%9D%B4%EB%82%98%EA%B2%BD.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:190611_%EC%9D%B4%EB%82%98%EA%B2%BD.jpg","author":"NINE STARS","license":"CC BY 3.0"},"bio":null},"Q59670293":{"id":"Q59670293","name":"Bang Chan","ko":"방찬","birthName":"","birthNameEn":"","aliases":["CB97