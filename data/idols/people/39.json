u Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EC%A7%80%ED%9A%A8"}}},"Q24855847":{"id":"Q24855847","name":"Song Yu-bin","ko":"송유빈","birthName":"","birthNameEn":"","aliases":[],"birth":"1998-04-28","death":"","birthplace":"Daegu","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2017","agencies":[{"name":"The Music Works","korean":true,"id":"Q24856702","start":"","end":""}],"groups":[{"id":"Q28415681","name":"Myteen","start":"2017","end":"2019"}],"links":{"instagram":"https://www.instagram.com/syv0428/","musicbrainz":"https://musicbrainz.org/artist/64c83d26-43d2-495f-afd3-087d26f5f322"},"photo":null,"bio":{"text":"Song Yu-bin, commonly referred to as Song Yuvin, is a South Korean singer and actor. He is best known as a contestant of Superstar K6 and Produce X 101, and for being one of the vocalists of the South Korean group Myteen. Following Myteen's disbandment in 2019, he debuted as a member of the duo B.O.Y, until their disbandment in April 2021. Song made his solo debut on May 30, 2016, with his digital single \"It's You To The Bone\". He made his acting debut in the 2016 drama Age of Youth.","title":"Song Yuvin","url":"https://en.wikipedia.org/wiki/Song_Yuvin"},"positions":["Leader","Vocalist","Main vocalist"],"mbti":"ENFP","factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EC%86%A1%EC%9C%A0%EB%B9%88"},"mbti":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EC%86%A1%EC%9C%A0%EB%B9%88"}}},"Q27951527":{"id":"Q27951527","name":"Feeldog","ko":"필독","birthName":"오광석","birthNameEn":"","aliases":["FEELDOG","Oh Kwang-suk","Oh Kwang-seok"],"birth":"1992-02-26","death":"","birthplace":"Busan","nationality":["South Korea"],"height":null,"occupations":["singer","musician","actor","dancer","painter"],"debut":"2012","agencies":[{"name":"Brave Entertainment","korean":true,"id":"Q4958352","start":"","end":"2019-07"}],"groups":[{"id":"Q7269143","name":"Big Star","start":"2012","end":"2019"},{"id":"Q48938268","name":"UNB","start":"2018","end":"2019"}],"links":{"instagram":"https://www.instagram.com/fxxldoggssy/","x":"https://x.com/feeldog_bpnn","youtube":"https://www.youtube.com/channel/UCoLVz4hiAawZiCdHWGF3WAA","spotify":"https://open.spotify.com/artist/3urM1dEfWPbdggKOMlzi4m"},"photo":null,"bio":null,"positions":["Leader","Lead rapper","Main dancer"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%ED%95%84%EB%8F%85"}}},"Q28412071":{"id":"Q28412071","name":"Hwang In-ho","ko":"황인호","birthName":"","birthNameEn":"","aliases":[],"birth":"1993-06-21","death":"","birthplace":"Gurye County","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q42327284","name":"SKYE","start":"","end":""}],"links":{},"photo":null,"bio":null},"Q28549863":{"id":"Q28549863","name":"Wonho","ko":"원호","birthName":"이호석","birthNameEn":"","aliases":["Lee Ho-seok","Shin Ho-seok"],"birth":"1993-03-01","death":"","birthplace":"Gunpo","nationality":["South Korea"],"height":null,"occupations":["singer","actor","record producer","songwriter","dancer","model"],"debut":"2015","agencies":[{"name":"Starship Entertainment","korean":true,"id":"Q255363","start":"2015","end":"2019"},{"name":"Highline Entertainment","korean":true,"id":"Q108471160","start":"2020","end":""}],"groups":[{"id":"Q19855151","name":"Monsta X","start":"2015","end":"2019"}],"links":{"website":"https://wonho-official.com/","instagram":"https://www.instagram.com/iwonhoyou/","x":"https://x.com/official__wonho","youtube":"https://www.youtube.com/channel/UCnSNrN9e2UlPhLVHS60akuA","tiktok":"https://www.tiktok.com/@official_wonho","spotify":"https://open.spotify.com/artist/6pC3vnUgNVITdYMMXefi6D","musicbrainz":"https://musicbrainz.org/artist/34a4a584-a50d-428c-8adc-0e0f907cd495"},"photo":null,"bio":{"text":"Lee Ho-seok, known by his stage name Wonho, is a South Korean singer under Highline Entertainment. He is a former member of South Korean boy group Monsta X under Starship Entertainment. In 2020, he made his solo debut with the EP Love Synonym Pt.1: Right for Me, alongside its lead single \"Open Mind\", which charted both on the Gaon Chart and Billboard charts. In 2021, he signed with Intertwine Records, a partnership between Eshy Gazit and BMG, for his activities in the United States. He also made his Japanese debut with the single \"On the Way\", which charted on the Oricon Singles Chart. After his South Korea's mandatory military service discharge in 2024, he released \"What Would You Do\".","title":"Wonho","url":"https://en.wikipedia.org/wiki/Wonho"}},"Q482855":{"id":"Q482855","name":"Kim Ryeowook","ko":"려욱","birthName":"김려욱","birthNameEn":"","aliases":["Ryeowook","Ryeo-uk","Kim Ryeo-uk","Kim Ryeo-wook"],"birth":"1987-06-21","death":"","birthplace":"Incheon","nationality":["South Korea"],"height":null,"occupations":["singer","composer","actor","film actor","pianist","songwriter"],"debut":"2005","agencies":[{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"","end":""},{"name":"Label SJ","korean":true,"id":"Q28310645","start":"","end":""}],"groups":[{"id":"Q239693","name":"Super Junior","start":"2005","end":""},{"id":"Q706116","name":"Super Junior-M","start":"","end":""},{"id":"Q2902030","name":"Super Junior-K.R.Y.","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/ryeo9ook/","x":"https://x.com/ryeong9","youtube":"https://www.youtube.com/channel/UC78EgjVM1G7HucXypfB94Fw","spotify":"https://open.spotify.com/artist/0fwfMuz3AmWRy2pyM5fDRo","musicbrainz":"https://musicbrainz.org/artist/28f46b03-adf9-4446-9bd4-7102ec1d1d32"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/7/75/Ryeowook_from_Acrofan_%28cropped%29.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Ryeowook_from_Acrofan_(cropped).JPG","author":"acrofan.com","license":"CC BY-SA 3.0"},"bio":{"text":"Kim Ryeo-wook, better known by the mononym Ryeowook, is a South Korean singer, songwriter, and musical actor. He is best known as a member of boy group Super Junior and its subgroups, Super Junior-K.R.Y. and Super Junior-M. Along with four other Super Junior members, he is one of the first Korean artists to appear on Chinese postage stamps. He began a solo career in 2016 with his first EP The Little Prince.","title":"Kim Ryeo-wook","url":"https://en.wikipedia.org/wiki/Kim_Ryeo-wook"},"positions":["Main vocalist"],"mbti":"ESFJ","factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EB%A0%A4%EC%9A%B1"},"mbti":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EB%A0%A4%EC%9A%B1"}}},"Q483175":{"id":"Q483175","name":"Kangin","ko":"강인","birthName":"김영운","birthNameEn":"","aliases":["Kim Young-woon"],"birth":"1985-01-17","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","film actor","actor","television actor"],"debut":"2005","agencies":[{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"","end":""}],"groups":[{"id":"Q239693","name":"Super Junior","start":"2005","end":"2019"},{"id":"Q2625142","name":"Super Junior-T","start":"","end":""},{"id":"Q700431","name":"Super Junior-Happy","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/kanginnim/","x":"https://x.com/himsenkangin","musicbrainz":"https://musicbrainz.org/artist/3025a46a-2a0a-4ec7-a194-da7de810fb48"},"photo":null,"bio":{"text":"Kim Young-woon, known professionally as Kangin (lit. meaning: \"strong benevolence\"), is a South Korean former singer, actor, television host, and radio personality. He is best known as a former member of Super Junior and its subgroups Super Junior-T, Super Junior-H.","title":"Kangin","url":"https://en.wikipedia.org/wiki/Kangin"}},"Q488423":{"id":"Q488423","name":"Lee Jun-ho","ko":"이준호","birthName":"이준호","birthNameEn":"","aliases":["Lee Junho","Lee Joon-ho","Peach Lee","PenPen","Nuneo","Junho"],"birth":"1990-01-25","death":"","birthplace":"Goyang","nationality":["South Korea"],"height":null,"occupations":["singer","film actor","television actor","recording artist","actor","lyricist"],"debut":"2008","agencies":[{"name":"JYP Entertainment","korean":true,"id":"Q483238","start":"","end":""}],"groups":[{"id":"Q222760","name":"2PM","start":"2008","end":""}],"links":{"instagram":"https://www.instagram.com/le2jh/","x":"https://x.com/dlwnsghek","youtube":"https://www.youtube.com/channel/UCowTHOjp47dzNxR8cz83LGA","musicbrainz":"https://musicbrainz.org/artist/5e272d45-7412-4579-957b-5284054394f4"},"photo":null,"bio":{"text":"Lee Jun-ho, known mononymously as Junho, is a South Korean singer-songwriter and actor. He rose to prominence as a member of the South Korean boy band 2PM, before making his solo music debut in Japan in 2013. As a solo artist, he released two studio albums, one compilation album and eight extended plays, achieving significant success in Japan. Lee made his acting debut in the film Cold Eyes (2013), followed by Twenty (2015). He gained recognition for his roles in television series including Good Manager (2017), Rain or Shine (2017–2018), Confession (2019), The Red Sleeve (2021), King the Land (2023) and Typhoon Family (2025).","title":"Lee Jun-ho","url":"https://en.wikipedia.org/wiki/Lee_Jun-ho"}},"Q489575":{"id":"Q489575","name":"Baek Ji-young","ko":"백지영","birthName":"","birthNameEn":"","aliases":["Baek Z Young"],"birth":"1976-03-25","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"1999","agencies":[],"groups":[],"links":{"instagram":"https://www.instagram.com/baekzyoung/","x":"https://x.com/jiyoungbaek","youtube":"https://www.youtube.com/channel/UCIn1p2ZbhOo8fyZp1S60uGg","musicbrainz":"https://musicbrainz.org/artist/b5b2cc12-9235-42ec-8ae4-569fb2c1f1b5"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/0/0c/190328_%EB%B0%B1%EC%A7%80%EC%98%81.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:190328_%EB%B0%B1%EC%A7%80%EC%98%81.jpg","author":"디스패치","license":"CC BY 3.0"},"bio":{"text":"Baek Ji-young, sometimes anglicized as Baek Z Young, is a South Korean singer. She made her debut in 1999, with the release of her album Sorrow. Over her career she has released eight studio albums and won awards for \"Best Female Artist\" and \"Best OST\" at the Mnet Asian Music Awards.","title":"Baek Ji-young","url":"https://en.wikipedia.org/wiki/Baek_Ji-young"}},"Q497319":{"id":"Q497319","name":"Kim Dong-wan","ko":"김동완","birthName":"","birthNameEn":"","aliases":[],"birth":"1979-11-21","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"1998","agencies":[{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"1998","end":"2003"},{"name":"Good Entertainment","korean":true,"id":"Q10855622","start":"2003","end":"2008"},{"name":"Shinhwa Company","korean":false,"id":"Q20023037","start":"2011","end":""}],"groups":[{"id":"Q482620","name":"Shinhwa","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/kimdongwan_official/","x":"https://x.com/kdw_official","youtube":"https://www.youtube.com/channel/UCNwjaN9w8W2RnZqbE4A0UcA","spotify":"https://open.spotify.com/artist/0s0HWhClc8tr4PCgbX2iUY","musicbrainz":"https://musicbrainz.org/artist/2a7e5329-4e0f-4624-a722-696707734a77"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/9/99/%27%EC%A0%A0%ED%8B%80%EB%A7%A8%EC%8A%A4_%EA%B0%80%EC%9D%B4%EB%93%9C%27_%EB%B0%B0%EC%9A%B0_%EA%B9%80%EB%8F%99%EC%99%84.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:%27%EC%A0%A0%ED%8B%80%EB%A7%A8%EC%8A%A4_%EA%B0%80%EC%9D%B4%EB%93%9C%27_%EB%B0%B0%EC%9A%B0_%EA%B9%80%EB%8F%99%EC%99%84.jpg","author":"scene PLAYBILL","license":"CC BY 3.0"},"bio":{"text":"Kim Dong-wan is a South Korean entertainer, known as a member of South Korean boy band Shinhwa. He has been acting since 2002, and has starred in television dramas such as A Farewell to Sorrow and Children of Heaven. He has said that given the opportunity he would prefer a career in acting rather than as a singer, However, since the release of his debut album, he has stated that now he prefers singing more. From Shinhwa, Kim is the fourth member to go solo, following Lee Min-woo, Shin Hye-sung, and Jun Jin.","title":"Kim Dong-wan","url":"https://en.wikipedia.org/wiki/Kim_Dong-wan"},"positions":["Lead vocalist"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EA%B9%80%EB%8F%99%EC%99%84%28%EC%8B%A0%ED%99%94%29"}}},"Q498343":{"id":"Q498343","name":"Nam Hyun-joon","ko":"팝핀현준","birthName":"남현준","birthNameEn":"","aliases":["Poppin' Hyun Joon"],"birth":"1979-01-30","death":"","birthplace":"South Korea","nationality":["South Korea"],"height":null,"occupations":["singer","television actor"],"debut":"1996","agencies":[{"name":"Happy Face Entertainment","korean":true,"id":"Q15154003","start":"","end":""}],"groups":[{"id":"Q134281304","name":"A-Force","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/poppinhyunjoon/","x":"https://x.com/hyunjoonpoppin"},"photo":null,"bio":{"text":"Nam Hyun-joon, often referred to as Poppin' Hyun Joon (팝핀현준), is a South Korean dancer, rapper and singer. Best known for his popping techniques, he is considered a pioneer of South Korean breakdancing.","title":"Nam Hyun-joon","url":"https://en.wikipedia.org/wiki/Nam_Hyun-joon"}},"Q55735655":{"id":"Q55735655","name":"하이탑 (가수)","ko":"","birthName":"임현태","birthNameEn":"","aliases":[],"birth":"1994-03-19","death":"","birthplace":"Suwon","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q18328761","name":"Bigflo","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/hightop0319/"},"photo":null,"bio":null,"positions":["메인래퍼^^^^"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EC%9E%84%ED%98%84%ED%83%9C"}}},"Q56816551":{"id":"Q56816551","name":"Chuu","ko":"츄","birthName":"Kim Ji-woo","birthNameEn":"Kim Ji-woo","aliases":["Kim Ji Woo","Kim Ji-woo"],"birth":"1999-10-20","death":"","birthplace":"Cheongju","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2017","agencies":[{"name":"ATRP","korean":false,"id":"Q127060031","start":"","end":""}],"groups":[{"id":"Q28025953","name":"Loona","start":"2017","end":"2022"}],"links":{"website":"https://atrp.co.kr/CHUU","instagram":"https://www.instagram.com/chuuo3o/","x":"https://x.com/chuu_atrp","youtube":"https://www.youtube.com/channel/UCvhVqA_5HnM7M5X6OcZlMbg","spotify":"https://open.spotify.com/artist/1q86WVZhETqii5kKjEwYuB","musicbrainz":"https://musicbrainz.org/artist/ebe26895-c0d1-41c3-8b