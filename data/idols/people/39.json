An_%28entertainer%29"},"positions":["Sub vocalist"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EC%98%8C%EC%95%88%28%ED%8E%9C%ED%83%80%EA%B3%A4%29"}}},"Q85878823":{"id":"Q85878823","name":"Mingi","ko":"민기","birthName":"","birthNameEn":"","aliases":["Song Mingi","Song Min-gi"],"birth":"1999-08-09","death":"","birthplace":"Incheon","nationality":["South Korea"],"height":null,"occupations":["singer","rapper","songwriter"],"debut":"2018","agencies":[{"name":"KQ Entertainment","korean":true,"id":"Q31179359","start":"","end":""}],"groups":[{"id":"Q59793088","name":"Ateez","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/fixon_n_on/","spotify":"https://open.spotify.com/artist/3ZHodgUsqkIUsek6ke65bO","musicbrainz":"https://musicbrainz.org/artist/73635d0c-c8ff-47e8-b1c5-d66fdaa30e72"},"photo":null,"bio":{"text":"Song Min-gi, known mononymously as Mingi, is a South Korean rapper and songwriter. He debuted as a member of the boy band Ateez on October 24, 2018. He serves as the group's main rapper and dancer, as well as a songwriter, composer, and producer. He is known for his signature deep, raspy voice and his \"Fix On\" catchphrase, which has become a part of his personal brand.","title":"Mingi (rapper)","url":"https://en.wikipedia.org/wiki/Mingi_%28rapper%29"}}}}