":"Yangyang (singer)","url":"https://en.wikipedia.org/wiki/Yangyang_%28singer%29"}},"Q93970112":{"id":"Q93970112","name":"Lee Jae-hee","ko":"이재희","birthName":"","birthNameEn":"","aliases":["Lee Jaehee","Jaehee"],"birth":"2004-03-18","death":"","birthplace":"South Korea","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2020","agencies":[],"groups":[{"id":"Q65046002","name":"Weeekly","start":"","end":""}],"links":{"musicbrainz":"https://musicbrainz.org/artist/7a03a23a-ec1a-4ac4-8796-324f6dfb1fe8"},"photo":null,"bio":null},"Q97232704":{"id":"Q97232704","name":"Kim Dong-yoon","ko":"김동윤","birthName":"김동윤","birthNameEn":"","aliases":["Dong-yoon"],"birth":"1998-06-03","death":"2018-07-27","birthplace":"","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q60994652","name":"Spectrum","start":"","end":""}],"links":{},"photo":null,"bio":null},"Q97352000":{"id":"Q97352000","name":"Hamada Asahi","ko":"아사히","birthName":"","birthNameEn":"","aliases":["Arthur"],"birth":"2001-08-20","death":"","birthplace":"Osaka Prefecture","nationality":["Japan"],"height":172,"occupations":["singer","singer-songwriter","musician"],"debut":"2018","agencies":[{"name":"YG Entertainment","korean":true,"id":"Q50595","start":"","end":""}],"groups":[{"id":"Q61057550","name":"Treasure","start":"","end":""}],"links":{},"photo":null,"bio":{"text":"Treasure is a South Korean boy band formed by YG Entertainment in 2019. The group consists of ten members: Choi Hyun-suk, Jihoon, Yoshi, Junkyu, Yoon Jae-hyuk, Asahi, Doyoung, Haruto, Park Jeong-woo, and So Jung-hwan. Treasure was originally composed of 12 members; Mashiho and Bang Ye-dam departed from the group in November 2022. The group debuted in 2020 with the single album The First Step: Chapter One, beginning a four-part The First Step series that also includes Chapter Two, Chapter Three, and the full-length compilation The First Step: Treasure Effect (2021).","title":"