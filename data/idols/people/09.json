s://namu.wiki/w/%EC%B0%BD%EC%A1%B0%28%ED%8B%B4%ED%83%91%29"}}},"Q21710217":{"id":"Q21710217","name":"Yooa","ko":"유아","birthName":"Yoo Yeon-joo","birthNameEn":"Yoo Yeon-joo","aliases":["Yoo Yeon-joo","Yoo Si-ah","YooA"],"birth":"1995-09-17","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","dancer"],"debut":"2015","agencies":[{"name":"WM Entertainment","korean":true,"id":"Q19794482","start":"","end":""},{"name":"DSP Media","korean":true,"id":"Q489428","start":"","end":""}],"groups":[{"id":"Q19794854","name":"Oh My Girl","start":"2015","end":""}],"links":{"instagram":"https://www.instagram.com/yoo__sha/","spotify":"https://open.spotify.com/artist/4ur1jCwyNlhgd0viJkOtcQ","musicbrainz":"https://musicbrainz.org/artist/fae3cddb-8379-4c96-83d8-5a045a580a0b"},"photo":null,"bio":{"text":"Yoo Si-ah, known professionally as YooA (유아), is a South Korean singer and actress. She is a member of the girl group Oh My Girl under DSP Media. She made her debut as a solo artist, with her first EP Bon Voyage, on September 7, 2020.","title":"YooA","url":"https://en.wikipedia.org/wiki/YooA"},"positions":["Vocalist"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EC%9C%A0%EC%95%84%28%EC%98%A4%EB%A7%88%EC%9D%B4%EA%B1%B8%29"}}},"Q270857":{"id":"Q270857","name":"Lee Jeong-hyeon","ko":"이정현","birthName":"","birthNameEn":"","aliases":["Lee Jung-hyun"],"birth":"1980-02-07","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["actor","singer"],"debut":"1999","agencies":[],"groups":[],"links":{"instagram":"https://www.instagram.com/mermaidleejh/","x":"https://x.com/mermaidjh","youtube":"https://www.youtube.com/channel/UC8ZirMMChf8BaKKbae3Sl4A","musicbrainz":"https://musicbrainz.org/artist/d1eb9201-f7fb-401f-b433-3a7316f7e814"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/6/68/%27%EC%A0%9C2%ED%9A%8C_%EB%8D%94_%EC%84%9C%EC%9A%B8_%EC%96%B4%EC%9B%8C%EC%A6%88%27_%EC%9D%B4%EC%A0%95%ED%98%84.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:%27%EC%A0%9C2%ED%9A%8C_%EB%8D%94_%EC%84%9C%EC%9A%B8_%EC%96%B4%EC%9B%8C%EC%A6%88%27_%EC%9D%B4%EC%A0%95%ED%98%84.jpg","author":"디스패치","license":"CC BY 3.0"},"bio":{"text":"Lee Jung-hyun, also known by her occasional stage name Ava, is a South Korean singer and actress. She was first recognized for her acting abilities with an award-winning role in her first film and has been solidified as one of the top international acts from South Korea with her illustrious singing career. She has been known as \"the Techno Queen\" as she introduced the techno music genre to Korea. Lee is also known as \"The Queen of Transformation\" due to her changing new look for different songs. She is known as one of the first artists who introduced Korean Wave (Hallyu) to China and caused a sensation.","title":"Lee Jung-hyun","url":"https://en.wikipedia.org/wiki/Lee_Jung-hyun"}},"Q272329":{"id":"Q272329","name":"Uhm Jeong-hwa","ko":"엄정화","birthName":"","birthNameEn":"","aliases":["Eom Jeong-hwa","Jeong-hwa Eom","Uhm Jung-hwa"],"birth":"1969-08-17","death":"","birthplace":"Jecheon","nationality":["South Korea"],"height":null,"occupations":["singer","actor","dancer"],"debut":"1993","agencies":[],"groups":[{"id":"Q98754857","name":"Refund Sisters","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/umaizing/","x":"https://x.com/love_tangle","musicbrainz":"https://musicbrainz.org/artist/605a645c-f6c2-43b8-994b-7dedc2eec469"},"photo":null,"bio":{"text":"Uhm Jung-hwa is a South Korean singer, actress and dancer. Uhm is considered to be one of the most influential women in the Korean entertainment industry, finding success in both music and film. Her legacy and career reinventions have given her the nickname of \"Korean Madonna\". Uhm began her career in 1989 as a chorus member for the broadcasting company MBC. She starred in the romantic drama film On a Windy Day, We Must Go to Apgujeong (1993) and released her debut studio album Sorrowful Secret that same year. Though both releases found limited audiences, the album's lead single, \"Pupil\", helped to establish a sensual image for Uhm.","title":"Uhm Jung-hwa","url":"https://en.wikipedia.org/wiki/Uhm_Jung-hwa"}},"Q30311753":{"id":"Q30311753","name":"Ong Seongwu","ko":"옹성우","birthName":"","birthNameEn":"","aliases":["Ong Seongwoo","Ong Seong-wu"],"birth":"1995-08-25","death":"","birthplace":"Incheon","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2017","agencies":[],"groups":[{"id":"Q30311578","name":"Wanna One","start":"2017","end":"2019"}],"links":{"instagram":"https://www.instagram.com/osw_onge/","x":"https://x.com/officialtwt_OSW","youtube":"https://www.youtube.com/channel/UCS7QXPJhEOvJfH8ZxMBGrIQ","musicbrainz":"https://musicbrainz.org/artist/0a2cc98f-257e-47b0-b3a4-0effca9402d8"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/8/88/%EC%98%B9%EC%84%B1%EC%9A%B0.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:%EC%98%B9%EC%84%B1%EC%9A%B0.jpg","author":"Marie Claire Korea","license":"CC BY 3.0"},"bio":{"text":"Ong Seong-wu is a South Korean singer and actor. He is known for his participation in the survival reality show Produce 101 Season 2, where he finished in fifth place, and is a former member of the show's derivative boy group Wanna One. Following Wanna One's disbandment, Ong made his acting debut with the drama At Eighteen (2019) directed by Shim Na-yeon. He also established his career as a solo artist with the release of his first extended play, Layers, on March 25, 2020.","title":"Ong Seong-wu","url":"https://en.wikipedia.org/wiki/Ong_Seong-wu"},"