ationality":["People's Republic of China"],"height":null,"occupations":["actor","singer","film actor","television actor","rapper","model"],"debut":"2005","agencies":[{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"2005","end":"2009"},{"name":"Yuehua Entertainment","korean":false,"id":"Q18390500","start":"2010","end":""}],"groups":[{"id":"Q239693","name":"Super Junior","start":"2005","end":"2009"},{"id":"Q706116","name":"Super Junior-M","start":"2008","end":"2010"}],"links":{"instagram":"https://www.instagram.com/realhangeng/","x":"https://x.com/realhangeng","musicbrainz":"https://musicbrainz.org/artist/7dc21a6a-25e2-471c-a181-c7f198d4012d"},"photo":null,"bio":{"text":"Han Geng is a Chinese singer and actor. He became a trainee under S.M. Entertainment in 2001, debuted in 2005 as a member of the K-pop boy band Super Junior, and became the leader of its subunit Super Junior-M in 2008. In 2009, he filed a lawsuit to terminate his contract with S.M. Entertainment and returned to China; the dispute was settled in 2011. After his popularity in China peaked in the early 2010s, Han transitioned toward an acting career from 2015 onward, appearing in films such as So Young (2013), Ex-Files (2014), and Ex-Files 3 (2017).","title":"Han Geng","url":"https://en.wikipedia.org/wiki/Han_Geng"}},"Q464645":{"id":"Q464645","name":"Bae Suzy","ko":"수지","birthName":"배수지","birthNameEn":"","aliases":["Bae Su-ji","Suzy"],"birth":"1994-10-10","death":"","birthplace":"Gwangju","nationality":["South Korea"],"height":null,"occupations":["singer","actor","film actor","television actor"],"debut":"2010","agencies":[{"name":"JYP Entertainment","korean":true,"id":"Q483238","start":"","end":"2019"},{"name":"Management SOOP","korean":true,"id":"Q15946075","start":"2019","end":""}],"groups":[{"id":"Q284740","name":"Miss A","start":"2010","end":"2017"}],"links":{"instagram":"https://www.instagram.com/skuukzky/","x":"https://x.com/Suzy","youtube":"https://www.youtube.com/channel/UC7ukOKu7-6G-m5d4hOXrhfQ","spotify":"https://open.spotify.com/artist/4U80LJd8sG6U9YTFP5izka","musicbrainz":"https://musicbrainz.org/artist/72325a65-557b-47d6-8bbb-b374b380bc5c"},"photo":null,"bio":{"text":"Bae Su-ji, anglicized as Bae Suzy, and also known mononymously as Suzy, is a South Korean singer and actress. A former member of girl group Miss A (2010–2017), she made her debut as an actress in 2011 with the television series Dream High and starred in the film Architecture 101 (2012). Following the latter's success, Bae has been nicknamed the \"Nation's First Love\" by South Korean media outlets. She then starred in dramas Gu Family Book (2013), Uncontrollably Fond (2016), and While You Were Sleeping (2017).","title":"Bae Suzy","url":"https://en.wikipedia.org/wiki/Bae_Suzy"}},"Q484165":{"id":"Q484165","name":"Lee Soo-man","ko":"이수만","birthName":"","birthNameEn":"","aliases":["Lee Suman","Soo-Man Lee","Lee Soo Man","S.M. Lee"],"birth":"1952-06-18","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","record producer","entrepreneur","composer"],"debut":"1971","agencies":[{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"1995","end":"2023"}],"groups":[],"links":{"musicbrainz":"https://musicbrainz.org/artist/4d5ec626-2251-4bb1-b62a-f24f471e3f2c"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/3/34/Lee_Soo-man_in_2024.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Lee_Soo-man_in_2024.jpg","author":"K-POPIT 케이팝잇","license":"CC BY 3.0"},"bio":{"text":"Lee Soo-man is a South Korean business executive and record producer who is best known for being the founder of SM Entertainment, a multinational entertainment company based in Seoul. He has also been referred to as the \"president of culture\", as one of the pioneers of the Korean Wave. Lee debuted as a singer in 1971 while he was a student at Seoul National Uni