91","name":"Kiggen","ko":"키겐","birthName":"이기원","birthNameEn":"","aliases":[],"birth":"1979-03-13","death":"","birthplace":"Kiyotake","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2007","agencies":[{"name":"Brand New Music","korean":true,"id":"Q12599305","start":"","end":""}],"groups":[{"id":"Q7180539","name":"Phantom","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/kiggen7/","x":"https://x.com/KIGGEN7","musicbrainz":"https://musicbrainz.org/artist/ce14a62c-a6c7-4635-afef-2623929b465d"},"photo":null,"bio":{"text":"Lee Ki-won, better known by his stage name Kiggen (키겐), is a South Korean rapper, singer, lyricist, composer, and record producer who is a former member of the hip hop group Phantom and the president of the Brand New Music label Korean Roulette.","title":"Kiggen","url":"https://en.wikipedia.org/wiki/Kiggen"}},"Q16183615":{"id":"Q16183615","name":"Jinon","ko":"진온","birthName":"김진철","birthNameEn":"","aliases":["Kim Jin-chul"],"birth":"1989-07-13","death":"","birthplace":"Cheonan","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q487638","name":"F.CUZ","start":"","end":""}],"links":{"x":"https://x.com/jinchulvv"},"photo":null,"bio":null},"Q16236223":{"id":"Q16236223","name":"J-Hope","ko":"제이홉","birthName":"","birthNameEn":"","aliases":["Jung Ho-seok","Jung Hoseok"],"birth":"1994-02-18","death":"","birthplace":"Gwangju","nationality":["South Korea"],"height":177,"occupations":["rapper","dancer","record producer","songwriter","singer","composer"],"debut":"2013","agencies":[{"name":"Big Hit Music","korean":true,"id":"Q106296918","start":"","end":""}],"groups":[{"id":"Q13580495","name":"BTS","start":"","end":""}],"links":{"website":"https://ibighit.com/bts/eng/discography/j-hope/","instagram":"https://www.instagram.com/uarmyhope/","spotify":"https://open.spotify.com/artist/0b1sIQumIAsNbqAoIClSpy","musicbrainz":"https://musicbrainz.org/artist/b3977da4-f899-4328-921b-ecc599a5618a"},"photo":null,"bio":{"text":"Jung Ho-seok, known professionally as J-Hope (제이홉; stylized in lower case), is a South Korean rapper, singer, songwriter, dancer, and record producer. He made his debut as a member of South Korean boy band BTS in 2013, under Big Hit Entertainment. J-Hope released his first solo mixtape, Hope World, in 2018. It was received positively by critics and peaked at number 38 on the US Billboard 200, the highest-charting album by a Korean solo artist at the time. He became the first member of BTS to enter the Billboard Hot 100 as a soloist in 2019, when his single \"Chicken Noodle Soup\", featuring singer Becky G, debuted at number 81. In 2022, J-Hope released his debut studio album Jack in the Box.","title":"J-Hope","url":"https://en.wikipedia.org/wiki/J-Hope"}},"Q18379327":{"id":"Q18379327","name":"Tasha Low","ko":"유이영","birthName":"","birthNameEn":"","aliases":["Tasha","Natasha Low Yi Ling","Natasha Low"],"birth":"1993-10-11","death":"","birthplace":"Singapore","nationality":["Singapore"],"height":null,"occupations":["singer","actor"],"debut":"2012","agencies":[],"groups":[{"id":"Q491953","name":"Skarf","start":"2012","end":"2014"}],"links":{"website":"https://www.teamwildent.com/tasha-low","instagram":"https://www.instagram.com/tashaalow/"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/1/13/Skarf_Tasha_in_2013.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Skarf_Tasha_in_2013.jpg","author":"와사비콘텐츠","license":"CC BY 2.0 kr"},"bio":{"text":"Tasha Low is a Singaporean actress and singer. She was the leader of the South Korean girl group, Skarf from 2012 to 2014. Low is currently based in Singapore. She made her feature film debut in The Diam Diam Era in 2020.","title":"Tasha Low","url":"https://en.wikipedia.org/wiki/Tasha_Low"}},"Q24572927":{"id":"Q24572927","name":"Umji","ko":"엄지","birthName":"김예원","birth