 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EC%98%88%EB%A6%B0%28%EC%97%AC%EC%9E%90%EC%B9%9C%EA%B5%AC%29"}}},"Q21144659":{"id":"Q21144659","name":"Blue","ko":"파랑","birthName":"","birthNameEn":"","aliases":["Jung Gahee","Parang"],"birth":"1994-01-18","death":"","birthplace":"Gwangju","nationality":["South Korea"],"height":null,"occupations":["rapper","model"],"debut":"","agencies":[],"groups":[],"links":{"musicbrainz":"https://musicbrainz.org/artist/0840d77c-51c5-400b-91d4-49d242446d93"},"photo":null,"bio":{"text":"Pungdeng-E (풍뎅이) is a South Korean female music trio formed in December 2013. One of their original concepts was the use of different regional Korean dialects where each member uses her own local dialect. They are known to have unique lyrics and videos. The members modeled together for the Korean cosmetics brand Seed & Tree. Pungdeng-E performed on the first and third day of the 42nd Los Angeles Korean Festival in California on November 2, 2015. The groups first Japanese performance was on November 28, 2015 in Ōta, Tokyo.","title":"Blue (rapper)","url":"https://en.wikipedia.org/wiki/Blue_%28rapper%29"}},"Q22804243":{"id":"Q22804243","name":"Im Nayeon","ko":"나연","birthName":"임나연","birthNameEn":"","aliases":["im nayeon","nayeon","im unnie"],"birth":"1995-09-22","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["pop singer","dancer"],"debut":"2015","agencies":[{"name":"JYP Entertainment","korean":true,"id":"Q483238","start":"","end":""}],"groups":[{"id":"Q20645861","name":"Twice","start":"2015","end":""},{"id":"Q65061223","name":"K/DA","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/nayeonyny/","spotify":"https://open.spotify.com/artist/1VwDG9aBflQupaFNjUru9A","musicbrainz":"https://musicbrainz.org/artist/e107bde8-78f0-4646-8925-68007a15880e"},"photo":null,"bio":{"text":"Im Na-yeon, known mononymously as Nayeon, is a South Korean singer. She rose to prominence as a member of the South Korean girl group Twice, created by JYP Entertainment through the reality television show Sixteen (2015). Nayeon released her eponymous debut extended play (EP), Im Nayeon, in June 2022. It peaked at number one on South Korea's Circle Album Chart and number seven on the US Billboard 200, making her the first South Korean soloist in history to enter the latter chart's top 10. The lead single, \"Pop!\", reached number two on the Circle Digital Chart in South Korea and the top ten in six countries.","title":"Nayeon","url":"https://en.wikipedia.org/wiki/Nayeon"},"positions":["Center","Lead vocalist","Lead dancer"],"mbti":"ISTP","factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EB%82%98%EC%97%B0%28TWICE%29"},"mbti":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/%EB%82%98%EC%97%B0%28TWICE%29"}}},"Q26214035":{"id":"Q26214035","name":"Kim So-hye","ko":"김소혜","birthName":"","birthNameEn":"","aliases":["Kim Sohye","Kim So Hye"],"birth":"1999-07-19","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2016","agencies":[],"groups":[{"id":"Q23688122","name":"I.O.I","start":"2026","end":"2017"}],"links":{"instagram":"https://www.instagram.com/s_sohye/","musicbrainz":"https://musicbrainz.org/artist/417d790a-148c-458e-aca5-e768bc0cae32"},"photo":null,"bio":{"text":"Kim So-hye, known mononymously as Sohye, is a South Korean actress and singer under S&P Entertainment. She is a former member of the girl musical group I.O.I, finishing fifth on Mnet's survival show Produce 101. She is best known on her acting roles in Poetry Story (2017), Kang Deok-soon's Love History (2017), Best Chicken (2019), and My Lovely Boxer (2023).","title":"Kim So-hye","url":"https://en.wikipedia.org/wiki/Kim_So-hye"}},"Q28870931":{"id":"Q28870931","name":"Zi.U","ko":"지유","birthName":"","birthNameEn":"","aliases":["Kim Ji-yu"],"birth":"1995-02-24","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q491708","name":"RANIA","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/zi_u_for_you/","x":"https://x.com/zi_u_for_you"},"photo":null,"bio":null},"Q3207955":{"id":"Q3207955","name":"Yang Ji-won","ko":"양지원","birthName":"","birthNameEn":"","aliases":[],"birth":"1988-04-05","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2012","agencies":[{"name":"B2M Entertainment","korean":true,"id":"Q3527542","start":"","end":""},{"name":"Stone Music Entertainment","korean":true,"id":"Q483971","start":"","end":""}],"groups":[{"id":"Q492387","name":"Spica","start":"2012","end":"2017"},{"id":"Q48938270","name":"UNI.T","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/wldnjs62/","x":"https://x.com/ppjwy","youtube":"https://www.youtube.com/channel/UCQQIG2fXr0GJodXUt4w0mLQ","musicbrainz":"https://musicbrainz.org/artist/c62327fb-7383-452b-a319-2cc5ec2983ca"},"photo":null,"bio":{"text":"Yang Ji-won is a South Korean singer and actress. She is a former member of T-ara, Spica and Uni.T, and made her solo debut in 2020 with the single \"Towards the Sun\". Initially slated to debut as a member of Five Girls and then T-ara, Yang made her debut as a member of Spica in 2012. After the group disbanded in 2017, she debuted as a member of UNI.T a year later after participating in The Unit: Idol Rebooting Project and ranking sixth in the final episode.","title":"Yang Ji-won (singer)","url":"https://en.wikipedia.org/wiki/Yang_Ji-won_%28singer%29"}},"Q486483":{"id":"Q486483","name":"Nam Ji-hyun","ko":"손지현","birthName":"남지현","birthNameEn":"","aliases":["Nam Ji-hyun","Jihyun"],"birth":"1990-01-09","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["television actor","singer","actor","model","film actor"],"debut":"2009","agencies":[{"name":"Cube Entertainment","korean":true,"id":"Q484449","start":"","end":""}],"groups":[{"id":"Q39682","name":"4Minute","start":"2009","end":"2016"}],"links":{"instagram":"https://www.instagram.com/missnam90/","x":"https://x.com/4m_namjiji0109","musicbrainz":"https://musicbrainz.org/artist/b9104b35-2d3d-4a26-88e9-0d1dd4940e83"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/2/2a/191017_%EC%86%90%EC%A7%80%ED%98%84.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:191017_%EC%86%90%EC%A7%80%ED%98%84.jpg","author":"뉴스인스타","license":"CC BY 3.0"},"bio":{"text":"Nam Ji-hyun, known mononymously as Jihyun, and formerly known by her stage name Son Ji-hyun, is a South Korean actress and former singer. She is best known as the former leader and a vocalist of now-disbanded South Korean girl group 4Minute.","title":"Nam Ji-hyun (actress, born 1990)","url":"https://en.wikipedia.org/wiki/Nam_Ji-hyun_%28actress%2C_born_1990%29"}},"Q486995":{"id":"Q486995","name":"Ryu Hwa-young","ko":"류화영","birthName":"","birthNameEn":"","aliases":["Hwayoung","Ryu Hwayoung"],"birth":"1993-04-22","death":"","birthplace":"Gwangju","nationality":["South Korea"],"height":null,"occupations":["singer","rapper","actor","songwriter"],"debut":"2010","agencies":[{"name":"MBK Entertainment","korean":true,"id":"Q429296","start":"","end":""}],"groups":[{"id":"Q495383","name":"T-ara","start":"2010","end":"2012"}],"links":{"instagram":"https://www.instagram.com/hwayoung_ryu_93/","x":"https://x.com/Rhy422","tiktok":"https://www.tiktok.com/@hwayoung_ryu_93","musicbrainz":"https://musicbrainz.org/artist/27c0f77a-3c53-4885-b237-82f0a899ae19"},"photo":null,"bio":{"text":"Ryu Hwa-young, better known by the mononym Hwayoung, is a South Korean actress and singer. She is a former member of South Korean girl group T-ara.","title":"Ryu Hwa-young","url":"https://en.wikipedia.org/wiki/Ryu_Hwa-young"}},"Q492691":{"id":"Q492691","name":"Lee Ka-eun","ko":"이가은","birthName":"","birthNameEn":"","aliases":["Kaeun","Lee Gaeun"],"birth":"1994-08-20","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor","model","rapper"],"debut":"2012","agencies":[{"name":"Pledis Entertainment","korean":true,"id":"Q45282","start":"","end":""}],"groups":[{"id":"Q389067","name":"After School","start":"2012","end":"2015"}],"links":{"instagram":"https://www.instagram.com/by.gaeun/","x":"https://x.com/kkaaanngg","youtube":"https://www.youtube.com/channel/UCew8xOwY-Q_MgLgfQBxHAww","musicbrainz":"https://musicbrainz.org/artist/0d126738-d3c4-482b-a8f1-3737bff87fa0"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/f/f2/141126_%EA%B0%80%EC%9D%80_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:141126_%EA%B0%80%EC%9D%80_(cropped).jpg","author":"kimmimi","license":"CC BY 4.0"},"bio":{"text":"After School was a South Korean girl group formed by Pledis Entertainment, with an admissions and graduation concept. After School officially debuted in January 2009 with the song \"Ah!\" from the single album New Schoolgirl. Following the addition of Uee in April of that year, they released \"Diva\", which won the \"Rookie of the Month\" award at the Cyworld Digital Music Awards. Pledis Entertainment then announced the graduation of Soyoung before adding Raina and Nana for the release \"Because of You\" in November 2009, which topped the monthly digital chart for December.","title":"Lee Ka-eun","url":"https://en.wikipedia.org/wiki/Lee_Ka-eun"}},"Q495571":{"id":"Q495571","name":"T.O.P","ko":"","birthName":"최승현","birthNameEn":"","aliases":["Choi Seung-hyun","TOP","Tabi"],"birth":"1987-11-04","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["actor","model","songwriter","rapper","singer","beatboxer"],"debut":"2006","agencies":[{"name":"YG Entertainment","korean":true,"id":"Q50595","start":"","end":""},{"name":"Avex Group","korean":false,"id":"Q790686","start":"","end":""}],"groups":[{"id":"Q282104","name":"BigBang","start":"2006","end":"2023"},{"id":"Q21575485","name":"GD&TOP","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/ttt/","musicbrainz":"https://musicbrainz.org/artist/bb7246a8-40b6-4397-8322-448aaa2d33a3"},"photo":null,"bio":{"text":"Choi Seung-hyun, known professionally as T.O.P, is a South Korean rapper, musician, philanthropist, and actor. He performed as an underground rapper before joining the record label YG Entertainment and debuted as the lead rapper of the boy band BigBang in 2006. The group became one of the best-selling groups of all time in Asia and one of the best-selling boy bands in the world. In 2010, while the group was on hiatus, T.O.P and G-Dragon collaborated to release the album, GD & TOP. As a solo rapper, he has released two digital singles, \"Turn It Up\" (2010) and \"Doom Dada\" (2013), that have peaked at number two and four, respectively, on the Gaon Digital Chart.","title":"T.O.P","url":"https://en.wikipedia.org/wiki/T.O.P"},"positions":["Lead rapper","Sub vocalist"],"factSources":{"positions":{"name":"Namu Wiki (2021 dump)","license":"CC BY-NC-SA 2.0 KR","licenseUrl":"https://creativecommons.org/licenses/by-nc-sa/2.0/kr/","base":"https://namu.wiki/w/","url":"https://namu.wiki/w/T.O.P"}}},"Q54553939":{"id":"Q54553939","name":"Kim A-in","ko":"아인","birthName":"","birthNameEn":"","aliases":["Kim Ah-in","A-IN"],"birth":"1994-02-15","death":"","birthplace":"Asan","nationality":["South Korea"],"height":182,"occupations":["singer","dancer"],"