e":"ATTRAKT Entertainment","korean":true,"id":"Q123841093","start":"","end":""}],"groups":[{"id":"Q116731010","name":"Fifty Fifty","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/from.fiftyfifty/"},"photo":null,"bio":null},"Q130222815":{"id":"Q130222815","name":"Mackiah Mercer","ko":"마카야","birthName":"","birthNameEn":"","aliases":["Lee Ye Jun","Lee Ye-jun"],"birth":"2006-01-21","death":"","birthplace":"","nationality":["Australia"],"height":null,"occupations":["singer"],"debut":"","agencies":[],"groups":[{"id":"Q123458788","name":"Ampers&One","start":"","end":""}],"links":{},"photo":null,"bio":null},"Q16173535":{"id":"Q16173535","name":"EunB","ko":"은비","birthName":"고은비","birthNameEn":"","aliases":["Ko Ŭnbi","Go Eun-bi"],"birth":"1992-11-23","death":"2014-09-03","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","songwriter","rapper","dancer"],"debut":"2023","agencies":[{"name":"Polaris Entertainment","korean":true,"id":"Q12622003","start":"","end":""}],"groups":[{"id":"Q11588897","name":"Ladies' Code","start":"2013","end":"2023"}],"links":{"x":"https://x.com/lc__eunb","musicbrainz":"https://musicbrainz.org/artist/c5c9dcf0-8a6e-4941-90f3-ffec67a1cb98"},"photo":null,"bio":{"text":"Ladies' Code is a South Korean girl group formed by Polaris Entertainment in 2013. The group's original lineup consisted of leader Ashley and members RiSe, EunB, Sojung, and Zuny. They made their debut with the mini-album Code#01 and the lead track \"Bad Girl\", which were released on March 7, 2013. On September 3, 2014, the group was involved in a car crash that resulted in the deaths of EunB and Rise. Ladies' Code returned as a trio in February 2016 with the extended play Myst3ry. In October 2016, they issued \"The Rain\" from their EP Strang3r. The group left Polaris in February 2020 following the expiration of their contracts.","title":"EunB","url":"https://en.wikipedia.org/wiki/EunB"}},"Q27126815":{"id":"Q27126815","name":"Nada","ko":"나다","birthName":"Yoon Ye-jin","birthNameEn":"Yoon Ye-jin","aliases":["Yoon Ye-jin"],"birth":"1991-05-24","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["rapper","singer"],"debut":"2013","agencies":[],"groups":[{"id":"Q14853915","name":"Wassup","start":"2013","end":"2017"}],"links":{"instagram":"https://www.instagram.com/wassup_nada/","x":"https://x.com/wassup_nd","musicbrainz":"https://musicbrainz.org/artist/5b0728a5-8802-496f-a2eb-0050a1b6fa70"},"photo":null,"bio":{"text":"Yoon Ye-jin, known professionally as Nada (나다), is a South Korean rapper and singer. She is a former member of the girl group Wassup. Nada made her debut as a soloist on December 22, 2016, with the digital single \"Seorae Village\".","title":"Nada (South Korean musician)","url":"https://en.wikipedia.org/wiki/Nada_%28South_Korean_musician%29"}},"Q28549791":{"id":"Q28549791","name":"Hyung-won","ko":"형원","birthName":"채형원","birthNameEn":"","aliases":["Chae Hyung-won","Chae Hyungwon","Category:Chae Hyung-won"],"birth":"1994-01-15","death":"","birthplace":"Gwangju","nationality":["South Korea"],"height":null,"occupations":["singer","dancer","model"],"debut":"2015","agencies":[{"name":"Starship Entertainment","korean":true,"id":"Q255363","start":"","end":""}],"groups":[{"id":"Q19855151","name":"Monsta X","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/coenffl/","musicbrainz":"https://musicbrainz.org/artist/5eb88fce-7fc1-4a5b-bd5b-8619c8c91a6b"},"photo":null,"bio":{"text":"Chae Hyung-won, known mononymously as Hyungwon, is a South Korean singer, actor, model, DJ, MC, songwriter, and producer. He is a member of South Korean boy group Monsta X and its sub-unit Shownu X Hyungwon under Starship Entertainment. In 2017, he began performing as a DJ under the stage name DJ H.ONE.","title":"Hyungwon","url":"https://en.wikipedia.org/wiki/Hyungwon"}},"Q30014943":{"id":"Q30014943","name":"Aron","ko":"아론","birthName":"곽영민","birthNameEn":"Kwak Young-min","aliases":["Kwak Young-min","Aron Kwak","Aaron Kwak"],"birth":"1993-05-21","death":"","birthplace":"Los Angeles","nationality":["United States","South Korea"],"height":null,"occupations":["singer"],"debut":"2012","agencies":[{"name":"Pledis Entertainment","korean":true,"id":"Q45282","start":"","end":""}],"groups":[{"id":"Q225105","name":"NU'EST","start":"2012","end":"2022"}],"links":{"instagram":"https://www.instagram.com/nuestaron/","musicbrainz":"https://musicbrainz.org/artist/b311cae8-f61b-43f0-8b17-c42da4af4a1a"},"photo":null,"bio":{"text":"Aaron Kwak, formerly known by the stage name Aron, is an American media personality, singer, and rapper based in South Korea. He began his professional career in 2012 as a main rapper of the South Korean boy group NU'EST. Following his contract's expiration with Pledis Entertainment in 2022, Aron established his solo career as a freelance radio and television host, appearing in various South Korean programs.","title":"Aron (singer)","url":"https://en.wikipedia.org/wiki/Aron_%28singer%29"}},"Q466975":{"id":"Q466975","name":"Lim Yoona","ko":"윤아","birthName":"임윤아","birthNameEn":"","aliases":["Im Yoo-na","Im Yoo Na","Im Yuna","Im Yun-a","Im Yun A","Im Yoonah","Im Yoon Ah","Im Yun-ah"],"birth":"1990-05-30","death":"","birthplace":"Yeongdeungpo District","nationality":["South Korea"],"height":null,"occupations":["singer","actor","model","television presenter","dancer","film actor"],"debut":"2007","agencies":[{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"","end":""}],"groups":[{"id":"Q20153","name":"Girls' Generation","start":"2007","end":""},{"id":"Q56260975","name":"Girls' Generation-Oh!GG","start":"2018","end":""}],"links":{"instagram":"https://www.instagram.com/yoona__lim/","youtube":"https://www.youtube.com/channel/UC8B_76tkLwQmiaJwDKFytXw","spotify":"https://open.spotify.com/artist/6LCX99hubn8CejiUtMCyyk","musicbrainz":"https://musicbrainz.org/artist/13b8076d-532c-4692-b896-6ecac9d9d8f4"},"photo":null,"bio":{"text":"Lim Yoona, also known mononymously as Yoona, is a South Korean singer and actress. After training for five years, she debuted as a member of girl group Girls' Generation (and later its subgroup Girls' Generation-Oh!GG) in August 2007, which went on to become one of the best-selling artists in South Korea and one of South Korea's most widely known girl groups worldwide. Apart from her group's activities, Lim has participated in various television dramas, notably You Are My Destiny (2008), which marked her career breakthrough and earned her the Best New Actress award at the 45th Baeksang Arts Awards.","title":"Lim Yoona","url":"https://en.wikipedia.org/wiki/Lim_Yoona"}},"Q482783":{"id":"Q482783","name":"Kim Junsu","ko":"김준수","birthName":"","birthNameEn":"","aliases":["Kim Jun-su","Xia","Xia Junsu"],"birth":"1986-12-15","death":"","birthplace":"Goyang","nationality":["South Korea"],"height":null,"occupations":["singer","songwriter","actor","model","musical theatre actor","model"],"debut":"2003","agencies":[{"name":"C-JeS Studios","korean":true,"id":"Q5005884","start":"","end":""},{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"","end":""}],"groups":[{"id":"Q192983","name":"TVXQ","start":"2003","end":"2009"},{"id":"Q51729","name":"JYJ","start":"","end":""}],"links":{"website":"https://palmtree.is/artists/kim-jun-su","instagram":"https://www.instagram.com/xiaxiaxia1215/","x":"https://x.com/1215thexiahtic","youtube":"https://www.youtube.com/channel/UCdk_-wGLorR0-81Nxj0w_VA","musicbrainz":"https://musicbrainz.org/artist/ecd75028-f6a6-4e39-8b06-0629c5a934ef"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/f/f0/%28%EC%94%AC%ED%94%8C%EB%A0%88%EC%9D%B4%EB%B9%8C%29_7%EC%9B%94%ED%98%B8_%EA%B9%80%EC%A4%80%EC%88%98_%281%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:(%EC%94%AC%ED%94%8C%EB%A0%88%EC%9D%B4%EB%B9%8C)_7%EC%9B%94%ED%98%B8_%EA%B9%80%EC%A4%80%EC%88%98_(1).jpg","author":"scene PLAYBILL","license":"CC BY 3.0"},"bio":{"text":"Kim Jun-su, known mononymously as Junsu or by the stage name XIA ( SHEE-ah; 시아), is a South Korean singer-songwriter and musical actor. He is a former member of JYJ, and was one of the original members of TVXQ, during which time he was known by the stage name Xiah Junsu (시아준수). Kim made his debut in 2003 as a member of TVXQ, a boy band produced and formed by South Korean record label and talent agency SM Entertainment, having previously been a trainee for six years. During his time in TVXQ, the group released four Korean albums, four Japanese albums, thirty Japanese singles and several Korean singles.","title":"Kim Junsu","url":"https://en.wikipedia.org/wiki/Kim_Junsu"}},"Q482847":{"id":"Q482847","name":"Kangta","ko":"강타","birthName":"안칠현","birthNameEn":"","aliases":["Kang Ta","Ahn Chil-hyun"],"birth":"1979-10-10","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["singer","actor","composer","songwriter","record producer"],"debut":"1996","agencies":[{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"","end":""}],"groups":[{"id":"Q2404780","name":"Kangta & Vanness","start":"2006","end":"2007"},{"id":"Q483135","name":"H.O.T.","start":"2018","end":"2019"},{"id":"Q7395331","name":"S","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/an_chil_hyun/","x":"https://x.com/kangta","youtube":"https://www.youtube.com/channel/UCxMdO8z6xdaT_LvCbdWZE5Q","musicbrainz":"https://musicbrainz.org/artist/e96bed25-e9c7-4fa3-9db6-1ee9e3e0b265"},"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/5/59/%EC%94%AC%ED%94%8C%EB%A0%88%EC%9D%B4%EB%B9%8C_8%EC%9B%94%ED%98%B8_%EA%B0%95%ED%83%80.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:%EC%94%AC%ED%94%8C%EB%A0%88%EC%9D%B4%EB%B9%8C_8%EC%9B%94%ED%98%B8_%EA%B0%95%ED%83%80.jpg","author":"scene PLAYBILL","license":"CC BY 3.0"},"bio":{"text":"An Chil-hyun, known professionally as Kangta (강타), is a South Korean singer, composer, songwriter, record producer, actor and radio personality. Known for his work as a member of boy band H.O.T., he is currently an executive at his longtime agency SM Entertainment since 2005. He is also the chief producer of Smashhit from SM's label Kreation Music Rights since 2023 and the general producer of SM's music label SMArt since 2025.","title":"Kangta","url":"https://en.wikipedia.org/wiki/Kangta"}},"Q485279":{"id":"Q485279","name":"Seo Hyun-jin","ko":"서현진","birthName":"","birthNameEn":"","aliases":["Seo Hyeon-jin","Seo Hyunjin","Seo Hyeonjin"],"birth":"1985-02-27","death":"","birthplace":"Seoul","nationality":["South Korea"],"height":null,"occupations":["actor","singer"],"debut":"2001","agencies":[{"name":"SM Entertainment","korean":true,"id":"Q483938","start":"","end":""}],"groups":[{"id":"Q485028","name":"M.I.L.K.","start":"2001","end":"2003"}],"links":{"instagram":"https://www.instagram.com/cider.saida/","x":"https://x.com/jini26991","musicbrainz":"https://musicbrainz.org/artist/83891a4d-1bf4-4abe-a483-5b3d9d614efa"},"photo":null,"bio":{"text":"Seo Hyun-jin is a South Korean actress and singer. Seo debuted as the vocalist of South Korean girl group M.I.L.K. in 2001 and continued until the group disbanded in 2003. She contributed songs as a solo artist after the group broke up before she transitioned into acting in 2006. Seo made her acting debut in the musical The Sound of Music (2006) then followed by appearances in several television series and film. She is best known for her leading role as Oh Hae-young in the romantic comedy TV series Another Miss Oh (2016), which gained her wider recognition. Seo has since gone on to have key parts in the medical melodrama Dr.","title":"Seo Hyun-jin","url":"https://en.wikipedia.org/wiki/Seo_Hyun-jin"}},"Q487391":{"id":"Q487391","name":"Ailee","ko":"에일리","birthName":"Amy Lee","birthNameEn":"Amy Lee","aliases":["Lee Amy","A.Leean"],"birth":"1989-05-30","death":"","birthplace":"Denver","nationality":["South Korea","United States"],"height":null,"occupations":["singer","actor","songwriter"],"debut":"2012","agencies":[],"groups":[],"links":{"instagram":"https://www.instagram.com/aileeonline/","x":"https://x.com/itzailee","youtube":"https://www.youtube.com/channel/UCymeXjTfl8hMGN7M357oX3g","spotify":"https://open.spotify.com/artist/3uGFTJ7JMllvhgGpumieHF","musicbrainz":"https://musicbrainz.org/artist/cecc42fb-9657-4b54-ad2f-7b73eefaef12"},"photo":null,"bio":{"text":"Amy Lee, known professionally as Ailee (에일리), is an American singer and songwriter based in South Korea. Amassing digital sales success in South Korea, she has released four studio albums, six extended plays, and twenty one singles, six of which charted within the top five of the Gaon Digital Chart. She debuted in 2012 with her first single \"Heaven\", which peaked at number three on the Gaon Digital Chart and earned her Best New Artist Awards at the Melon Music Awards, Golden Disc Awards, Gaon Chart K-Pop Awards, and Seoul Music Awards.","title":"Ailee","url":"https://en.wikipedia.org/wiki/Ailee"}},"Q490911":{"id":"Q490911","name":"Park Hwayobi","ko":"박화요비","birthName":"박레아","birthNameEn":"","aliases":[],"birth":"1982-02-11","death":"","birthplace":"Gunsan","nationality":["South Korea"],"height":null,"occupations":["singer"],"debut":"2000","agencies":[],"groups":[],"links":{"musicbrainz":"https://musicbrainz.org/artist/248db157-629d-4a8c-b541-82410dc3efd8"},"photo":null,"bio":{"text":"Park Hwayobi (February 11, 1982), more commonly known as Hwayobi, is a South Korean R&B singer-songwriter.","title":"Hwayobi","url":"https://en.wikipedia.org/wiki/Hwayobi"}},"Q492767":{"id":"Q492767","name":"E-Young","ko":"이영","birthName":"노이영","birthNameEn":"","aliases":["Noh Yi-young","Noh Lee-young"],"birth":"1992-08-16","death":"","birthplace":"Chuncheon","nationality":["South Korea"],"height":null,"occupations":["singer","model"],"debut":"2011","agencies":[{"name":"Pledis Entertainment","korean":true,"id":"Q45282","start":"","end":""}],"groups":[{"id":"Q389067","name":"After School","start":"2011","end":"2015"}],"links":{"instagram":"https://www.instagram.com/e_young0816/","x":"https://x.com/Eyoung0816","youtube":"https://www.youtube.com/channel/UCpQSt70K09uXr-0YRgfCARw","musicbrainz":"https://musicbrainz.org/artist/664d247e-6b40-459c-ac6a-8eb5b60266ed"},"photo":null,"bio":{"text":"After School was a South Korean girl group formed by Pledis Entertainment, with an admissions and graduation concept. After School officially debuted in January 2009 with the song \"Ah!\" from the single album New Schoolgirl. Following the addition of Uee in April of that year, they released \"Diva\", which won the \"Rookie of the Month\" award at the Cyworld Digital Music Awards. Pledis Entertainment then announced the graduation of Soyoung before adding Raina and Nana for the release \"Because of You\" in November 2009, which topped the monthly digital chart for December.","title":"E-Young","url":"https://en.wikipedia.org/wiki/E-Young"}},"Q5358943":{"id":"Q5358943","name":"Juri Takahashi","ko":"타카하시 쥬리","birthName":"","birthNameEn":"","aliases":["Juri","Takahashi Juri"],"birth":"1997-10-03","death":"","birthplace":"Kashima","nationality":["Japan"],"height":null,"occupations":["singer"],"debut":"2011","agencies":[{"name":"Woollim Entertainment","korean":true,"id":"Q50596","start":"","end":""},{"name":"Vernalossom","korean":false,"id":"Q4204153","start":"","end":""}],"groups":[{"id":"Q65771078","name":"Rocket Punch","start":"2019","end":"2024"}],"links":{"instagram":"https://www.instagram.com/1003_j/","x":"https://x.com/juri_t_official","musicbrainz":"https://musicbrainz.org/artist/65f3318e-342a-4c5d-b7ae-ce3015affb13"},"photo":null,"bio":{"text":"Juri Takahashi, also known mononymously as Juri, is a Japanese singer based in South Korea. She is a former member of South K