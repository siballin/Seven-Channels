d":""}],"groups":[{"id":"Q60732823","name":"Itzy","start":"","end":""}],"links":{"instagram":"https://www.instagram.com/igotyuandme/","x":"https://x.com/ITZYOfficial","youtube":"https://www.youtube.com/channel/UCIVow-L-PzGBLy8LzlLvezg","spotify":"https://open.spotify.com/artist/6FsEIvsTuqjpejg2jDbYdv","musicbrainz":"https://musicbrainz.org/artist/8745aa96-0163-4d6a-9f8b-f7437e5c67b0"},"photo":null,"bio":{"text":"Shin Yu-na, known mononymously as Yuna, is a South Korean singer, dancer, rapper, and actress. She is a member of the South Korean girl group Itzy, formed by JYP Entertainment in 2019. She made her acting debut in 2026 in Undercover Miss Hong and appeared in My Bias, My Boss. Yuna released her solo debut extended play (EP), Ice Cream, in March 2026.","title":"Yuna (singer, born 2003)","url":"https://en.wikipedia.org/wiki/Yuna_%28singer%2C_born_2003%29"}},"Q61100151":{"id":"Q61100151","name":"Hwall","ko":"활","birthName":"Hur Hyun-jun","birthNameEn":"Hur Hyun-jun","aliases":["Hur Hyun-jun","Hyun-jun"],"birth":"2000-03-09","death":"","birthplace":"Busan","nationality":["South Korea"],"height":null,"occupations":["singer","actor"],"debut":"2017","agencies":[{"name":"Cre.Ker Entertainment","id":"Q67200500","start":"","end":""},{"name":"Blossom Entertainment","id":"Q18648265","start":"","end":""}],"groups":[{"id":"Q41949104","name":"The Boyz","start":"2017","end":"2019"}],"links":{"instagram":"https://www.instagram.com/hyun.jxx0_p/"},"photo":null,"bio":{"text":"Hur Hyun-jun, known professionally as Hyunjun, Hyun Jun or Hyunjun Hur, and formerly known by the stage name Hwall (활), is a South Korean singer and actor. He is best known as a former member of South Korean boy group The Boyz. He has also gained recognition with the web series Color Rush (2021).","title":"Hur Hyun-jun","url":"https://en.wikipedia.org/wiki/Hur_Hyun-jun"}},"Q625527":{"id":"Q625527","name":"Solbi","ko":"솔비","birthName":"권지안","birthNameEn":"","aliases":["Kwon Jian","Kwon Ji-an"],"birth":"1984-